<Window x:Class="NetScopeDiagnosticCenter.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About ISG Desk"
        Icon="/Assets/logo.png"
        Height="760"
        Width="780"
        MinHeight="640"
        MinWidth="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        FontSize="14"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="#EBF3FC">
    <Window.Resources>
        <LinearGradientBrush x:Key="AboutCloseBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#EF4444" Offset="0" />
            <GradientStop Color="#DC2626" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AboutCloseHoverBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F87171" Offset="0" />
            <GradientStop Color="#EF4444" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="AboutCloseButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AboutCloseBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#B91C1C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="22,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#991B1B" Direction="270" ShadowDepth="1" BlurRadius="4" Opacity="0.3" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AboutCloseHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0F172A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B91C1C" />
                                <Setter TargetName="Bd" Property="Effect" Value="{x:Null}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AboutCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="#D6E3F1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#94A3B8" Direction="270" ShadowDepth="1" BlurRadius="6" Opacity="0.12" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AboutSectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="AboutBodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="AboutFeatureIconBadge" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderBrush" Value="#70FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#64748B" Direction="270" ShadowDepth="1" BlurRadius="5" Opacity="0.24" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AboutFeatureIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#D6E3F1" BorderThickness="0,0,0,1" Padding="26,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="/Assets/logo-transparent.png" Stretch="Uniform"
                       Width="168" MaxHeight="72" RenderOptions.BitmapScalingMode="HighQuality" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="22,0,18,0">
                    <TextBlock Text="ISG Desk" FontSize="26" FontWeight="SemiBold" Foreground="#0F172A" />
                    <TextBlock Text="{Binding Tagline}" FontSize="13" Foreground="#64748B" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding Intro}" FontSize="12.5" Foreground="#475569"
                               TextWrapping="Wrap" Margin="0,8,0,0" MaxWidth="460" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border Background="#DBEAFE" CornerRadius="10" Padding="10,4" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding VersionLabel}" Foreground="#1D4ED8"
                                   FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <Border Background="#DCFCE7" CornerRadius="10" Padding="10,4" Margin="0,8,0,0" HorizontalAlignment="Right">
                        <TextBlock Text="Local-first diagnostics" Foreground="#15803D"
                                   FontSize="12" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="26,22,26,10">
                <Border Style="{StaticResource AboutCard}">
                    <StackPanel>
                        <TextBlock Text="PURPOSE" Style="{StaticResource AboutSectionLabel}" />
                        <TextBlock Text="{Binding Purpose}" Style="{StaticResource AboutBodyText}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AboutCard}">
                    <StackPanel>
                        <TextBlock Text="HOW TO USE IT" Style="{StaticResource AboutSectionLabel}" />
                        <ItemsControl ItemsSource="{Binding WorkflowSteps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                                                Background="#DBEAFE" BorderBrush="#93C5FD" BorderThickness="1"
                                                VerticalAlignment="Top" Margin="0,2,12,0">
                                            <TextBlock Text="{Binding Number}" Foreground="#1D4ED8"
                                                       FontSize="12" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource AboutBodyText}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AboutCard}">
                    <StackPanel>
                        <TextBlock Text="MODULES" Style="{StaticResource AboutSectionLabel}" />
                        <ItemsControl ItemsSource="{Binding Features}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" BorderBrush="#E8EEF5" BorderThickness="1"
                                            CornerRadius="8" Padding="11,10" Margin="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource AboutFeatureIconBadge}">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="{Binding AccentColorStart}" Offset="0" />
                                                        <GradientStop Color="{Binding AccentColorEnd}" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="{Binding Icon}" Style="{StaticResource AboutFeatureIcon}"
                                                           ToolTip="{Binding Title}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                           Foreground="#0F172A" FontSize="13" />
                                                <TextBlock Text="{Binding Detail}" Foreground="#64748B"
                                                           FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource AboutCard}" Margin="0,0,7,14">
                        <StackPanel>
                            <TextBlock Text="SAFE OPERATION" Style="{StaticResource AboutSectionLabel}" />
                            <ItemsControl ItemsSource="{Binding SafetyNotes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="7" Height="7" Fill="#14B8A6" Margin="0,7,10,0" VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource AboutBodyText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource AboutCard}" Margin="7,0,0,14">
                        <StackPanel>
                            <TextBlock Text="OUTPUTS" Style="{StaticResource AboutSectionLabel}" />
                            <ItemsControl ItemsSource="{Binding ReportOutputs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="7" Height="7" Fill="#3B82F6" Margin="0,7,10,0" VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource AboutBodyText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="{Binding CreditsLine}" Foreground="#94A3B8" FontSize="11"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Margin="0,2,0,0" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#D6E3F1" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Copyright}" Foreground="#64748B"
                           FontSize="12" VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource AboutCloseButton}" Content="Close"
                        Click="OnClose" IsDefault="True" IsCancel="True" />
            </Grid>
        </Border>
    </Grid>
</Window>
