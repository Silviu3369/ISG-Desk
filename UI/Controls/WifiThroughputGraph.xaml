<UserControl x:Class="NetScopeDiagnosticCenter.UI.Controls.WifiThroughputGraph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="160">
    <!--
        Single-series REAL throughput monitor (one of: Receive / Transmit). Filled area +
        line, real wall-clock time axis, auto-scaling Y with smart Kbps/Mbps units.
        One instance per direction so the user reads download and upload independently.
        Code-behind drawing for the same reason as the other Wi-Fi charts.
    -->
    <Border Background="#0F172A" CornerRadius="8">
        <Canvas x:Name="PlotCanvas" ClipToBounds="True" Background="Transparent" />
    </Border>
</UserControl>
