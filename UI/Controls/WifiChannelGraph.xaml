<UserControl x:Class="NetScopeDiagnosticCenter.UI.Controls.WifiChannelGraph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="220">
    <!--
        inSSIDer / NetSpot-style spectrum graph. Each visible AP is drawn as a coloured
        "hump" (quadratic Bezier) centred on its channel, peaking at its RSSI, spanning
        its channel width. The connected AP is drawn thicker + on top. Axes + grid are
        rendered in code-behind because the channel set differs per band.
    -->
    <Border Background="#0F172A" CornerRadius="8" Padding="0">
        <Canvas x:Name="PlotCanvas" ClipToBounds="True" Background="Transparent" />
    </Border>
</UserControl>
