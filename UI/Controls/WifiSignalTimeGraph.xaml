<UserControl x:Class="NetScopeDiagnosticCenter.UI.Controls.WifiSignalTimeGraph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="200">
    <!--
        2nd signature inSSIDer view: RSSI-over-time, one coloured line per network.
        Lines + legend rendered in code-behind (per-series colour must match the
        Channel Graph's BSSID-hash colour so the eye tracks a network across both).
    -->
    <Border Background="#0F172A" CornerRadius="8">
        <Canvas x:Name="PlotCanvas" ClipToBounds="True" Background="Transparent" />
    </Border>
</UserControl>
