<UserControl x:Class="NetScopeDiagnosticCenter.UI.Controls.HealthGaugeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="160" Height="160">
    <Grid>
        <!-- Background ring (track). -->
        <Ellipse Width="140" Height="140"
                 Stroke="#D6E3F1"
                 StrokeThickness="12"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />

        <!-- Foreground arc (score). Geometry recalculated in code-behind on Score change. -->
        <Path x:Name="ArcPath"
              StrokeThickness="12"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <Path.Data>
                <PathGeometry x:Name="ArcGeometry">
                    <PathFigure x:Name="ArcFigure" StartPoint="80,10">
                        <ArcSegment x:Name="ArcSegment" Size="70,70" SweepDirection="Clockwise" />
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>

        <!-- Centre numeric + status. -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="ScoreText"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="#17212B"
                       HorizontalAlignment="Center"
                       Text="—" />
            <TextBlock Text="/ 100"
                       FontSize="10"
                       Foreground="#94A3B8"
                       HorizontalAlignment="Center"
                       Margin="0,-4,0,0" />
            <TextBlock x:Name="StatusText"
                       FontSize="11"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"
                       Text="No data" />
        </StackPanel>
    </Grid>
</UserControl>
