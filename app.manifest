<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="2.0.0.0" name="ISG.Desk.App"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- asInvoker: the app opens without a UAC prompt for any user; admin-only
             probes (BitLocker, TPM, disk S.M.A.R.T. counters) degrade to "Requires
             admin" and Technician Home offers a one-click "Restart as administrator".
             Set back to level="requireAdministrator" to force elevation at launch. -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
