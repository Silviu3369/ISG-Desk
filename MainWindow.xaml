                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="12,0" Visibility="{Binding IsNetworkDeviceSnmpV2Selected, Converter={StaticResource BoolVisibility}}">
                                            <TextBlock Style="{StaticResource LabelText}" Text="SNMP v2c community" />
                                            <TextBox Text="{Binding NetworkDeviceCommunity, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,7" BorderBrush="#BFCFE5" />
                                        </StackPanel>
                                        <Button Grid.Column="3" Style="{StaticResource NetworkDeviceIdentifyButton}" Content="Identify Device" Command="{Binding IdentifyNetworkDeviceCommand}" VerticalAlignment="Bottom" Margin="0,0,10,0" ToolTip="SNMP query for sysDescr / sysName / location / contact on the target IP" />
                                        <Button Grid.Column="4" Style="{StaticResource PrimaryButtonNetworkDevices}" Content="Read Interfaces" Command="{Binding ReadNetworkDeviceInterfacesCommand}" VerticalAlignment="Bottom" />
