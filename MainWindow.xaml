                            <Border Style="{StaticResource Card}" BorderBrush="{Binding TestResultSeverity, Converter={StaticResource StatusBrush}}" BorderThickness="5,1,1,1" Visibility="{Binding HasTestResult, Converter={StaticResource BoolVisibility}}">
