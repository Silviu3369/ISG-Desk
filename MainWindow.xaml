        <LinearGradientBrush x:Key="PrimaryBtnIdleWifi" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0EA5E9" Offset="0" />
            <GradientStop Color="#0284C7" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PrimaryBtnHoverWifi" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#38BDF8" Offset="0" />
            <GradientStop Color="#0EA5E9" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WifiRescanButtonBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#14B8A6" Offset="0" />
            <GradientStop Color="#0F766E" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WifiRescanButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2DD4BF" Offset="0" />
            <GradientStop Color="#14B8A6" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WifiCopyButtonBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#64748B" Offset="0" />
            <GradientStop Color="#475569" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WifiCopyButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#94A3B8" Offset="0" />
            <GradientStop Color="#64748B" Offset="1" />
        </LinearGradientBrush>
