                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                     <TextBlock Text="Target Results" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                                     <TextBlock Text="{Binding TestTargetResultsEmptyText}" Foreground="#475569" TextWrapping="Wrap" Visibility="{Binding HasNoTestTargetResults, Converter={StaticResource BoolVisibility}}" />
                                     <DataGrid ItemsSource="{Binding TestTargetResults}" Visibility="{Binding HasTestTargetResults, Converter={StaticResource BoolVisibility}}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MinHeight="120" MaxHeight="340" HeadersVisibility="Column" GridLinesVisibility="Horizontal" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible">
                                         <DataGrid.Columns>
                                             <DataGridTextColumn Header="Target" Binding="{Binding Target.Host}" Width="*" />
                                             <DataGridTextColumn Header="DNS" Binding="{Binding DnsStatus}" Width="90" />
                                             <DataGridTextColumn Header="Ping" Binding="{Binding PingStatus}" Width="90" />
                                             <DataGridTextColumn Header="Latency" Binding="{Binding LatencyText}" Width="90" />
                                             <DataGridTextColumn Header="Loss" Binding="{Binding LossText}" Width="90" />
                                             <DataGridTextColumn Header="Ports" Binding="{Binding PortSummary}" Width="220" />
                                             <DataGridTextColumn Header="Share" Binding="{Binding ShareStatus}" Width="110" />
                                             <DataGridTextColumn Header="Published shares" Binding="{Binding VisibleSharesText}" Width="220" />
                                             <DataGridTextColumn Header="Verdict" Binding="{Binding Verdict}" Width="150" />
                                             <DataGridTextColumn Header="Owner" Binding="{Binding OwnerSuggestion}" Width="150" />
                                             <DataGridTextColumn Header="Collector" Binding="{Binding CollectorStatus}" Width="180" />
                                         </DataGrid.Columns>
                                     </DataGrid>
                                 </StackPanel>
                             </Border>

                        </StackPanel>
                    </ScrollViewer>
                    </Grid>

                    <ScrollViewer Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=NetworkDevices}" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-10,0">
                        <StackPanel>
                            <Border Style="{StaticResource ModuleHeroBanner}" Background="{StaticResource HeroBgNetworkDevices}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
