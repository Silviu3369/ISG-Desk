                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#17212B" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Layer}" Foreground="#475569" FontSize="12" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" FontWeight="SemiBold" Margin="0,8,0,2" />
                                                        <TextBlock Text="{Binding DurationDisplayText}" Foreground="#475569" FontSize="12" ToolTip="Step runtime, not network latency." />
                                                        <TextBlock Text="{Binding Recommendation}" Foreground="#334155" TextWrapping="Wrap" Margin="0,8,0,0" />
                                                        <TextBlock Text="{Binding Error}" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Card}" Visibility="{Binding HasTestResult, Converter={StaticResource BoolVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="Test Evidence" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                                        <TextBlock Text="No evidence was produced." Foreground="#475569" TextWrapping="Wrap" Visibility="{Binding HasNoTestEvidence, Converter={StaticResource BoolVisibility}}" />
                                        <ItemsControl ItemsSource="{Binding TestEvidence}" Visibility="{Binding HasTestEvidence, Converter={StaticResource BoolVisibility}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat=- {0}}" TextWrapping="Wrap" Margin="0,0,0,7" Foreground="#334155" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Card}" Visibility="{Binding HasTestResult, Converter={StaticResource BoolVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="Next Checks" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                                        <TextBlock Text="No next checks were produced." Foreground="#475569" TextWrapping="Wrap" Visibility="{Binding HasNoTestNextChecks, Converter={StaticResource BoolVisibility}}" />
                                        <ItemsControl ItemsSource="{Binding TestNextChecks}" Visibility="{Binding HasTestNextChecks, Converter={StaticResource BoolVisibility}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat=- {0}}" TextWrapping="Wrap" Margin="0,0,0,7" Foreground="#334155" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}" Visibility="{Binding HasTestResult, Converter={StaticResource BoolVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="Limitations" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                                        <TextBlock Text="No limitations were recorded." Foreground="#475569" TextWrapping="Wrap" Visibility="{Binding HasNoTestLimitations, Converter={StaticResource BoolVisibility}}" />
                                        <ItemsControl ItemsSource="{Binding TestLimitations}" Visibility="{Binding HasTestLimitations, Converter={StaticResource BoolVisibility}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat=- {0}}" TextWrapping="Wrap" Margin="0,0,0,7" Foreground="#334155" />
