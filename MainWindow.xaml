                                                <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,4"
                                                        Visibility="{Binding HasNoVerdictLimitations, Converter={StaticResource BoolVisibility}}">
                                                    <TextBlock Text="No limitations recorded yet." Foreground="#64748B" FontSize="12" TextWrapping="Wrap" />
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding LastDiagnosis.Verdict.Limitations}"
                                                              Visibility="{Binding HasVerdictLimitations, Converter={StaticResource BoolVisibility}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding StringFormat=- {0}}" TextWrapping="Wrap" Margin="0,0,0,7" Foreground="#334155" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
