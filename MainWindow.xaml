                                    <Border Grid.Column="0" Style="{StaticResource ModuleHeroChip}" Background="{StaticResource AccentNetworkDevices}">
                                        <TextBlock Style="{StaticResource ModuleHeroIcon}" Text="🔌" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource ModuleHeroTitle}" Text="Network Devices" />
                                        <TextBlock Style="{StaticResource ModuleHeroSubtitle}" Text="Read-only SNMP checks for switches, access points and other internal network devices." />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Read-only SNMP checks for switches, access points and other internal network devices. Use a known target, run Auto Safe Scan, or enter a private authorized range." Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,14" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="160" />
