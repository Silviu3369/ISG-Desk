                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastDiagnosis.Adapter.DiscardsPerSecond, StringFormat=Discards/s: {0:N2}, TargetNullValue=Discards/s: Unknown}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
