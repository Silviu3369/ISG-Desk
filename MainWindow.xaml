                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelText}" Text="Protocol" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastNetworkDevice.SnmpProtocolDisplay, TargetNullValue=Unknown}" />
