                                                          Visibility="{Binding HasNetworkDeviceProbableFindings, Converter={StaticResource BoolVisibility}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StringFormat=- {0}}" TextWrapping="Wrap" Margin="0,0,10,7" Foreground="#92400E" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelText}" Text="Unknown / Limit" />
                                            <TextBlock Text="No unknowns were recorded for this result." Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,7"
                                                       Visibility="{Binding HasNoNetworkDeviceUnknownFindings, Converter={StaticResource BoolVisibility}}" />
                                            <ItemsControl ItemsSource="{Binding LastNetworkDevice.UnknownFindings}"
                                                          Visibility="{Binding HasNetworkDeviceUnknownFindings, Converter={StaticResource BoolVisibility}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StringFormat=- {0}}" TextWrapping="Wrap" Margin="0,0,0,7" Foreground="#334155" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Reachability / Identification" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <UniformGrid Columns="4" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelText}" Text="DNS" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastNetworkDevice.DnsStatusDisplay, TargetNullValue=Unknown}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelText}" Text="Reverse DNS" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastNetworkDevice.ReverseDnsNameDisplay, TargetNullValue=Unknown}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelText}" Text="Ping / Loss" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastNetworkDevice.PingStatusDisplay, TargetNullValue=Unknown}" />
                                            <TextBlock Text="{Binding LastNetworkDevice.LossText, StringFormat=Loss: {0}, TargetNullValue=Loss: Unknown}" Foreground="#475569" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelText}" Text="Latency" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastNetworkDevice.LatencyText, TargetNullValue=Unknown}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelText}" Text="MAC" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastNetworkDevice.MacAddressDisplay, TargetNullValue=Unknown}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelText}" Text="Vendor" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastNetworkDevice.MacVendorDisplay, TargetNullValue=Unknown}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelText}" Text="Neighbor state" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastNetworkDevice.NeighborStateDisplay, TargetNullValue=Unknown}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelText}" Text="Neighbor interface" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastNetworkDevice.NeighborInterfaceDisplay, TargetNullValue=Unknown}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelText}" Text="Open ports" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastNetworkDevice.OpenPortSummary, TargetNullValue=Not tested}" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="Common TCP management/service ports" FontWeight="SemiBold" Margin="0,4,0,8" />
                                    <DataGrid ItemsSource="{Binding LastNetworkDevice.Ports}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                              MinHeight="110" MaxHeight="220"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                              ScrollViewer.VerticalScrollBarVisibility="Visible"
                                              ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                              ScrollViewer.CanContentScroll="True"
                                              EnableRowVirtualization="True"
                                              EnableColumnVirtualization="True"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="80" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="100" />
                                            <DataGridTextColumn Header="Latency" Binding="{Binding LatencyText}" Width="110" />
                                            <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" BorderBrush="{Binding LastNetworkDeviceScan.Severity, Converter={StaticResource StatusBrush}}" BorderThickness="5,1,1,1">
                                <StackPanel>
                                    <TextBlock Text="{Binding LastNetworkDeviceScan.VerdictDisplay, TargetNullValue=No LAN scan has been run yet, FallbackValue=No LAN scan has been run yet}"
                                               FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{Binding LastNetworkDeviceScan.Severity, Converter={StaticResource StatusBrush}}" />
                                    <TextBlock Text="{Binding LastNetworkDeviceScan.SourceDisplay, StringFormat=Source: {0}, TargetNullValue=Source: None}" Foreground="#475569" Margin="0,4,0,10" />
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding LastNetworkDeviceScan.ProgressPercent, Mode=OneWay}" Height="8" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding LastNetworkDeviceScan.ProgressText, TargetNullValue=Not started}" Foreground="#475569" Margin="0,0,0,10" />
                                    <UniformGrid Columns="6" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelText}" Text="Estimated hosts" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastNetworkDeviceScan.EstimatedHosts, TargetNullValue=0}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelText}" Text="Max hosts" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastNetworkDeviceScan.MaxHosts, TargetNullValue=256}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelText}" Text="SNMP community" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastNetworkDeviceScan.SnmpCommunityMaskedDisplay, TargetNullValue=Not used}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelText}" Text="Protocol" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastNetworkDeviceScan.SnmpProtocolDisplay, TargetNullValue=Unknown}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelText}" Text="Adapter" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastNetworkDeviceScan.AdapterNameDisplay, TargetNullValue=Unknown}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelText}" Text="Skipped reason" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastNetworkDeviceScan.SkippedReasonDisplay, TargetNullValue=None}" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <UniformGrid Columns="4" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelText}" Text="Scanned" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastNetworkDeviceScan.ScannedHosts, TargetNullValue=0}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelText}" Text="Found" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastNetworkDeviceScan.FoundDevices, TargetNullValue=0}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelText}" Text="SNMP timeouts" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastNetworkDeviceScan.TimedOutHosts, TargetNullValue=0}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelText}" Text="Other failures" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastNetworkDeviceScan.FailedHosts, TargetNullValue=0}" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <StackPanel Margin="0,0,0,8">
                                        <Button Style="{StaticResource SecondaryButton}" Content="Read Selected Interfaces" Command="{Binding ReadSelectedNetworkDeviceInterfacesCommand}" IsEnabled="{Binding HasSelectedNetworkDeviceScanResult}" HorizontalAlignment="Left" ToolTip="Read interface counters (in/out octets, errors, discards) for the selected device(s)" />
                                        <TextBlock Text="{Binding SelectedNetworkDeviceScanResultSummary}" Foreground="#475569" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Visibility="{Binding HasNetworkDeviceScanResults, Converter={StaticResource BoolVisibility}}" />
                                    </StackPanel>
                                    <Border Background="#F2F7FD" BorderBrush="#BFCFE5" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10"
                                            Visibility="{Binding HasNoNetworkDeviceScanResults, Converter={StaticResource BoolVisibility}}">
                                        <TextBlock Text="{Binding NetworkDeviceScanResultsEmptyText}" Foreground="#475569" TextWrapping="Wrap" />
                                    </Border>
                                    <DataGrid ItemsSource="{Binding LastNetworkDeviceScan.Devices}" SelectedItem="{Binding SelectedNetworkDeviceScanResult}" Visibility="{Binding HasNetworkDeviceScanResults, Converter={StaticResource BoolVisibility}}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                              MinHeight="140" MaxHeight="340"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                              ScrollViewer.VerticalScrollBarVisibility="Visible"
                                              ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                              ScrollViewer.CanContentScroll="True"
                                              EnableRowVirtualization="True"
                                              EnableColumnVirtualization="True"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="IP" Binding="{Binding AddressDisplay}" Width="120" />
                                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="180" />
                                            <DataGridTextColumn Header="Type" Binding="{Binding DeviceTypeDisplay}" Width="190" />
                                            <DataGridTextColumn Header="Vendor (MAC)" Binding="{Binding MacVendorDisplay}" Width="150" />
                                            <DataGridTextColumn Header="MAC" Binding="{Binding MacAddressDisplay}" Width="150" />
                                            <DataGridTextColumn Header="Label / location" Binding="{Binding FriendlyLabelDisplay}" Width="180" />
                                            <DataGridTextColumn Header="SNMP location" Binding="{Binding LocationDisplay}" Width="140" />
                                            <DataGridTextColumn Header="Confidence" Binding="{Binding ClassificationConfidenceDisplay}" Width="100" />
                                            <DataGridTextColumn Header="Ping" Binding="{Binding PingReachableText}" Width="70" />
                                            <DataGridTextColumn Header="Open ports" Binding="{Binding OpenPortSummary}" Width="140" />
                                            <DataGridTextColumn Header="Confirmation" Binding="{Binding ConfirmationStatusDisplay}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <!-- Label editor: name + location for the selected device, persisted per MAC. -->
                                    <Grid Margin="0,10,0,0" Visibility="{Binding HasNetworkDeviceScanResults, Converter={StaticResource BoolVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Label / location for selected device:" Foreground="#475569" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBox Grid.Column="1" Text="{Binding SelectedDeviceLabelText, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="10,6" BorderBrush="#BFCFE5" VerticalContentAlignment="Center"
                                                 ToolTip="Free text saved per device MAC, e.g. 'Imprimanta etaj 2 — contabilitate'. Shared with the Wi-Fi module's device names." />
                                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Save Label" Command="{Binding SaveDeviceLabelCommand}" Margin="10,0,0,0"
                                                ToolTip="Persist the label for this device (keyed by MAC, falls back to IP)." />
                                        <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Content="Clear" Command="{Binding ClearDeviceLabelCommand}" Margin="8,0,0,0"
                                                ToolTip="Remove the saved label for this device." />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <UniformGrid Columns="2">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="SNMP Identity" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                                        <TextBlock Style="{StaticResource LabelText}" Text="Address" />
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastNetworkDevice.Identity.AddressDisplay, TargetNullValue=Unknown}" />
                                        <TextBlock Style="{StaticResource LabelText}" Text="Protocol" Margin="0,12,0,3" />
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastNetworkDevice.Identity.ProtocolDisplay, TargetNullValue=Unknown}" />
                                        <TextBlock Style="{StaticResource LabelText}" Text="Name" Margin="0,12,0,3" />
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastNetworkDevice.Identity.SysNameDisplay, TargetNullValue=Unknown}" />
                                        <TextBlock Style="{StaticResource LabelText}" Text="Description" Margin="0,12,0,3" />
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastNetworkDevice.Identity.SysDescrDisplay, TargetNullValue=Unknown}" />
                                        <TextBlock Style="{StaticResource LabelText}" Text="Location" Margin="0,12,0,3" />
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastNetworkDevice.Identity.SysLocationDisplay, TargetNullValue=Unknown}" />
                                        <TextBlock Style="{StaticResource LabelText}" Text="Contact" Margin="0,12,0,3" />
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastNetworkDevice.Identity.SysContactDisplay, TargetNullValue=Unknown}" />
                                        <TextBlock Style="{StaticResource LabelText}" Text="Uptime" Margin="0,12,0,3" />
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastNetworkDevice.Identity.SysUpTimeDisplay, TargetNullValue=Unknown}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Evidence" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                                        <TextBlock Text="No evidence was produced for this result." Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,7"
                                                   Visibility="{Binding HasNoNetworkDeviceEvidence, Converter={StaticResource BoolVisibility}}" />
                                        <ScrollViewer MaxHeight="300"
                                                      VerticalScrollBarVisibility="Visible"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      Visibility="{Binding HasNetworkDeviceEvidence, Converter={StaticResource BoolVisibility}}">
                                            <ItemsControl ItemsSource="{Binding LastNetworkDevice.Evidence}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StringFormat=- {0}}" TextWrapping="Wrap" Margin="0,0,12,7" Foreground="#334155" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Limitations" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <TextBlock Text="No limitations were recorded for this result." Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,7"
                                               Visibility="{Binding HasNoNetworkDeviceLimitations, Converter={StaticResource BoolVisibility}}" />
                                    <ScrollViewer MaxHeight="240"
                                                  VerticalScrollBarVisibility="Visible"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Visibility="{Binding HasNetworkDeviceLimitations, Converter={StaticResource BoolVisibility}}">
                                        <ItemsControl ItemsSource="{Binding LastNetworkDevice.Limitations}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat=- {0}}" TextWrapping="Wrap" Margin="0,0,12,7" Foreground="#334155" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Recommended Next Checks" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <TextBlock Text="No next checks were produced for this result." Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,7"
                                               Visibility="{Binding HasNoNetworkDeviceRecommendations, Converter={StaticResource BoolVisibility}}" />
                                    <ItemsControl ItemsSource="{Binding LastNetworkDevice.Recommendations}"
                                                  Visibility="{Binding HasNetworkDeviceRecommendations, Converter={StaticResource BoolVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat=- {0}}" TextWrapping="Wrap" Margin="0,0,0,7" Foreground="#334155" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Ports Needing Attention" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <TextBlock Text="No interfaces need attention for this result." Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,7"
                                               Visibility="{Binding HasNoNetworkDevicePortsNeedingAttention, Converter={StaticResource BoolVisibility}}" />
                                    <DataGrid ItemsSource="{Binding LastNetworkDevice.PortsNeedingAttention}" Visibility="{Binding HasNetworkDevicePortsNeedingAttention, Converter={StaticResource BoolVisibility}}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                              MinHeight="140" MaxHeight="300"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                              ScrollViewer.VerticalScrollBarVisibility="Visible"
                                              ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                              ScrollViewer.CanContentScroll="True"
                                              EnableRowVirtualization="True"
                                              EnableColumnVirtualization="True"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Index" Binding="{Binding Index}" Width="70" />
                                            <DataGridTextColumn Header="Name" Binding="{Binding NameDisplay}" Width="130" />
                                            <DataGridTextColumn Header="Description" Binding="{Binding DescriptionDisplay}" Width="*" />
                                            <DataGridTextColumn Header="Oper" Binding="{Binding OperStatusDisplay}" Width="80" />
                                            <DataGridTextColumn Header="Speed" Binding="{Binding SpeedTextDisplay}" Width="110" />
                                            <DataGridTextColumn Header="Errors/s" Binding="{Binding ErrorsPerSecond, StringFormat={}{0:N2}}" Width="90" />
                                            <DataGridTextColumn Header="Discards/s" Binding="{Binding DiscardsPerSecond, StringFormat={}{0:N2}}" Width="95" />
                                            <DataGridTextColumn Header="Traffic/s" Binding="{Binding TrafficRateTextDisplay}" Width="110" />
                                            <DataGridTextColumn Header="Reason" Binding="{Binding AttentionReasonDisplay}" Width="200" />
                                            <DataGridTextColumn Header="Next check" Binding="{Binding RecommendedNextCheckDisplay}" Width="260" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Interfaces / Ports" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding NetworkDeviceInterfaceFilterSummary}" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding NetworkDeviceInterfaceFilters}" SelectedItem="{Binding NetworkDeviceInterfaceFilter}" Height="34" Padding="8,5" BorderBrush="#BFCFE5" />
                                    </Grid>
                                    <TextBlock Text="{Binding FilteredNetworkDeviceInterfacesEmptyText}" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,7"
                                               Visibility="{Binding HasNoFilteredNetworkDeviceInterfaces, Converter={StaticResource BoolVisibility}}" />
                                    <DataGrid ItemsSource="{Binding FilteredNetworkDeviceInterfaces}" Visibility="{Binding HasFilteredNetworkDeviceInterfaces, Converter={StaticResource BoolVisibility}}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                              MinHeight="240" MaxHeight="440"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                              ScrollViewer.VerticalScrollBarVisibility="Visible"
                                              ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                              ScrollViewer.CanContentScroll="True"
                                              EnableRowVirtualization="True"
                                              EnableColumnVirtualization="True"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Index" Binding="{Binding Index}" Width="70" />
                                            <DataGridTextColumn Header="Name" Binding="{Binding NameDisplay}" Width="130" />
                                            <DataGridTextColumn Header="Description" Binding="{Binding DescriptionDisplay}" Width="*" />
                                            <DataGridTextColumn Header="Admin" Binding="{Binding AdminStatusDisplay}" Width="90" />
                                            <DataGridTextColumn Header="Oper" Binding="{Binding OperStatusDisplay}" Width="90" />
                                            <DataGridTextColumn Header="Speed" Binding="{Binding SpeedTextDisplay}" Width="110" />
                                            <DataGridTextColumn Header="Errors" Binding="{Binding Errors}" Width="90" />
                                            <DataGridTextColumn Header="Discards" Binding="{Binding Discards}" Width="90" />
                                            <DataGridTextColumn Header="Traffic" Binding="{Binding TrafficTextDisplay}" Width="170" />
                                            <DataGridTextColumn Header="Traffic/s" Binding="{Binding TrafficRateTextDisplay}" Width="120" />
                                            <DataGridTextColumn Header="Errors/s" Binding="{Binding ErrorsPerSecond, StringFormat={}{0:N2}}" Width="90" />
                                            <DataGridTextColumn Header="Discards/s" Binding="{Binding DiscardsPerSecond, StringFormat={}{0:N2}}" Width="95" />
                                            <DataGridTextColumn Header="Verdict" Binding="{Binding VerdictDisplay}" Width="180" />
                                            <DataGridTextColumn Header="Next check" Binding="{Binding RecommendedNextCheckDisplay}" Width="260" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Wifi}" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-10,0">
                        <StackPanel>
                            <!-- =============================================
                                  Wi-Fi Analyzer Premium — 12 sections.
                                  All data bound to MainViewModel.WifiAnalyzer (DI singleton).
                                 ============================================= -->

                            <!-- Hero banner (sky theme) — kept consistent with other modules. -->
                            <Border Style="{StaticResource ModuleHeroBanner}" Background="{StaticResource HeroBgWifi}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource ModuleHeroChip}" Background="{StaticResource AccentWifi}">
                                        <TextBlock Style="{StaticResource ModuleHeroIcon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE701;" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource ModuleHeroTitle}" Text="Wi-Fi Analyzer" />
                                        <TextBlock Style="{StaticResource ModuleHeroSubtitle}" Text="Live connection, RSSI + speed monitors, channel map, visible APs, capabilities and recommendations." />
                                    </StackPanel>
                                    <!-- Hero toolbar: Link Score badge + scan controls. -->
                                    <WrapPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <!-- Link Score badge (inSSIDer-style composite 0..100). -->
                                        <Border CornerRadius="10" Padding="16,8" Margin="0,0,14,0"
                                                Background="{Binding WifiAnalyzer.LinkScoreColor}"
                                                VerticalAlignment="Center">
                                            <StackPanel>
                                                <TextBlock HorizontalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="22"
                                                           Text="{Binding WifiAnalyzer.LinkScore, FallbackValue=—, TargetNullValue=—}" />
                                                <TextBlock HorizontalAlignment="Center" Foreground="White" FontSize="10" Opacity="0.9"
                                                           Text="{Binding WifiAnalyzer.LinkScoreVerdict}" />
                                            </StackPanel>
                                        </Border>
                                        <!-- On-demand: Start runs first scan + live monitor; only active when idle. -->
                                        <Button Style="{StaticResource PrimaryButtonWifi}" Content="Start Analyzer"
                                                Command="{Binding WifiAnalyzer.StartMonitoringCommand}" Margin="0,0,8,0"
                                                Visibility="{Binding WifiAnalyzer.IsIdle, Converter={StaticResource BoolVisibility}}"
                                                ToolTip="Begin live RSSI/speed monitoring + an active scan of nearby networks. Nothing touches the radio until you press this." />
                                        <Button Style="{StaticResource DangerButton}" Content="Stop"
                                                Command="{Binding WifiAnalyzer.StopMonitoringCommand}" Margin="0,0,8,0"
                                                Visibility="{Binding WifiAnalyzer.IsMonitoring, Converter={StaticResource BoolVisibility}}"
                                                ToolTip="Stop live monitoring and auto-rescan. Results stay on screen." />
                                        <Button Style="{StaticResource WifiRescanButton}" Content="Rescan"
                                                Command="{Binding WifiAnalyzer.ScanNetworksCommand}" Margin="0,0,8,0"
                                                Visibility="{Binding WifiAnalyzer.IsMonitoring, Converter={StaticResource BoolVisibility}}"
                                                ToolTip="Run one more active scan now (~4-5 s)." />
                                        <CheckBox Content="Auto every 30s" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,12,0"
                                                  IsChecked="{Binding WifiAnalyzer.AutoRescanEnabled, Mode=TwoWay}"
                                                  Visibility="{Binding WifiAnalyzer.IsMonitoring, Converter={StaticResource BoolVisibility}}"
                                                  ToolTip="When on, a fresh scan runs every 30 seconds (NetSpot-style continuous monitoring). Off by default." />
                                        <Button Style="{StaticResource WifiCopyButton}" Content="Copy for ticket" Command="{Binding WifiAnalyzer.CopyReportCommand}" Margin="0,0,8,0"
                                                ToolTip="Copy the full Wi-Fi snapshot (connection, health, visible APs, channel map, LAN devices) to the clipboard." />
                                        <Button Style="{StaticResource WifiExportButton}" Content="Export" Command="{Binding WifiAnalyzer.ExportReportCommand}" Margin="0,0,8,0"
                                                ToolTip="Save a plain-text snapshot (connection, health, best channel, visible APs, channel map, LAN devices) to the Desktop and open it for ticket evidence." />
                                        <Button Style="{StaticResource WifiHistoryButton}" Content="History" Command="{Binding WifiAnalyzer.OpenHistoryCommand}" Margin="0,0,8,0"
                                                ToolTip="Open the rolling per-day CSV history folder (signal + throughput, last 14 days)." />
                                        <Button Style="{StaticResource WifiWlanReportButton}" Content="WLAN Report" Command="{Binding GenerateWlanReportCommand}" ToolTip="Run 'netsh wlan show wlanreport' (admin required)." />
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <!-- ==================================
                                 § 1. Connection card
                                 ================================== -->
                            <Border Style="{StaticResource Card}"
                                    BorderBrush="{Binding WifiAnalyzer.LinkScoreColor}" BorderThickness="0,4,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Connection" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" />
                                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Border CornerRadius="5" Padding="8,4" Margin="0,0,8,6"
                                                    Background="{Binding WifiAnalyzer.ConnectionStateColor}">
                                                <TextBlock Text="{Binding WifiAnalyzer.ConnectionStateLabel}"
                                                           Foreground="White"
                                                           FontSize="11"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Text="{Binding WifiAnalyzer.ConnectionCapturedText}"
                                                       FontSize="11"
                                                       Foreground="#475569"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,6" />
                                            <Button Style="{StaticResource PrimaryButtonWifi}"
                                                    Content="Refresh"
                                                    Command="{Binding WifiAnalyzer.RefreshConnectionCommand}"
                                                    Padding="10,4"
                                                    MinHeight="0"
                                                    FontSize="12"
                                                    Margin="0,0,10,6"
                                                    ToolTip="Refresh the current Wi-Fi connection snapshot without running an active scan." />
                                            <TextBlock FontSize="11" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,0,6">
                                                <Run Text="Source:" />
                                                <Run Text="{Binding WifiAnalyzer.ScannerSourceLabel, Mode=OneWay}" FontWeight="SemiBold" />
                                            </TextBlock>
                                        </WrapPanel>
                                    </Grid>
                                    <TextBlock Foreground="#475569" FontSize="13" Margin="0,2,0,12"
                                               Text="{Binding WifiAnalyzer.Status}" TextWrapping="Wrap" />

                                    <!-- Two-column grid for connection fields. -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource LabelText}" Text="SSID" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding WifiAnalyzer.Connection.Ssid, FallbackValue=Not connected, TargetNullValue=Not connected}" TextWrapping="Wrap" />

                                            <TextBlock Style="{StaticResource LabelText}" Text="BSSID" Margin="0,10,0,3" />
                                            <TextBlock Style="{StaticResource ValueText}" TextWrapping="Wrap">
                                                <Run Text="{Binding WifiAnalyzer.ConnectionBssidText, Mode=OneWay}" />
                                                <Run Text=" · " Foreground="#94A3B8" />
                                                <Run Text="{Binding WifiAnalyzer.ConnectionVendorText, Mode=OneWay}" Foreground="#475569" FontSize="12" />
                                            </TextBlock>

                                            <TextBlock Style="{StaticResource LabelText}" Text="Channel / Frequency" Margin="0,10,0,3" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding WifiAnalyzer.Connection.ChannelDescription, Mode=OneWay}" TextWrapping="Wrap" />

                                            <TextBlock Style="{StaticResource LabelText}" Text="Standard / Band" Margin="0,10,0,3" />
                                            <TextBlock Style="{StaticResource ValueText}" TextWrapping="Wrap">
                                                <Run Text="{Binding WifiAnalyzer.Connection.PhyFriendlyName, Mode=OneWay}" />
                                                <Run Text=" · " Foreground="#94A3B8" />
                                                <Run Text="{Binding WifiAnalyzer.Connection.Band, Mode=OneWay}" />
                                            </TextBlock>

                                            <TextBlock Style="{StaticResource LabelText}" Text="Security" Margin="0,10,0,3" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding WifiAnalyzer.ConnectionSecurityText, Mode=OneWay}" />

                                            <TextBlock Style="{StaticResource LabelText}" Text="Hidden SSID" Margin="0,10,0,3" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding WifiAnalyzer.HiddenSsidText, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource LabelText}" Text="Signal (live)" />
                                            <TextBlock Style="{StaticResource ValueText}">
                                                <Run Text="{Binding WifiAnalyzer.Connection.RssiDbm, Mode=OneWay, StringFormat={}{0} dBm, FallbackValue=—, TargetNullValue=—}" />
                                                <Run Text=" · " Foreground="#94A3B8" />
                                                <Run Text="{Binding WifiAnalyzer.Connection.SignalLevel, Mode=OneWay}" />
                                            </TextBlock>

                                            <TextBlock Style="{StaticResource LabelText}" Text="Link speed (Rx / Tx)" Margin="0,10,0,3" />
                                            <TextBlock Style="{StaticResource ValueText}">
                                                <Run Text="{Binding WifiAnalyzer.Connection.RxRateMbps, Mode=OneWay, StringFormat={}{0:N0}, FallbackValue=—, TargetNullValue=—}" />
                                                <Run Text=" / " />
                                                <Run Text="{Binding WifiAnalyzer.Connection.TxRateMbps, Mode=OneWay, StringFormat={}{0:N0}, FallbackValue=—, TargetNullValue=—}" />
                                                <Run Text=" Mbps" Foreground="#475569" />
                                            </TextBlock>

                                            <TextBlock Style="{StaticResource LabelText}" Text="Gateway ping (live)" Margin="0,10,0,3" />
                                            <TextBlock Style="{StaticResource ValueText}">
                                                <Run Text="{Binding StatusMonitor.LastLatencyMs, Mode=OneWay, StringFormat={}{0:N0} ms, FallbackValue=— ms, TargetNullValue=— ms}" FontWeight="SemiBold" />
                                                <Run Text=" · loss " Foreground="#94A3B8" />
                                                <Run Text="{Binding StatusMonitor.Summary.LossPercent, Mode=OneWay, StringFormat={}{0:N0}%, FallbackValue=0%}" Foreground="#475569" FontSize="12" />
                                            </TextBlock>

                                            <TextBlock Style="{StaticResource LabelText}" Text="Network configuration" Margin="0,10,0,3" />
                                            <TextBlock Style="{StaticResource ValueText}" TextWrapping="Wrap">
                                                <Run Text="IP " Foreground="#94A3B8" FontSize="12" />
                                                <Run Text="{Binding WifiAnalyzer.Connection.Ipv4Address, Mode=OneWay, FallbackValue=—, TargetNullValue=—}" />
                                                <Run Text="  /  " Foreground="#94A3B8" />
                                                <Run Text="{Binding WifiAnalyzer.Connection.Ipv4SubnetMask, Mode=OneWay, FallbackValue=—, TargetNullValue=—}" FontSize="12" Foreground="#475569" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource ValueText}" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap">
                                                <Run Text="GW " Foreground="#94A3B8" FontSize="12" />
                                                <Run Text="{Binding WifiAnalyzer.Connection.Ipv4Gateway, Mode=OneWay, FallbackValue=—, TargetNullValue=—}" />
                                                <Run Text="   DNS " Foreground="#94A3B8" FontSize="12" />
                                                <Run Text="{Binding WifiAnalyzer.Connection.DnsServersText, Mode=OneWay, FallbackValue=—, TargetNullValue=—}" FontSize="12" Foreground="#475569" />
                                            </TextBlock>

                                            <Grid Margin="0,10,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Style="{StaticResource LabelText}" Text="Public IP / ISP" VerticalAlignment="Center" />
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource WifiExportButton}"
                                                        Content="Detect ISP"
                                                        Command="{Binding WifiAnalyzer.DetectIspCommand}"
                                                        Padding="9,4"
                                                        MinHeight="0"
                                                        FontSize="12"
                                                        ToolTip="Run an explicit public IP and ISP lookup." />
                                            </Grid>
                                            <TextBlock Style="{StaticResource ValueText}" TextWrapping="Wrap">
                                                <Run Text="{Binding WifiAnalyzer.Connection.PublicIpAddress, Mode=OneWay, FallbackValue=Not checked, TargetNullValue=Not checked}" />
                                                <Run Text=" · " Foreground="#94A3B8" />
                                                <Run Text="{Binding WifiAnalyzer.Connection.IspName, Mode=OneWay, FallbackValue=Click Detect ISP, TargetNullValue=Click Detect ISP}" Foreground="#475569" FontSize="12" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource ValueText}" FontSize="12" Foreground="#475569"
                                                       Text="{Binding WifiAnalyzer.Connection.IspLocation, Mode=OneWay, FallbackValue='', TargetNullValue=''}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ==================================
                                 § 2. Live monitors strip (4 mini sparklines)
                                 ================================== -->
                            <UniformGrid Columns="4">
                                <!-- RSSI mini — auto-scaled area chart -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="RSSI (60 s)" Style="{StaticResource LabelText}" />
                                        <TextBlock Style="{StaticResource ValueText}" FontSize="20"
                                                   Text="{Binding WifiAnalyzer.LiveSignalValueText}" />
                                        <controls:WifiSparklineGraph Height="68" Margin="0,8,0,0"
                                                                     Mode="Rssi" Samples="{Binding WifiAnalyzer.SignalSamples}" />
                                        <TextBlock Text="{Binding WifiAnalyzer.RssiStats}" FontSize="11"
                                                   Foreground="#64748B" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding WifiAnalyzer.SignalSampleCountText}" FontSize="10"
                                                   Foreground="#94A3B8" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Speed mini (Rx + Tx) — auto-scaled, shared axis -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Link speed (60 s)" Style="{StaticResource LabelText}" />
                                        <TextBlock Style="{StaticResource ValueText}" FontSize="20"
                                                   Text="{Binding WifiAnalyzer.LiveLinkSpeedValueText}" />
                                        <controls:WifiSparklineGraph Height="68" Margin="0,8,0,0"
                                                                     Mode="Speed" Samples="{Binding WifiAnalyzer.SpeedSamples}" />
                                        <TextBlock Text="{Binding WifiAnalyzer.SpeedStats}" FontSize="11"
                                                   Foreground="#64748B" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding WifiAnalyzer.SpeedSampleCountText}" FontSize="10"
                                                   Foreground="#94A3B8" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Gateway ping (global StatusMonitor target). -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Gateway ping (global)" Style="{StaticResource LabelText}" />
                                        <TextBlock Style="{StaticResource ValueText}" FontSize="20">
                                            <Run Text="{Binding StatusMonitor.LastLatencyMs, Mode=OneWay, StringFormat={}{0:N0} ms, FallbackValue=— ms, TargetNullValue=— ms}" />
                                        </TextBlock>
                                        <controls:WifiSparklineGraph Height="68" Margin="0,8,0,0"
                                                                     Mode="Ping" Samples="{Binding StatusMonitor.Samples}" />
                                        <TextBlock FontSize="10" Foreground="#94A3B8" Margin="0,6,0,0"
                                                   Text="{Binding StatusMonitor.CurrentTarget, StringFormat=Target {0}, FallbackValue=No target}" />
                                    </StackPanel>
                                </Border>

                                <!-- Real adapter throughput from NIC byte counters. -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Throughput now" Style="{StaticResource LabelText}" />
                                        <TextBlock Style="{StaticResource ValueText}" FontSize="20"
                                                   Text="{Binding WifiAnalyzer.LiveThroughputValueText}"
                                                   TextWrapping="Wrap" />
                                        <controls:WifiSparklineGraph Height="68" Margin="0,8,0,0"
                                                                     Mode="Throughput" Samples="{Binding WifiAnalyzer.SpeedSamples}" />
                                        <TextBlock Text="{Binding WifiAnalyzer.ThroughputStats}" FontSize="11"
                                                   Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- ==================================
                                 § 5. Strength monitor (big sparkline) + § 6. Speed monitor
                                 Two side-by-side larger cards combining the live samples
                                 with verdict labels.
                                 ================================== -->
                            <UniformGrid Columns="2">
                                <Border Style="{StaticResource Card}" BorderBrush="{StaticResource AccentWifi}" BorderThickness="0,4,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Signal Strength" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding WifiAnalyzer.LiveSignalValueText}"
                                                           FontSize="32"
                                                           FontWeight="Bold"
                                                           Foreground="#0F172A"
                                                           TextWrapping="Wrap" />
                                                <WrapPanel Margin="0,6,0,0">
                                                    <Border CornerRadius="5" Padding="8,4"
                                                            Background="{Binding WifiAnalyzer.SignalStrengthColor}"
                                                            Margin="0,0,8,6">
                                                        <TextBlock Text="{Binding WifiAnalyzer.SignalStrengthLabel}"
                                                                   Foreground="White"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                    <TextBlock Text="{Binding WifiAnalyzer.SignalMarginText}"
                                                               FontSize="12"
                                                               Foreground="#475569"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,0,6" />
                                                </WrapPanel>
                                            </StackPanel>
                                            <controls:WifiSparklineGraph Grid.Column="1" Width="260" Height="72"
                                                                         Mode="Rssi" Samples="{Binding WifiAnalyzer.SignalSamples}" />
                                        </Grid>
                                        <TextBlock FontSize="11" Foreground="#475569" Margin="0,8,0,0"
                                                   Text="{Binding WifiAnalyzer.RssiStats}" />
                                        <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"
                                                   Text="Thresholds: Excellent >= -65 / Good -75 / Fair -85 / Poor &lt; -85 dBm" />

                                        <!-- Low-signal alert: user-set floor + live banner. -->
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding WifiAnalyzer.SignalAlertCaption}"
                                                       FontSize="11" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Slider Grid.Column="1" Minimum="-100" Maximum="-40" VerticalAlignment="Center"
                                                    SmallChange="1" LargeChange="5" TickFrequency="5" IsSnapToTickEnabled="True"
                                                    Value="{Binding WifiAnalyzer.SignalAlertThresholdDbm, Mode=TwoWay}"
                                                    ToolTip="Show a banner when the live signal drops below this RSSI." />
                                            <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" Foreground="#0EA5E9"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                                       Text="{Binding WifiAnalyzer.SignalAlertThresholdDbm, StringFormat={}{0} dBm}" />
                                            <CheckBox Grid.Column="3"
                                                      Content="Sound"
                                                      IsChecked="{Binding WifiAnalyzer.SignalAlertSoundEnabled, Mode=TwoWay}"
                                                      Foreground="#475569"
                                                      VerticalAlignment="Center"
                                                      Margin="12,0,0,0"
                                                      ToolTip="Play one alert sound when RSSI first drops below the threshold. Banner alerts still work when sound is off." />
                                        </Grid>
                                        <TextBlock Text="{Binding WifiAnalyzer.SignalAlertStatusText}"
                                                   FontSize="11"
                                                   Foreground="#64748B"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap" />
                                        <Border CornerRadius="6" Padding="10,7" Margin="0,8,0,0"
                                                Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1"
                                                Visibility="{Binding WifiAnalyzer.IsSignalAlerting, Converter={StaticResource BoolVisibility}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Alert" FontSize="12" FontWeight="SemiBold" Foreground="#DC2626" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding WifiAnalyzer.SignalAlertText}" FontSize="12" Foreground="#991B1B"
                                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" BorderBrush="{StaticResource AccentWifi}" BorderThickness="0,4,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Link Speed (PHY rate)" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" />
                                            <Border Grid.Column="1" CornerRadius="5" Padding="8,4"
                                                    Background="{Binding WifiAnalyzer.LinkSpeedStateColor}">
                                                <TextBlock Text="{Binding WifiAnalyzer.LinkSpeedStateText}"
                                                           Foreground="White"
                                                           FontSize="11"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" MinWidth="180" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Receive PHY" FontSize="11" Foreground="#64748B" />
                                                <TextBlock Text="{Binding WifiAnalyzer.LinkSpeedRxText}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap" />
                                                <TextBlock Text="Transmit PHY" FontSize="11" Foreground="#64748B" Margin="0,6,0,0" />
                                                <TextBlock Text="{Binding WifiAnalyzer.LinkSpeedTxText}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <controls:WifiSparklineGraph Grid.Column="1" MinWidth="180" Height="72"
                                                                         Mode="Speed" Samples="{Binding WifiAnalyzer.SpeedSamples}" />
                                        </Grid>
                                        <TextBlock FontSize="12" Foreground="#475569" Margin="0,8,0,0"
                                                   Text="{Binding WifiAnalyzer.LinkSpeedDeltaText}" TextWrapping="Wrap" />
                                        <TextBlock FontSize="11" Foreground="#475569" Margin="0,8,0,0"
                                                   Text="{Binding WifiAnalyzer.SpeedStats}" />
                                        <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"
                                                   Text="PHY rate is the negotiated radio speed. Actual receive/transfer traffic is shown in the throughput monitors below." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- ==================================
                                 § 6b. Receive Rate + Transfer Rate — separate bar monitors
                                 ================================== -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Receive Rate" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" />
                                        <Border Grid.Column="1" CornerRadius="5" Padding="8,4"
                                                Background="{Binding WifiAnalyzer.ReceiveThroughputStateColor}">
                                            <TextBlock Text="{Binding WifiAnalyzer.ReceiveThroughputStateText}"
                                                       Foreground="White"
                                                       FontSize="11"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding WifiAnalyzer.ReceiveThroughputNowText}"
                                               FontSize="30"
                                               FontWeight="Bold"
                                               Foreground="#0F172A"
                                               Margin="0,10,0,0"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding WifiAnalyzer.ReceiveThroughputStatsText}"
                                               FontSize="12"
                                               Foreground="#475569"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap" />
                                    <TextBlock FontSize="12" Foreground="#64748B" Margin="0,6,0,0"
                                               Text="Actual data arriving over the Wi-Fi adapter per second. Near zero when idle, rises during downloads, streams, or file copies."
                                               TextWrapping="Wrap" />
                                    <controls:WifiThroughputGraph Height="200" Margin="0,12,0,0" Series="Rx"
                                                                  Samples="{Binding WifiAnalyzer.SpeedSamples}" />
                                    <TextBlock Text="{Binding WifiAnalyzer.SpeedSampleCountText}" FontSize="10"
                                               Foreground="#94A3B8" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Transfer Rate" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" />
                                        <Border Grid.Column="1" CornerRadius="5" Padding="8,4"
                                                Background="{Binding WifiAnalyzer.TransferThroughputStateColor}">
                                            <TextBlock Text="{Binding WifiAnalyzer.TransferThroughputStateText}"
                                                       Foreground="White"
                                                       FontSize="11"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding WifiAnalyzer.TransferThroughputNowText}"
                                               FontSize="30"
                                               FontWeight="Bold"
                                               Foreground="#0F172A"
                                               Margin="0,10,0,0"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding WifiAnalyzer.TransferThroughputStatsText}"
                                               FontSize="12"
                                               Foreground="#475569"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap" />
                                    <TextBlock FontSize="12" Foreground="#64748B" Margin="0,6,0,0"
                                               Text="Actual data sent over the Wi-Fi adapter per second. Near zero when idle, rises during uploads, calls, backups, or file copies."
                                               TextWrapping="Wrap" />
                                    <controls:WifiThroughputGraph Height="200" Margin="0,12,0,0" Series="Tx"
                                                                  Samples="{Binding WifiAnalyzer.SpeedSamples}" />
                                    <TextBlock Text="{Binding WifiAnalyzer.SpeedSampleCountText}" FontSize="10"
                                               Foreground="#94A3B8" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- ==================================
                                 § 7. Devices on this network — on-demand LAN sweep
                                 ================================== -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock Text="Wireless devices on this network" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" />
                                            <TextBlock FontSize="12" Foreground="#475569" Margin="0,2,0,0"
                                                       TextWrapping="Wrap"
                                                       Text="Shows only confirmed or likely wireless clients/infrastructure. ARP/DNS/mDNS/SSDP are evidence; they do not prove Wi-Fi by themselves." />
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource PrimaryButtonWifi}" Content="Auto Detect"
                                                VerticalAlignment="Top"
                                                MinWidth="124"
                                                Command="{Binding WifiAnalyzer.AutoDetectWirelessDevicesCommand}"
                                                ToolTip="Automatically collect safe local evidence and try gateway/AP read-only evidence. No manual source setup required." />
                                    </Grid>

                                    <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="#64748B"
                                               Text="{Binding WifiAnalyzer.LanScanStatus}" TextWrapping="Wrap" />

                                    <Border Height="1" Background="#D8E4F2" Margin="0,16,0,14" />
                                    <StackPanel>
                                        <TextBlock Text="Wireless candidate inventory" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" />
                                        <TextBlock FontSize="12" Foreground="#475569" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Text="{Binding WifiAnalyzer.DeviceInventorySummary}" />
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Style="{StaticResource PrimaryButtonWifi}" Content="All"
                                                    MinWidth="74" Margin="0,0,8,8"
                                                    Command="{Binding WifiAnalyzer.SetDeviceInventoryFilterCommand}"
                                                    CommandParameter="All"
                                                    ToolTip="Show all confirmed and likely wireless candidates." />
                                            <Button Style="{StaticResource WifiRescanButton}" Content="Confirmed"
                                                    MinWidth="104" Margin="0,0,8,8"
                                                    Command="{Binding WifiAnalyzer.SetDeviceInventoryFilterCommand}"
                                                    CommandParameter="Confirmed"
                                                    ToolTip="Show devices with confirmed Wi-Fi or AP infrastructure evidence." />
                                            <Button Style="{StaticResource WifiExportButton}" Content="Likely"
                                                    MinWidth="82" Margin="0,0,8,8"
                                                    Command="{Binding WifiAnalyzer.SetDeviceInventoryFilterCommand}"
                                                    CommandParameter="Likely"
                                                    ToolTip="Show devices that look wireless by device fingerprint or AP role evidence." />
                                            <Button Style="{StaticResource WifiCopyButton}" Content="Needs name"
                                                    MinWidth="112" Margin="0,0,8,8"
                                                    Command="{Binding WifiAnalyzer.SetDeviceInventoryFilterCommand}"
                                                    CommandParameter="Needs name"
                                                    ToolTip="Show wireless candidates that did not advertise a usable device name." />
                                            <Button Style="{StaticResource WifiHistoryButton}" Content="Phones / TV / IoT"
                                                    MinWidth="138" Margin="0,0,8,8"
                                                    Command="{Binding WifiAnalyzer.SetDeviceInventoryFilterCommand}"
                                                    CommandParameter="Phones/TV/IoT"
                                                    ToolTip="Show personal wireless devices such as phones, TVs, consoles, cameras, and IoT devices." />
                                            <Button Style="{StaticResource DangerButton}" Content="Clear session"
                                                    MinWidth="118" Margin="0,0,0,8"
                                                    Command="{Binding WifiAnalyzer.ClearDeviceSessionCommand}"
                                                    ToolTip="Clear current device evidence and selection. Saved friendly names and type overrides are kept." />
                                        </WrapPanel>
                                        <TextBlock FontSize="12" Foreground="#64748B" Margin="0,0,0,0" TextWrapping="Wrap"
                                                   Text="{Binding WifiAnalyzer.DeviceInventoryFilterSummary}" />
                                        <DataGrid Margin="0,10,0,0" ItemsSource="{Binding WifiAnalyzer.DeviceInventory}"
                                                  SelectedItem="{Binding WifiAnalyzer.SelectedDeviceInventoryItem, Mode=TwoWay}"
                                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                                  ScrollViewer.VerticalScrollBarVisibility="Visible"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                  Height="280" MinHeight="200" MaxHeight="280"
                                                  EnableRowVirtualization="True"
                                                  RowHeight="40" ColumnHeaderHeight="36">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="100" MinWidth="92" />
                                                <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="2*" MinWidth="150">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                            <Setter Property="ToolTip" Value="{Binding EvidenceDisplay}" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Type" Binding="{Binding DeviceType}" Width="1.1*" MinWidth="112" />
                                                <DataGridTextColumn Header="Wireless" Binding="{Binding WirelessStatusDisplay}" Width="1.3*" MinWidth="150" />
                                                <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="92" />
                                                <DataGridTextColumn Header="Sources" Binding="{Binding SourceDisplay}" Width="1.6*" MinWidth="140" />
                                                <DataGridTextColumn Header="MAC" Binding="{Binding MacDisplay}" Width="1.3*" MinWidth="132" FontFamily="Consolas" />
                                                <DataGridTextColumn Header="Vendor" Binding="{Binding VendorDisplay}" Width="1.2*" MinWidth="110" />
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="#64748B"
                                                   Text="{Binding WifiAnalyzer.SelectedDeviceSummary}" TextWrapping="Wrap" />
                                        <Border Margin="0,10,0,0" Padding="12"
                                                Background="#F8FBFF"
                                                BorderBrush="#BFD4EC"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Visibility="{Binding WifiAnalyzer.SelectedDeviceInventoryItem, Converter={StaticResource NullToVisibility}}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="128" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="128" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DeviceDetailLabel}" Text="Display name" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DeviceDetailValue}" Text="{Binding WifiAnalyzer.SelectedDeviceInventoryItem.DisplayName}" />
                                                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource DeviceDetailLabel}" Text="IP address" />
                                                <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource DeviceDetailValue}" Text="{Binding WifiAnalyzer.SelectedDeviceInventoryItem.IpAddress}" FontFamily="Consolas" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DeviceDetailLabel}" Margin="0,8,0,2" Text="Learned name" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DeviceDetailValue}" Margin="0,8,0,0" Text="{Binding WifiAnalyzer.SelectedDeviceInventoryItem.LearnedNameDisplay}" />
                                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource DeviceDetailLabel}" Margin="0,8,0,2" Text="Manual name" />
                                                <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource DeviceDetailValue}" Margin="0,8,0,0" Text="{Binding WifiAnalyzer.SelectedDeviceInventoryItem.ManualNameDisplay}" />

                                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource DeviceDetailLabel}" Margin="0,8,0,2" Text="MAC address" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DeviceDetailValue}" Margin="0,8,0,0" Text="{Binding WifiAnalyzer.SelectedDeviceInventoryItem.MacDisplay}" FontFamily="Consolas" />
                                                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource DeviceDetailLabel}" Margin="0,8,0,2" Text="Vendor" />
                                                <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource DeviceDetailValue}" Margin="0,8,0,0" Text="{Binding WifiAnalyzer.SelectedDeviceInventoryItem.VendorDisplay}" />

                                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource DeviceDetailLabel}" Margin="0,8,0,2" Text="Device type" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource DeviceDetailValue}" Margin="0,8,0,0" Text="{Binding WifiAnalyzer.SelectedDeviceInventoryItem.DeviceType}" />
                                                <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource DeviceDetailLabel}" Margin="0,8,0,2" Text="Confidence" />
                                                <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource DeviceDetailValue}" Margin="0,8,0,0" Text="{Binding WifiAnalyzer.SelectedDeviceInventoryItem.Confidence}" />

                                                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource DeviceDetailLabel}" Margin="0,8,0,2" Text="Auto type" />
                                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource DeviceDetailValue}" Margin="0,8,0,0" Text="{Binding WifiAnalyzer.SelectedDeviceInventoryItem.AutoDeviceTypeDisplay}" />
                                                <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource DeviceDetailLabel}" Margin="0,8,0,2" Text="Manual type" />
                                                <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource DeviceDetailValue}" Margin="0,8,0,0" Text="{Binding WifiAnalyzer.SelectedDeviceInventoryItem.ManualDeviceTypeDisplay}" />

                                                <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource DeviceDetailLabel}" Margin="0,8,0,2" Text="Type source" />
                                                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource DeviceDetailValue}" Margin="0,8,0,0" Text="{Binding WifiAnalyzer.SelectedDeviceInventoryItem.DeviceTypeSourceDisplay}" />
                                                <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource DeviceDetailLabel}" Margin="0,8,0,2" Text="Seen count" />
                                                <TextBlock Grid.Row="5" Grid.Column="3" Style="{StaticResource DeviceDetailValue}" Margin="0,8,0,0" Text="{Binding WifiAnalyzer.SelectedDeviceInventoryItem.SeenCountDisplay}" />

                                                <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource DeviceDetailLabel}" Margin="0,8,0,2" Text="First seen" />
                                                <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource DeviceDetailValue}" Margin="0,8,0,0" Text="{Binding WifiAnalyzer.SelectedDeviceInventoryItem.FirstSeenDisplay}" />
                                                <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource DeviceDetailLabel}" Margin="0,8,0,2" Text="Last seen" />
                                                <TextBlock Grid.Row="6" Grid.Column="3" Style="{StaticResource DeviceDetailValue}" Margin="0,8,0,0" Text="{Binding WifiAnalyzer.SelectedDeviceInventoryItem.LastSeenDisplay}" />

                                                <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource DeviceDetailLabel}" Margin="0,8,0,2" Text="Local scan" />
                                                <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource DeviceDetailValue}" Margin="0,8,0,0" Text="{Binding WifiAnalyzer.SelectedDeviceInventoryItem.LocalDetectedDisplay}" />
                                                <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource DeviceDetailLabel}" Margin="0,8,0,2" Text="Router/AP data" />
                                                <TextBlock Grid.Row="7" Grid.Column="3" Style="{StaticResource DeviceDetailValue}" Margin="0,8,0,0" Text="{Binding WifiAnalyzer.SelectedDeviceInventoryItem.RouterReportedDisplay}" />

                                                <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource DeviceDetailLabel}" Margin="0,8,0,2" Text="Role" />
                                                <TextBlock Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource DeviceDetailValue}" Margin="0,8,0,0" Text="{Binding WifiAnalyzer.SelectedDeviceInventoryItem.RoleDisplay}" />

                                                <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource DeviceDetailLabel}" Margin="0,8,0,2" Text="Sources" />
                                                <TextBlock Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource DeviceDetailValue}" Margin="0,8,0,0" Text="{Binding WifiAnalyzer.SelectedDeviceInventoryItem.SourceDisplay}" />

                                                <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource DeviceDetailLabel}" Margin="0,8,0,2" Text="Evidence" />
                                                <TextBlock Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource DeviceDetailValue}" Margin="0,8,0,0" Text="{Binding WifiAnalyzer.SelectedDeviceInventoryItem.EvidenceDisplay}" />

                                                <TextBlock Grid.Row="11" Grid.Column="0" Style="{StaticResource DeviceDetailLabel}" Margin="0,8,0,2" Text="Wireless evidence" />
                                                <TextBlock Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource DeviceDetailValue}" Margin="0,8,0,0" Text="{Binding WifiAnalyzer.SelectedDeviceInventoryItem.WirelessEvidenceDisplay}" />
                                            </Grid>
                                        </Border>
                                        <WrapPanel Margin="0,8,0,0">
                                            <TextBox Text="{Binding WifiAnalyzer.ManualDeviceName, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="260" Height="36" Padding="10,7" BorderBrush="#BFCFE5"
                                                     Margin="0,0,10,8"
                                                     ToolTip="Friendly name saved by MAC address when available, otherwise by IP address." />
                                            <Button Style="{StaticResource WifiRescanButton}" Content="Save Name"
                                                    MinWidth="104" Margin="0,0,10,8"
                                                    Command="{Binding WifiAnalyzer.SaveDeviceFriendlyNameCommand}"
                                                    ToolTip="Save this friendly name for the selected device." />
                                            <Button Style="{StaticResource DangerButton}" Content="Clear Name"
                                                    MinWidth="96" Margin="0,0,0,8"
                                                    Command="{Binding WifiAnalyzer.ClearDeviceFriendlyNameCommand}"
                                                    ToolTip="Remove the saved friendly name for the selected device." />
                                            <ComboBox ItemsSource="{Binding WifiAnalyzer.ManualDeviceTypeOptions}"
                                                      SelectedItem="{Binding WifiAnalyzer.ManualDeviceType, Mode=TwoWay}"
                                                      Width="180" Height="36" Padding="8,6"
                                                      Margin="14,0,10,8"
                                                      ToolTip="Optional manual device type override for the selected device." />
                                            <Button Style="{StaticResource WifiExportButton}" Content="Save Type"
                                                    MinWidth="100" Margin="0,0,10,8"
                                                    Command="{Binding WifiAnalyzer.SaveDeviceTypeCommand}"
                                                    ToolTip="Save this device type override for the selected device." />
                                            <Button Style="{StaticResource DangerButton}" Content="Clear Type"
                                                    MinWidth="96" Margin="0,0,0,8"
                                                    Command="{Binding WifiAnalyzer.ClearDeviceTypeCommand}"
                                                    ToolTip="Return this device to automatic type detection." />
                                        </WrapPanel>
                                    </StackPanel>

                                    <Border Height="1" Background="#D8E4F2" Margin="8,10,8,14" />
                                    <TextBlock Text="Local discovery evidence" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" />

                                    <DataGrid Margin="0,12,0,0" ItemsSource="{Binding WifiAnalyzer.LanDevices}"
                                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                              ScrollViewer.VerticalScrollBarVisibility="Visible"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              Height="300" MinHeight="220" MaxHeight="300"
                                              EnableRowVirtualization="True"
                                              RowHeight="42" ColumnHeaderHeight="38">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="IP address" Binding="{Binding IpAddress}" Width="110" MinWidth="96" />
                                            <DataGridTextColumn Header="Device name" Binding="{Binding HostDisplay}" Width="2*" MinWidth="150">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                        <Setter Property="ToolTip" Value="{Binding NameSourceDisplay}" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="MAC" Binding="{Binding MacDisplay}" Width="1.3*" MinWidth="132" FontFamily="Consolas">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                        <Setter Property="ToolTip" Value="{Binding MacDisplay}" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Vendor" Binding="{Binding VendorDisplay}" Width="1.2*" MinWidth="108">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                        <Setter Property="ToolTip" Value="{Binding VendorDisplay}" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Role" Binding="{Binding RoleLabel}" Width="1.5*" MinWidth="132">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                        <Setter Property="ToolTip" Value="{Binding RoleSourceDisplay}" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Border Height="1" Background="#D8E4F2" Margin="0,18,0,14" />
                                    <StackPanel>
                                        <TextBlock Text="Router/AP reported clients" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" />
                                        <TextBlock FontSize="12" Foreground="#475569" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Text="Optional read-only SNMP query against the gateway/AP. Standard ipNetToMedia is ARP/IP evidence, not guaranteed Wi-Fi association; true wireless client data requires AP/controller association support." />
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,8">
                                                <TextBlock Style="{StaticResource LabelText}" Text="SNMP protocol" />
                                                <ComboBox ItemsSource="{Binding WifiAnalyzer.RouterSnmpProtocols}"
                                                          SelectedItem="{Binding WifiAnalyzer.RouterSelectedSnmpProtocol}"
                                                          Height="36" Padding="8,5" BorderBrush="#BFCFE5" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,10,8"
                                                        Visibility="{Binding WifiAnalyzer.IsRouterSnmpV2Selected, Converter={StaticResource BoolVisibility}}">
                                                <TextBlock Style="{StaticResource LabelText}" Text="SNMP v2c community" />
                                                <TextBox Text="{Binding WifiAnalyzer.RouterSnmpCommunity, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="36" Padding="10,7" BorderBrush="#BFCFE5"
                                                         ToolTip="SNMP v2c read-only community for the router/AP. Default is public." />
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource WifiExportButton}"
                                                    Content="Read Router/AP"
                                                    MinWidth="132"
                                                    VerticalAlignment="Bottom"
                                                    Margin="0,0,0,8"
                                                    Command="{Binding WifiAnalyzer.ReadRouterClientsCommand}"
                                                    ToolTip="Read the gateway/AP SNMP ipNetToMedia table. Private gateway only; no public IP access." />
                                        </Grid>

                                        <Grid Visibility="{Binding WifiAnalyzer.IsRouterSnmpV3Selected, Converter={StaticResource BoolVisibility}}" Margin="0,4,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Style="{StaticResource LabelText}" Text="SNMPv3 username" />
                                                <TextBox Text="{Binding WifiAnalyzer.RouterSnmpV3UserName, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,7" BorderBrush="#BFCFE5" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                <TextBlock Style="{StaticResource LabelText}" Text="Auth" />
                                                <ComboBox ItemsSource="{Binding WifiAnalyzer.RouterSnmpAuthProtocols}" SelectedItem="{Binding WifiAnalyzer.RouterSnmpV3AuthProtocol}" Height="36" Padding="8,5" BorderBrush="#BFCFE5" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                                <TextBlock Style="{StaticResource LabelText}" Text="Auth password" />
                                                <PasswordBox x:Name="WifiRouterSnmpAuthPasswordBox" PasswordChanged="WifiRouterSnmpAuthPasswordChanged" Height="36" Padding="10,7" BorderBrush="#BFCFE5" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Margin="0,0,10,0">
                                                <TextBlock Style="{StaticResource LabelText}" Text="Privacy" />
                                                <ComboBox ItemsSource="{Binding WifiAnalyzer.RouterSnmpPrivacyProtocols}" SelectedItem="{Binding WifiAnalyzer.RouterSnmpV3PrivacyProtocol}" Height="36" Padding="8,5" BorderBrush="#BFCFE5" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Style="{StaticResource LabelText}" Text="Privacy password" />
                                                <PasswordBox x:Name="WifiRouterSnmpPrivacyPasswordBox" PasswordChanged="WifiRouterSnmpPrivacyPasswordChanged" Height="36" Padding="10,7" BorderBrush="#BFCFE5" />
                                            </StackPanel>
                                        </Grid>

                                        <WrapPanel Margin="0,0,0,8" Visibility="{Binding WifiAnalyzer.IsRouterSnmpV3Selected, Converter={StaticResource BoolVisibility}}">
                                            <CheckBox Content="Save SNMP credentials securely for this Windows user"
                                                      IsChecked="{Binding WifiAnalyzer.SaveRouterSnmpCredentials}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,16,0" />
                                            <TextBlock Text="{Binding WifiAnalyzer.HasSavedRouterSnmpCredentials, StringFormat=Saved credential available: {0}}"
                                                       Foreground="#475569"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,16,0" />
                                            <Button Style="{StaticResource DangerButton}"
                                                    Content="Forget Saved SNMP Credentials"
                                                    Command="{Binding WifiAnalyzer.ForgetRouterSnmpCredentialCommand}"
                                                    Click="ClearWifiRouterSnmpPasswordBoxesClick"
                                                    ToolTip="Remove encrypted SNMP credentials stored for this Windows user." />
                                        </WrapPanel>

                                        <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="#64748B"
                                                   Text="{Binding WifiAnalyzer.RouterClientStatus}" TextWrapping="Wrap" />

                                        <DataGrid Margin="0,10,0,0" ItemsSource="{Binding WifiAnalyzer.RouterClients}"
                                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                                  ScrollViewer.VerticalScrollBarVisibility="Visible"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                  Height="220" MinHeight="160" MaxHeight="220"
                                                  EnableRowVirtualization="True"
                                                  RowHeight="40" ColumnHeaderHeight="36">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="IP address" Binding="{Binding IpAddress}" Width="110" MinWidth="96" />
                                                <DataGridTextColumn Header="Device name" Binding="{Binding HostDisplay}" Width="2*" MinWidth="150">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                            <Setter Property="ToolTip" Value="{Binding SourceDisplay}" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="MAC" Binding="{Binding MacDisplay}" Width="1.3*" MinWidth="132" FontFamily="Consolas" />
                                                <DataGridTextColumn Header="Vendor" Binding="{Binding VendorDisplay}" Width="1.2*" MinWidth="108" />
                                                <DataGridTextColumn Header="Wi-Fi proof" Binding="{Binding WirelessAssociationDisplay}" Width="1.5*" MinWidth="150" />
                                                <DataGridTextColumn Header="Match" Binding="{Binding LocalMatchLabel}" Width="1.2*" MinWidth="120" />
                                                <DataGridTextColumn Header="ifIndex" Binding="{Binding InterfaceIndex}" Width="72" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- ==================================
                                 § 9. Recommendations
                                 ================================== -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Health &amp; Recommendations" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" />

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Big score badge -->
                                        <Border Grid.Column="0" CornerRadius="12" Padding="22,16" Margin="0,0,20,0"
                                                Background="{Binding WifiAnalyzer.LinkScoreColor}" VerticalAlignment="Top">
                                            <StackPanel>
                                                <TextBlock HorizontalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="34"
                                                           Text="{Binding WifiAnalyzer.Health.Score, FallbackValue=—, TargetNullValue=—}" />
                                                <TextBlock HorizontalAlignment="Center" Foreground="White" FontSize="11" Opacity="0.85" Text="/ 100" />
                                                <TextBlock HorizontalAlignment="Center" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                                           Margin="0,4,0,0" Text="{Binding WifiAnalyzer.Health.Verdict}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Score breakdown — why the score is what it is -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Score breakdown" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8" />

                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Signal" FontSize="12" Foreground="#475569" VerticalAlignment="Center" />
                                                <ProgressBar Grid.Column="1" Height="10" Minimum="0" Maximum="40"
                                                             Value="{Binding WifiAnalyzer.Health.SignalContribution, Mode=OneWay}"
                                                             Background="#EEF2F7" Foreground="#0EA5E9" BorderThickness="0"
                                                             Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="#334155">
                                                    <Run Text="{Binding WifiAnalyzer.Health.SignalContribution, Mode=OneWay}" /><Run Text=" / 40" />
                                                </TextBlock>
                                            </Grid>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Congestion" FontSize="12" Foreground="#475569" VerticalAlignment="Center" />
                                                <ProgressBar Grid.Column="1" Height="10" Minimum="0" Maximum="30"
                                                             Value="{Binding WifiAnalyzer.Health.CongestionContribution, Mode=OneWay}"
                                                             Background="#EEF2F7" Foreground="#10B981" BorderThickness="0"
                                                             Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="#334155">
                                                    <Run Text="{Binding WifiAnalyzer.Health.CongestionContribution, Mode=OneWay}" /><Run Text=" / 30" />
                                                </TextBlock>
                                            </Grid>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Security" FontSize="12" Foreground="#475569" VerticalAlignment="Center" />
                                                <ProgressBar Grid.Column="1" Height="10" Minimum="0" Maximum="15"
                                                             Value="{Binding WifiAnalyzer.Health.SecurityContribution, Mode=OneWay}"
                                                             Background="#EEF2F7" Foreground="#F59E0B" BorderThickness="0"
                                                             Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="#334155">
                                                    <Run Text="{Binding WifiAnalyzer.Health.SecurityContribution, Mode=OneWay}" /><Run Text=" / 15" />
                                                </TextBlock>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Wi-Fi gen" FontSize="12" Foreground="#475569" VerticalAlignment="Center" />
                                                <ProgressBar Grid.Column="1" Height="10" Minimum="0" Maximum="15"
                                                             Value="{Binding WifiAnalyzer.Health.PhyContribution, Mode=OneWay}"
                                                             Background="#EEF2F7" Foreground="#7C3AED" BorderThickness="0"
                                                             Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="#334155">
                                                    <Run Text="{Binding WifiAnalyzer.Health.PhyContribution, Mode=OneWay}" /><Run Text=" / 15" />
                                                </TextBlock>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="#E2E8F0" Margin="0,16,0,14" />

                                    <!-- Healthy empty-state -->
                                    <Border Background="#ECFDF5" CornerRadius="8" Padding="14,12"
                                            Visibility="{Binding WifiAnalyzer.NoRecommendations, Converter={StaticResource BoolVisibility}}">
                                        <TextBlock Foreground="#047857" FontSize="13" FontWeight="SemiBold"
                                                   Text="No issues detected - your Wi-Fi connection is healthy." />
                                    </Border>

                                    <!-- Actionable recommendation cards (engine output carries a stable category prefix) -->
                                    <ItemsControl ItemsSource="{Binding WifiAnalyzer.Health.Recommendations}"
                                                  Visibility="{Binding WifiAnalyzer.HasRecommendations, Converter={StaticResource BoolVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Converter={StaticResource WifiRecAccent}, ConverterParameter=bg}"
                                                        CornerRadius="8" Padding="14,11" Margin="0,0,0,8">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#94A3B8" Direction="270" ShadowDepth="1" BlurRadius="4" Opacity="0.12" />
                                                    </Border.Effect>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="4" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{Binding Converter={StaticResource WifiRecAccent}}" CornerRadius="2" Margin="0,0,12,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap"
                                                                   Foreground="#334155" FontSize="13" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Height="1" Background="#E2E8F0" Margin="0,10,0,14" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Wi-Fi Security Audit" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" />
                                            <TextBlock Text="{Binding WifiAnalyzer.SecurityAuditSummary}" FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding WifiAnalyzer.SecurityAudit.GeneratedAt, StringFormat={}{0:HH:mm:ss}}"
                                                   FontSize="12" Foreground="#64748B" VerticalAlignment="Top" />
                                    </Grid>

                                    <DataGrid Margin="0,10,0,0"
                                              ItemsSource="{Binding WifiAnalyzer.SecurityAudit.Findings}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              ScrollViewer.VerticalScrollBarVisibility="Visible"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              Height="220"
                                              MinHeight="160"
                                              MaxHeight="220"
                                              RowHeight="44"
                                              ColumnHeaderHeight="36"
                                              EnableRowVirtualization="True">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Severity" Width="92" MinWidth="86">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left"
                                                                Background="{Binding SeverityDisplay, Converter={StaticResource StatusBrush}}">
                                                            <TextBlock Text="{Binding SeverityDisplay}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="130" MinWidth="110" />
                                            <DataGridTextColumn Header="Finding" Binding="{Binding Finding}" Width="1.6*" MinWidth="190" />
                                            <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="1.8*" MinWidth="220" />
                                            <DataGridTextColumn Header="Recommended action" Binding="{Binding Recommendation}" Width="2*" MinWidth="260" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- ==================================
                                 § 4a. Channel Graph — inSSIDer-style spectrum view
                                 ================================== -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Channel Graph" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" />
                                        <TextBlock Grid.Column="1" FontSize="12" Foreground="#475569" VerticalAlignment="Center"
                                                   Text="Each network = a coloured hump (channel x signal). Your AP is bold and drawn on top." />
                                    </Grid>

                                    <TextBlock Text="2.4 GHz" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,12,0,4" />
                                    <controls:WifiChannelGraph Height="220"
                                                               Band="TwoPointFourGhz"
                                                               AccessPoints="{Binding WifiAnalyzer.VisibleAccessPoints}" />

                                    <TextBlock Text="5 GHz" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,16,0,4" />
                                    <controls:WifiChannelGraph Height="220"
                                                               Band="FiveGhz"
                                                               AccessPoints="{Binding WifiAnalyzer.VisibleAccessPoints}" />

                                    <TextBlock Text="6 GHz" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,16,0,4" />
                                    <controls:WifiChannelGraph Height="220"
                                                               Band="SixGhz"
                                                               AccessPoints="{Binding WifiAnalyzer.VisibleAccessPoints}" />
                                </StackPanel>
                            </Border>

                            <!-- ==================================
                                 § 4c. Signal over time — multi-network trend (2nd inSSIDer view)
                                 ================================== -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Signal Over Time" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" />
                                        <TextBlock Grid.Column="1" FontSize="12" Foreground="#475569" VerticalAlignment="Center"
                                                   Text="Top 8 networks across scans. Downward trend = weaker AP signal or rising interference." />
                                    </Grid>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>

                                        <controls:WifiSignalTimeGraph Grid.Column="0" Height="260"
                                                                      Trends="{Binding WifiAnalyzer.SignalTrends}" />

                                        <!-- Interactive legend: check/uncheck to show/hide each network -->
                                        <Border Grid.Column="1" Margin="14,0,0,0" Background="#F8FAFC"
                                                CornerRadius="8" Padding="10,8">
                                            <StackPanel>
                                                <TextBlock Text="Networks" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="#64748B" Margin="0,0,0,6" />
                                                <ScrollViewer Height="224"
                                                              VerticalScrollBarVisibility="Visible"
                                                              HorizontalScrollBarVisibility="Disabled">
                                                    <ItemsControl ItemsSource="{Binding WifiAnalyzer.SignalTrends}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,3,0,3">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                                                              IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                                              ToolTip="{Binding Bssid}" />
                                                                    <Border Grid.Column="1" Width="11" Height="11" CornerRadius="2"
                                                                            Margin="6,0,6,0" VerticalAlignment="Center"
                                                                            Background="{Binding ColorHex}" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding DisplaySsid}"
                                                                               VerticalAlignment="Center" FontSize="11"
                                                                               Foreground="#0F172A" TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding DisplaySsid}" />
                                                                    <TextBlock Grid.Column="3" Text="{Binding LatestRssiText}"
                                                                               VerticalAlignment="Center" FontSize="11"
                                                                               FontWeight="SemiBold" Foreground="#475569"
                                                                               Margin="6,0,0,0" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ==================================
                                 § 4b. Channel Map (numeric congestion table)
                                 ================================== -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Channel Congestion" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" />
                                    <TextBlock Foreground="#475569" FontSize="12" Margin="0,2,0,10"
                                               Text="One row per detected channel. YOU marks your current channel; DFS marks 5 GHz radar-avoidance channels 52-144." />

                                    <Border CornerRadius="8" Padding="14,12" Margin="0,0,0,12"
                                            Background="#F8FAFC"
                                            BorderBrush="{Binding WifiAnalyzer.ChannelRecommendation.SeverityDisplay, Converter={StaticResource StatusBrush}}"
                                            BorderThickness="4,1,1,1"
                                            Visibility="{Binding WifiAnalyzer.HasChannelRecommendation, Converter={StaticResource BoolVisibility}}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Channel recommendation" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                                    <TextBlock Text="{Binding WifiAnalyzer.ChannelRecommendation.GeneratedText}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Border Grid.Column="1" CornerRadius="10" Padding="9,3" VerticalAlignment="Top"
                                                        Background="{Binding WifiAnalyzer.ChannelRecommendation.SeverityDisplay, Converter={StaticResource StatusBrush}}">
                                                    <TextBlock Text="{Binding WifiAnalyzer.ChannelRecommendation.SeverityDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                                </Border>
                                            </Grid>

                                            <Grid Margin="0,12,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="132" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Current" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,12,6" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding WifiAnalyzer.ChannelRecommendation.Current}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap" Margin="0,0,0,6" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Recommended" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,12,6" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding WifiAnalyzer.ChannelRecommendation.Recommended}" FontSize="13" FontWeight="SemiBold" Foreground="#0369A1" TextWrapping="Wrap" Margin="0,0,0,6" />

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Reason" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,12,6" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WifiAnalyzer.ChannelRecommendation.Reason}" FontSize="12" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,6" />

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Detail" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,12,0" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WifiAnalyzer.ChannelRecommendation.Detail}" FontSize="12" Foreground="#475569" TextWrapping="Wrap" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <ScrollViewer MaxHeight="360"
                                                  VerticalScrollBarVisibility="Visible"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding WifiAnalyzer.ChannelMap}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,3,0,3" Padding="10,7" CornerRadius="6" Background="#F8FAFC">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="64" />
                                                                <ColumnDefinition Width="64" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="120" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"
                                                                       Text="{Binding BandLabel}" />
                                                            <TextBlock Grid.Column="1" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"
                                                                       Text="{Binding ChannelLabel}" />
                                                            <ProgressBar Grid.Column="2" Height="20"
                                                                         Minimum="0"
                                                                         Maximum="{Binding CongestionMeterMax, Mode=OneWay}"
                                                                         Value="{Binding CongestionMeterValue, Mode=OneWay}"
                                                                         Background="#EEF2F7"
                                                                         Foreground="{Binding CongestionColor}"
                                                                         BorderThickness="0"
                                                                         Margin="0,0,10,0"
                                                                         VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="3" FontSize="13" FontWeight="SemiBold" Foreground="#334155"
                                                                       VerticalAlignment="Center" Margin="0,0,10,0"
                                                                       Text="{Binding ApCountText}" />
                                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Border CornerRadius="4" Padding="7,2" Background="{Binding CongestionColor}">
                                                                    <TextBlock Text="{Binding CongestionLabel}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                                                </Border>
                                                                <TextBlock Text="DFS" FontSize="10" Foreground="#B45309" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                           Visibility="{Binding IsDfsChannel, Converter={StaticResource BoolVisibility}}" />
                                                                <Border CornerRadius="4" Padding="6,2" Background="#10B981" Margin="6,0,0,0"
                                                                        Visibility="{Binding IsCurrentConnectionChannel, Converter={StaticResource BoolVisibility}}">
                                                                    <TextBlock Text="YOU" FontSize="10" Foreground="White" FontWeight="Bold" />
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <Border CornerRadius="8" Padding="14,12" Margin="0,14,0,0"
                                            Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"
                                            Visibility="{Binding WifiAnalyzer.HasChannelHistory, Converter={StaticResource BoolVisibility}}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Channel before-after" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" />
                                                    <TextBlock Text="{Binding WifiAnalyzer.ChannelHistorySummary}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Border Grid.Column="1" CornerRadius="10" Padding="9,3" VerticalAlignment="Top"
                                                        Background="{Binding WifiAnalyzer.ChannelBeforeAfterSummary.SeverityDisplay, Converter={StaticResource StatusBrush}}"
                                                        Visibility="{Binding WifiAnalyzer.HasChannelBeforeAfterSummary, Converter={StaticResource BoolVisibility}}">
                                                    <TextBlock Text="{Binding WifiAnalyzer.ChannelBeforeAfterSummary.SeverityDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                                </Border>
                                            </Grid>

                                            <Border CornerRadius="6" Padding="10,8" Margin="0,10,0,12"
                                                    Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                                                    Visibility="{Binding WifiAnalyzer.HasChannelBeforeAfterSummary, Converter={StaticResource BoolVisibility}}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="96" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                                               Text="{Binding WifiAnalyzer.ChannelBeforeAfterSummary.Title}"
                                                               FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,6" />

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Before" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,10,5" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding WifiAnalyzer.ChannelBeforeAfterSummary.Before}" FontSize="12" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,5" />

                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="After" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,10,5" />
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WifiAnalyzer.ChannelBeforeAfterSummary.After}" FontSize="12" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,5" />

                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Delta" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,10,5" />
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WifiAnalyzer.ChannelBeforeAfterSummary.Delta}" FontSize="12" FontWeight="SemiBold" Foreground="#0369A1" TextWrapping="Wrap" Margin="0,0,0,5" />

                                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Detail" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,10,0" />
                                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding WifiAnalyzer.ChannelBeforeAfterSummary.Detail}" FontSize="12" Foreground="#475569" TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>

                                            <DataGrid ItemsSource="{Binding WifiAnalyzer.ChannelHistory}"
                                                      AutoGenerateColumns="False"
                                                      CanUserAddRows="False"
                                                      CanUserDeleteRows="False"
                                                      IsReadOnly="True"
                                                      MaxHeight="220"
                                                      RowHeight="38"
                                                      ColumnHeaderHeight="34"
                                                      EnableRowVirtualization="True"
                                                      ScrollViewer.VerticalScrollBarVisibility="Visible"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Time" Binding="{Binding TimeDisplay}" Width="72" MinWidth="68" />
                                                    <DataGridTextColumn Header="Network" Binding="{Binding NetworkDisplay}" Width="150" MinWidth="130" />
                                                    <DataGridTextColumn Header="Channel" Binding="{Binding ChannelDisplay}" Width="100" MinWidth="92" />
                                                    <DataGridTextColumn Header="RSSI" Binding="{Binding RssiDisplay}" Width="82" MinWidth="76" />
                                                    <DataGridTextColumn Header="Link" Binding="{Binding LinkScoreDisplay}" Width="82" MinWidth="76" />
                                                    <DataGridTextColumn Header="Load" Binding="{Binding LoadDisplay}" Width="132" MinWidth="112" />
                                                    <DataGridTextColumn Header="DFS" Binding="{Binding DfsDisplay}" Width="82" MinWidth="72" />
                                                    <DataGridTemplateColumn Header="Advice" Width="2*" MinWidth="220">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0" CornerRadius="8" Padding="7,2" VerticalAlignment="Center" Margin="0,0,8,0"
                                                                            Background="{Binding RecommendationSeverityDisplay, Converter={StaticResource StatusBrush}}">
                                                                        <TextBlock Text="{Binding RecommendationSeverityDisplay}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                                                    </Border>
                                                                    <TextBlock Grid.Column="1" Text="{Binding RecommendationDisplay}" FontSize="12" Foreground="#334155"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding RecommendationDisplay}"
                                                                               VerticalAlignment="Center" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- ==================================
                                 § 3. Visible networks DataGrid
                                 ================================== -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Visible Networks" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" />
                                            <TextBlock Grid.Column="1" FontSize="12" Foreground="#475569" VerticalAlignment="Center"
                                                       Text="{Binding WifiAnalyzer.LastScanText, Mode=OneWay, StringFormat=Last scan: {0}}" />
                                        </Grid>

                                        <!-- Search / filter row: narrows the grid only; the channel graphs
                                             and the exported report keep using the full unfiltered list. -->
                                        <Grid Grid.Row="1" Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="360" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <TextBox Text="{Binding WifiAnalyzer.NetworkFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Padding="34,7,30,7" FontSize="13" />
                                                <Grid Width="13" Height="13" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                                                    <Ellipse Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                             Stroke="#94A3B8" StrokeThickness="1.6" />
                                                    <Line X1="7.5" Y1="7.5" X2="12.5" Y2="12.5" Stroke="#94A3B8" StrokeThickness="1.6" StrokeStartLineCap="Round" />
                                                </Grid>
                                                <TextBlock Text="Search SSID, BSSID, vendor, band or channel..." Foreground="#94A3B8" FontSize="13"
                                                           Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                           Visibility="{Binding WifiAnalyzer.NoNetworkFilter, Converter={StaticResource BoolVisibility}}" />
                                                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                                                        Width="22" Height="22" Cursor="Hand" ToolTip="Clear search"
                                                        Command="{Binding WifiAnalyzer.ClearNetworkFilterCommand}"
                                                        Visibility="{Binding WifiAnalyzer.HasNetworkFilter, Converter={StaticResource BoolVisibility}}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="11">
                                                                <Path x:Name="X" Width="9" Height="9" Stretch="Uniform"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      Stroke="#94A3B8" StrokeThickness="1.7"
                                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                      Data="M0,0 L9,9 M9,0 L0,9" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#EEF2F7" />
                                                                    <Setter TargetName="X" Property="Stroke" Value="#475569" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0"
                                                       FontSize="12" Foreground="#475569"
                                                       Text="{Binding WifiAnalyzer.NetworkFilterSummary}" />
                                        </Grid>
                                    </Grid>
                                    <DataGrid ItemsSource="{Binding WifiAnalyzer.FilteredAccessPoints}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              EnableRowVirtualization="True"
                                              EnableColumnVirtualization="True"
                                              ScrollViewer.VerticalScrollBarVisibility="Visible"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              RowHeight="42"
                                              MinHeight="160" MaxHeight="440"
                                              Margin="0,12,0,0">
                                        <DataGrid.Columns>
                                            <!-- SSID + a visual signal bar coloured by strength. -->
                                            <DataGridTemplateColumn Header="Network" Width="2*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Center" Margin="4,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding DisplaySsid}" FontWeight="SemiBold" Foreground="#0F172A" FontSize="13"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <Border CornerRadius="4" Padding="5,1" Background="#10B981" Margin="8,0,0,0"
                                                                        Visibility="{Binding IsCurrentConnection, Converter={StaticResource BoolVisibility}}">
                                                                    <TextBlock Text="CURRENT" FontSize="9" FontWeight="Bold" Foreground="White" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Bssid}" Foreground="#94A3B8" FontSize="11" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="Signal" Width="150">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                                            <TextBlock Text="{Binding SignalText}"
                                                                       Foreground="{Binding SignalColor}" FontWeight="Bold" FontSize="13"
                                                                       Width="62" />
                                                            <Border Width="74" Height="8" Background="#EEF2F7" CornerRadius="4" VerticalAlignment="Center">
                                                                <Border HorizontalAlignment="Left" CornerRadius="4"
                                                                        Background="{Binding SignalColor}"
                                                                        Width="{Binding SignalBarWidth}" MinWidth="3" />
                                                            </Border>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTextColumn Header="Avg" Binding="{Binding AverageRssiText}" Width="88">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Setter Property="Foreground" Value="#475569" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Seen" Binding="{Binding DetectionPercentText}" Width="82">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Setter Property="Foreground" Value="#475569" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Channel" Binding="{Binding ChannelLabel}" Width="76">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="Foreground" Value="#0F172A" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Width" Binding="{Binding ChannelWidthLabel}" Width="80">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Setter Property="Foreground" Value="#475569" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Band" Binding="{Binding BandLabel}" Width="80">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Setter Property="Foreground" Value="#475569" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Standard" Binding="{Binding PhyFriendlyName}" Width="130">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Setter Property="Foreground" Value="#475569" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTemplateColumn Header="Security" Width="110">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="4" Padding="8,3" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                                Background="{Binding Security.BadgeColor}">
                                                            <TextBlock Text="{Binding Security.Label}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Vendor" Binding="{Binding VendorDisplay}" Width="120">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Setter Property="Foreground" Value="#94A3B8" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- ==================================
                                 § 7. Adapter Capabilities — always-visible premium section
                                 ================================== -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Adapter Capabilities" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" />
                                    <TextBlock Foreground="#475569" FontSize="12" Margin="0,2,0,14"
                                               Text="What this Wi-Fi adapter physically supports — bands, 802.11 generations and radio technologies." />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource LabelText}" Text="Adapter" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding WifiAnalyzer.Capabilities.Description}" TextWrapping="Wrap" />

                                            <TextBlock Style="{StaticResource LabelText}" Text="Permanent MAC" Margin="0,10,0,3" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding WifiAnalyzer.Capabilities.PermanentMacAddress, FallbackValue=—, TargetNullValue=—}" />

                                            <TextBlock Style="{StaticResource LabelText}" Text="Driver" Margin="0,10,0,3" />
                                            <TextBlock Style="{StaticResource ValueText}">
                                                <Run Text="{Binding WifiAnalyzer.Capabilities.DriverName, FallbackValue=—, TargetNullValue=—}" />
                                                <Run Text=" · " Foreground="#94A3B8" />
                                                <Run Text="{Binding WifiAnalyzer.Capabilities.DriverVersion, FallbackValue=—, TargetNullValue=—}" Foreground="#475569" FontSize="12" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource LabelText}" Text="Wi-Fi bands supported" />
                                            <ItemsControl ItemsSource="{Binding WifiAnalyzer.Capabilities.SupportedBandLabels}" Margin="0,3,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#DBEAFE" CornerRadius="4" Padding="9,4" Margin="0,4,5,0">
                                                            <TextBlock Text="{Binding}" FontSize="12" Foreground="#1D4ED8" FontWeight="SemiBold" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Style="{StaticResource LabelText}" Text="802.11 standards supported" Margin="0,12,0,3" />
                                            <ItemsControl ItemsSource="{Binding WifiAnalyzer.Capabilities.SupportedStandardLabels}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#D1FAE5" CornerRadius="4" Padding="9,4" Margin="0,4,5,0">
                                                            <TextBlock Text="{Binding}" FontSize="12" Foreground="#047857" FontWeight="SemiBold" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Style="{StaticResource LabelText}" Text="Technologies" Margin="0,12,0,3" />
                                            <ItemsControl ItemsSource="{Binding WifiAnalyzer.Capabilities.SupportedTechnologies}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#E0F2FE" CornerRadius="4" Padding="9,4" Margin="0,4,5,0">
                                                            <TextBlock Text="{Binding}" FontSize="12" Foreground="#0369A1" FontWeight="SemiBold" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ==================================
                                 § 10. Roaming history (collapsible)
                                 ================================== -->
                            <Expander Header="Roaming History" IsExpanded="False" Margin="0,0,0,12">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Foreground="#475569" FontSize="12" Margin="0,0,0,8"
                                               Text="Tracks BSSID changes within the same SSID, detected live at 1 Hz. Many flips per minute can indicate aggressive roaming or a flapping AP." />
                                    <Border CornerRadius="6" Padding="10,7" Margin="0,0,0,8" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1">
                                        <TextBlock Text="{Binding WifiAnalyzer.RoamingSummary}" FontSize="12" FontWeight="SemiBold" Foreground="#1E40AF" TextWrapping="Wrap" />
                                    </Border>
                                    <DataGrid ItemsSource="{Binding WifiAnalyzer.RoamingHistory}"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              MinHeight="80" MaxHeight="240">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="90" />
                                            <DataGridTextColumn Header="SSID" Binding="{Binding Ssid}" Width="*" />
                                            <DataGridTextColumn Header="From" Binding="{Binding FromBssid}" Width="140" />
                                            <DataGridTextColumn Header="To" Binding="{Binding ToBssid}" Width="140" />
                                            <DataGridTextColumn Header="Δ Signal" Binding="{Binding DeltaLabel}" Width="80" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Button Style="{StaticResource SecondaryButton}" Content="Clear History"
                                            Command="{Binding WifiAnalyzer.ClearRoamingHistoryCommand}"
                                            HorizontalAlignment="Left" Margin="0,8,0,0" />
                                </StackPanel>
                            </Expander>

                            <!-- ==================================
                                 § 11. Saved profiles (collapsible)
                                 ================================== -->
                            <Expander Header="Saved Wi-Fi Profiles" IsExpanded="False" Margin="0,0,0,12">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Foreground="#475569" FontSize="12" Margin="0,0,0,8"
                                               Text="Read-only list of Wi-Fi profiles saved on this PC (per WLAN service)." />
                                    <Border CornerRadius="6" Padding="10,7" Margin="0,0,0,8" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1">
                                        <TextBlock Text="{Binding WifiAnalyzer.SavedProfilesSummary}" FontSize="12" FontWeight="SemiBold" Foreground="#1E40AF" TextWrapping="Wrap" />
                                    </Border>
                                    <Border Background="#F8FAFC" CornerRadius="6" Padding="8"
                                            Visibility="{Binding WifiAnalyzer.NoSavedProfiles, Converter={StaticResource BoolVisibility}}">
                                        <TextBlock Text="{Binding WifiAnalyzer.SavedProfilesEmptyText}" Foreground="#64748B" FontSize="13" TextWrapping="Wrap" />
                                    </Border>
                                    <ScrollViewer MaxHeight="220"
                                                  VerticalScrollBarVisibility="Visible"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Visibility="{Binding WifiAnalyzer.HasSavedProfiles, Converter={StaticResource BoolVisibility}}">
                                        <ItemsControl ItemsSource="{Binding WifiAnalyzer.SavedProfiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#F2F7FD" CornerRadius="4" Padding="8,6" Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding DisplayName}" Foreground="#0F172A" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <Border CornerRadius="6" Padding="10,7" Margin="0,10,0,8" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"
                                            Visibility="{Binding WifiAnalyzer.HasSavedProfileHygieneItems, Converter={StaticResource BoolVisibility}}">
                                        <StackPanel>
                                            <TextBlock Text="Profile hygiene" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                            <TextBlock Text="{Binding WifiAnalyzer.SavedProfileHygieneSummary}" FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <DataGrid ItemsSource="{Binding WifiAnalyzer.SavedProfileHygiene.Items}"
                                              SelectedItem="{Binding WifiAnalyzer.SelectedSavedProfileHygieneItem, Mode=TwoWay}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              IsReadOnly="True"
                                              SelectionMode="Single"
                                              SelectionUnit="FullRow"
                                              MaxHeight="260"
                                              RowHeight="42"
                                              ColumnHeaderHeight="34"
                                              EnableRowVirtualization="True"
                                              ScrollViewer.VerticalScrollBarVisibility="Visible"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              Visibility="{Binding WifiAnalyzer.HasSavedProfileHygieneItems, Converter={StaticResource BoolVisibility}}">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Risk" Width="88" MinWidth="82">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left"
                                                                Background="{Binding SeverityDisplay, Converter={StaticResource StatusBrush}}">
                                                            <TextBlock Text="{Binding SeverityDisplay}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Profile" Binding="{Binding ProfileDisplay}" Width="150" MinWidth="130" />
                                            <DataGridTextColumn Header="State" Binding="{Binding StateDisplay}" Width="100" MinWidth="92" />
                                            <DataGridTextColumn Header="Observed security" Binding="{Binding SecurityDisplay}" Width="150" MinWidth="130" />
                                            <DataGridTextColumn Header="Evidence" Binding="{Binding EvidenceDisplay}" Width="1.5*" MinWidth="220" />
                                            <DataGridTextColumn Header="Recommended action" Binding="{Binding RecommendationDisplay}" Width="1.8*" MinWidth="260" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Border CornerRadius="6" Padding="10,8" Margin="0,10,0,0" Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1"
                                            Visibility="{Binding WifiAnalyzer.HasSavedProfileHygieneItems, Converter={StaticResource BoolVisibility}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding WifiAnalyzer.SelectedSavedProfileName, StringFormat=Selected: {0}}"
                                                       FontSize="12" FontWeight="SemiBold" Foreground="#9A3412" TextWrapping="Wrap" />
                                            <TextBlock Text="Active profile cannot be forgotten while connected."
                                                       FontSize="12" Foreground="#B45309" Margin="0,4,0,0"
                                                       Visibility="{Binding WifiAnalyzer.IsSelectedSavedProfileActive, Converter={StaticResource BoolVisibility}}" />
                                            <CheckBox Content="I confirm forgetting the selected Wi-Fi profile on this PC"
                                                      IsChecked="{Binding WifiAnalyzer.ConfirmForgetSavedProfile, Mode=TwoWay}"
                                                      Margin="0,8,0,8" />
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource DangerButton}"
                                                        Content="Forget Selected Profile"
                                                        Command="{Binding WifiAnalyzer.ForgetSelectedSavedProfileCommand}"
                                                        MinWidth="170"
                                                        ToolTip="Delete the selected saved Wi-Fi profile from Windows for this adapter." />
                                                <TextBlock Text="{Binding WifiAnalyzer.SavedProfileForgetStatus}"
                                                           FontSize="12" Foreground="#7C2D12" TextWrapping="Wrap"
                                                           Margin="12,8,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Expander>

                            <!-- Windows-native WLAN report shortcut for the Wi-Fi page. -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource SecondaryButton}" Content="Open WLAN Report"
                                            Click="OpenWlanReportClick"
                                            IsEnabled="{Binding Reports.HasWlanReport}"
                                            ToolTip="Open the last-generated WLAN report HTML in the default browser." />
                                    <TextBlock Text="{Binding Reports.WlanReportPathText}" Margin="12,9,0,0" Foreground="#334155" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Reports}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-10,0">
                        <StackPanel>
                            <Border Style="{StaticResource ModuleHeroBanner}" Background="{StaticResource HeroBgReports}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource ModuleHeroChip}" Background="{StaticResource AccentReports}">
                                        <TextBlock Style="{StaticResource ModuleHeroIcon}" Text="📄" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource ModuleHeroTitle}" Text="Report Center" />
                                        <TextBlock Style="{StaticResource ModuleHeroSubtitle}" Text="HTML, TXT and JSON exports for ticketing systems and evidence sharing with engineers." />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- ==================================
                                 § 1. Diagnosis status — the report is built from the latest
                                      Quick Diagnosis run. Severity-coloured, with an empty
                                      state when nothing has been diagnosed yet.
                                 ================================== -->
                            <Border Style="{StaticResource Card}"
                                    BorderBrush="{Binding Reports.VerdictSeverity, Converter={StaticResource StatusBrush}}"
                                    BorderThickness="5,1,1,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Reports.VerdictTitle}" FontSize="20" FontWeight="SemiBold"
                                                   Foreground="{Binding Reports.VerdictSeverity, Converter={StaticResource StatusBrush}}"
                                                   TextWrapping="Wrap" />
                                        <WrapPanel Margin="0,10,0,0"
                                                   Visibility="{Binding Reports.HasDiagnosis, Converter={StaticResource BoolVisibility}}">
                                            <Border CornerRadius="10" Padding="10,4" Margin="0,0,8,6"
                                                    Background="{Binding Reports.VerdictSeverity, Converter={StaticResource StatusBackgroundBrush}}">
                                                <TextBlock FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{Binding Reports.VerdictSeverity, Converter={StaticResource StatusBrush}}"
                                                           Text="{Binding Reports.VerdictSeverity, StringFormat=Severity: {0}}" />
                                            </Border>
                                            <Border CornerRadius="10" Padding="10,4" Margin="0,0,8,6" Background="#EEF2F7">
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475569"
                                                           Text="{Binding Reports.HealthScoreText, StringFormat=Health: {0}}" />
                                            </Border>
                                            <Border CornerRadius="10" Padding="10,4" Margin="0,0,8,6" Background="#EEF2F7">
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475569"
                                                           Text="{Binding Reports.VerdictConfidence, StringFormat=Confidence: {0}}" />
                                            </Border>
                                            <Border CornerRadius="10" Padding="10,4" Margin="0,0,0,6" Background="#E0F2FE">
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#0369A1"
                                                           Text="{Binding Reports.VerdictLayer, StringFormat=Where: {0}}" />
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Reports.DiagnosisRanAtText}" FontSize="12"
                                                   Foreground="#64748B" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="66" Height="66" CornerRadius="33" VerticalAlignment="Center" Margin="16,0,0,0"
                                            Background="{Binding Reports.VerdictSeverity, Converter={StaticResource StatusBackgroundBrush}}">
                                        <TextBlock Text="📄" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- ==================================
                                 § 2. Ticket summary — plain text, ready to paste / export.
                                 ================================== -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Ticket Summary" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Plain-text verdict, health score and recommended actions — ready to paste into a ticket."
                                               FontSize="12" Foreground="#64748B" Margin="0,2,0,10" TextWrapping="Wrap" />
                                    <TextBox Text="{Binding SummaryText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             MinHeight="240" MaxHeight="320" Padding="12"
                                             FontFamily="Consolas" FontSize="12" />
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button Style="{StaticResource PrimaryButtonReports}" Content="Export Reports"
                                                Command="{Binding GenerateReportCommand}"
                                                ToolTip="Generate the HTML + TXT + JSON report set in the Reports folder. Requires a diagnosis." />
                                        <Button Style="{StaticResource SecondaryButton}" Content="Copy Summary"
                                                Command="{Binding CopySummaryCommand}" Margin="10,0,0,0"
                                                ToolTip="Copy the verdict + score + recommendations to the clipboard." />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- ==================================
                                 § 3. Generated files — per-file rows with Open buttons that
                                      stay disabled until that file has been written.
                                 ================================== -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Generated Files" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Open Reports folder"
                                                Command="{Binding Reports.OpenReportsFolderCommand}"
                                                ToolTip="Browse every report exported across sessions." />
                                    </Grid>
                                    <TextBlock Text="HTML for sharing, TXT for pasting into tickets, JSON for engineers — all written together."
                                               FontSize="12" Foreground="#64748B" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Reports.LastExportSummary}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#16A34A" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding Reports.HasAnyReport, Converter={StaticResource BoolVisibility}}" />

                                    <!-- HTML row -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="54" Height="34" CornerRadius="6" Background="#DBEAFE" VerticalAlignment="Center">
                                                <TextBlock Text="HTML" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="Full diagnostic report" FontWeight="SemiBold" Foreground="#0F172A" FontSize="13" />
                                                <TextBlock Text="{Binding Reports.HtmlReportPathText}" FontSize="11" Foreground="#94A3B8"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Open"
                                                    Click="OpenReportClick" VerticalAlignment="Center"
                                                    IsEnabled="{Binding Reports.HasHtmlReport}"
                                                    ToolTip="Open the HTML report in the default browser." />
                                        </Grid>
                                    </Border>

                                    <!-- TXT row -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="54" Height="34" CornerRadius="6" Background="#E2E8F0" VerticalAlignment="Center">
                                                <TextBlock Text="TXT" FontSize="11" FontWeight="Bold" Foreground="#475569"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="Plain-text summary" FontWeight="SemiBold" Foreground="#0F172A" FontSize="13" />
                                                <TextBlock Text="{Binding Reports.TextReportPathText}" FontSize="11" Foreground="#94A3B8"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Open"
                                                    Click="OpenTextSummaryClick" VerticalAlignment="Center"
                                                    IsEnabled="{Binding Reports.HasTextReport}"
                                                    ToolTip="Open the plain-text summary (good for pasting into tickets)." />
                                        </Grid>
                                    </Border>

                                    <!-- JSON row -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="54" Height="34" CornerRadius="6" Background="#FEF3C7" VerticalAlignment="Center">
                                                <TextBlock Text="JSON" FontSize="11" FontWeight="Bold" Foreground="#B45309"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="Raw JSON evidence" FontWeight="SemiBold" Foreground="#0F172A" FontSize="13" />
                                                <TextBlock Text="{Binding Reports.JsonReportPathText}" FontSize="11" Foreground="#94A3B8"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Open"
                                                    Click="OpenRawJsonClick" VerticalAlignment="Center"
                                                    IsEnabled="{Binding Reports.HasJsonReport}"
                                                    ToolTip="Open the raw JSON evidence file (machine-readable for engineers)." />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- ==================================
                                 § 4. Windows WLAN report - native Windows wireless report.
                                 ================================== -->
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="Windows WLAN Report" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="Native Windows wireless history report generated by netsh, useful for adapter drops, roaming and driver events."
                                                   FontSize="12" Foreground="#64748B" Margin="0,2,0,8" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Reports.WlanReportPathText}" FontSize="11" Foreground="#94A3B8"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Generate"
                                            Command="{Binding Reports.GenerateWlanReportCommand}"
                                            VerticalAlignment="Center" Margin="0,0,10,0"
                                            ToolTip="Run 'netsh wlan show wlanreport' and store the generated HTML path." />
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Open"
                                            Click="OpenWlanReportClick"
                                            IsEnabled="{Binding Reports.HasWlanReport}"
                                            VerticalAlignment="Center"
                                            ToolTip="Open the last-generated Windows WLAN report." />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
            </Grid>

            <!--
                Global loading overlay — visible only when IsBusy=true. Sits in Row 1 (content
                area) so the header + sidebar (Grid.Column=0) stay clickable. The overlay blocks
                input on the scrolling content so users don't fire actions while one is in
                flight, and carries its own Stop button so the running operation can be cancelled.

                Visual: 50% white scrim + centered card with indeterminate ProgressBar + status
                message. Drop shadow gives the card lift on the scrim.
            -->
            <Grid Grid.Row="1"
                  Panel.ZIndex="100"
                  Background="#99FFFFFF"
                  Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="White"
                        BorderBrush="#D6E3F1" BorderThickness="1"
                        CornerRadius="12"
                        Padding="32,24"
                        MinWidth="280">
                    <Border.Effect>
                        <DropShadowEffect Color="#475569" Direction="270" ShadowDepth="3" BlurRadius="20" Opacity="0.3" />
                    </Border.Effect>
                    <StackPanel>
                        <ProgressBar IsIndeterminate="True"
                                     Height="4"
                                     Margin="0,0,0,14"
                                     Foreground="#3B82F6"
                                     Background="#E5EEF9"
                                     BorderBrush="Transparent" />
                        <TextBlock Text="Working..." FontSize="15" FontWeight="SemiBold"
                                   Foreground="#17212B" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding StatusMessage, FallbackValue=Running diagnostic checks}"
                                   Foreground="#475569" FontSize="12"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" />
                        <Button Style="{StaticResource DangerButton}" Content="Stop"
                                Command="{Binding CancelCurrentOperationCommand}"
                                HorizontalAlignment="Center" Margin="0,16,0,0"
                                ToolTip="Cancel the running operation (Esc)" />
                        <TextBlock Text="or press Esc"
                                   Foreground="#94A3B8" FontSize="11" FontStyle="Italic"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
