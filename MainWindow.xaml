        <LinearGradientBrush x:Key="HomeTaskToolButtonBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#6366F1" Offset="0" />
            <GradientStop Color="#4F46E5" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HomeTaskToolButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
