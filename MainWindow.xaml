<Window x:Class="NetScopeDiagnosticCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:NetScopeDiagnosticCenter.UI.Converters"
        xmlns:controls="clr-namespace:NetScopeDiagnosticCenter.UI.Controls"
        xmlns:behaviors="clr-namespace:NetScopeDiagnosticCenter.UI.Behaviors"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ISG Desk - IT Support &amp; Network Diagnostics"
        Icon="/Assets/logo.png"
        Height="820"
        Width="1220"
        MinHeight="720"
        MinWidth="1040"
        Background="#EBF3FC"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="14"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <!-- Custom WindowChrome — replaces the default Windows title bar with an integrated one
         that continues the app's layout (dark sidebar on the left, light content on the right).
         The OS still handles drag, resize, snap, Aero Snap, etc.; we draw the title bar UI
         and the minimize / maximize / close buttons ourselves so they match the app's design. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <!--
        Global keyboard shortcuts. Bindings target the existing commands so behavior
        matches the toolbar buttons exactly.
          Ctrl+R / F5  → Run Quick Diagnose
          Ctrl+E       → Export Reports
          Ctrl+C       → Copy Summary  (Ctrl+Shift+C to avoid clobbering text-copy in TextBoxes)
          Esc          → Stop current diagnose / cancel
          Ctrl+1..6    → Navigate to module
    -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="R" Command="{Binding DiagnoseCommand}" />
        <KeyBinding Key="F5" Command="{Binding DiagnoseCommand}" />
        <KeyBinding Modifiers="Control" Key="E" Command="{Binding GenerateReportCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="C" Command="{Binding CopySummaryCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCurrentOperationCommand}" />
        <KeyBinding Modifiers="Control" Key="D1" Command="{Binding NavigateCommand}" CommandParameter="TechnicianHome" />
        <KeyBinding Modifiers="Control" Key="D2" Command="{Binding NavigateCommand}" CommandParameter="Diagnosis" />
        <KeyBinding Modifiers="Control" Key="D3" Command="{Binding NavigateCommand}" CommandParameter="TargetedTests" />
        <KeyBinding Modifiers="Control" Key="D4" Command="{Binding NavigateCommand}" CommandParameter="Printers" />
        <KeyBinding Modifiers="Control" Key="D5" Command="{Binding NavigateCommand}" CommandParameter="NetworkDevices" />
        <KeyBinding Modifiers="Control" Key="D6" Command="{Binding NavigateCommand}" CommandParameter="Wifi" />
        <KeyBinding Modifiers="Control" Key="D7" Command="{Binding NavigateCommand}" CommandParameter="Reports" />
    </Window.InputBindings>

    <Window.Resources>
        <conv:PageVisibilityConverter x:Key="PageVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:WifiRecommendationAccentConverter x:Key="WifiRecAccent" />
        <conv:StatusBrushConverter x:Key="StatusBrush" />
        <conv:StringEqualsConverter x:Key="StringEquals" />
        <conv:StatusBackgroundBrushConverter x:Key="StatusBackgroundBrush" />
        <conv:StatusKnownToVisibilityConverter x:Key="StatusKnownToVisibility" />
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />

        <!--
            Premium sidebar navigation button — raised "card on dark" look.
            • Default:  subtle gradient (slate-800 → slate-900), 1px slate border, drop shadow.
            • Hover:    lifts (stronger shadow + slightly lighter gradient).
            • Pressed:  inset feel (smaller shadow).
            • Active:   blue gradient (blue-500 → blue-600) + white text + bold + brighter border.
            Active state is computed via the StringEquals multi-value converter against CurrentPage.
        -->
        <LinearGradientBrush x:Key="NavButtonBgIdle" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#243043" Offset="0" />
            <GradientStop Color="#1A2332" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NavButtonBgHover" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#374760" Offset="0" />
            <GradientStop Color="#26334A" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NavButtonBgActive" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3B82F6" Offset="0" />
            <GradientStop Color="#2563EB" Offset="1" />
        </LinearGradientBrush>

        <!--
            Per-module sidebar active brushes — saturated 600/700 shades chosen so White text
            stays >= 4.5:1 contrast (WCAG AA). When the user is on page X, button X's background
            gets its module accent so the sidebar instantly communicates "you are on X".
            Wired via Button.Tag — see DataTrigger in NavButton style.

            Contrast vs white (verified):
              Technician Home #2563EB -> 4.6:1
              Diagnosis #0F766E → 4.5:1
              TargetedTests #B45309 -> 4.7:1
              Printers  #9333EA → 4.7:1
              Network   #047857 → 5.5:1
              Wi-Fi     #0369A1 → 5.7:1
              Reports   #BE123C → 5.0:1
        -->
        <LinearGradientBrush x:Key="NavActiveTechnicianHome" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3B82F6" Offset="0" />
            <GradientStop Color="#2563EB" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NavActiveDiagnosis" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#14B8A6" Offset="0" />
            <GradientStop Color="#0F766E" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NavActiveTargetedTests" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#D97706" Offset="0" />
            <GradientStop Color="#B45309" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NavActivePrinters" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#A855F7" Offset="0" />
            <GradientStop Color="#9333EA" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NavActiveNetworkDevices" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#10B981" Offset="0" />
            <GradientStop Color="#047857" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NavActiveWifi" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0EA5E9" Offset="0" />
            <GradientStop Color="#0369A1" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NavActiveReports" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E11D48" Offset="0" />
            <GradientStop Color="#BE123C" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="NavIconBadge" TargetType="Border">
            <Setter Property="Width" Value="31" />
            <Setter Property="Height" Value="31" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Margin" Value="0,0,11,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#020617" Direction="270" ShadowDepth="1" BlurRadius="5" Opacity="0.35" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Opacity" Value="0.96" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Background" Value="{StaticResource NavButtonBgIdle}" />
            <Setter Property="Foreground" Value="#BFCFE5" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="6" Opacity="0.45" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavButtonBgHover}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#475569" />
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="Black" Direction="270" ShadowDepth="3" BlurRadius="9" Opacity="0.6" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="Black" Direction="270" ShadowDepth="1" BlurRadius="3" Opacity="0.4" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F8FAFC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource StringEquals}">
                            <Binding RelativeSource="{RelativeSource Self}" Path="CommandParameter" />
                            <Binding Path="DataContext.CurrentPage" RelativeSource="{RelativeSource AncestorType=Window}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <!--
                        Per-module accent: each NavButton instance sets Tag={StaticResource NavActiveX}.
                        When this button is the active page, its Tag becomes the Background. So the
                        sidebar's active button colour = the module's identity colour.
                    -->
                    <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" />
                    <Setter Property="Foreground" Value="White" />
                    <!-- Semi-transparent white border so it reads as a subtle inner highlight on every accent. -->
                    <Setter Property="BorderBrush" Value="#80FFFFFF" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            Severity pill badge: rounded colored background reflecting the severity.
            Usage:
              <Border Style="{StaticResource SeverityBadge}" Tag="{Binding Severity}">
                <TextBlock Style="{StaticResource SeverityBadgeText}" Text="{Binding Severity}" />
              </Border>
            Tag carries the severity string and is fed to StatusBrushConverter via the style.
        -->
        <Style x:Key="SeverityBadge" TargetType="Border">
            <Setter Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource StatusBrush}}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SeverityBadgeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!--
            Technician Home module card as a clickable button.
            • Background: light pastel tinted by severity (Tag carries the severity string).
            • Left stripe: 5px in the saturated severity color (BorderBrush).
            • Hover: slight tint shift + 1px lift via shadow simulation (DropShadow).
            • Pressed: subtle inset effect.
            Bind on the Button itself:
              <Button Style="{StaticResource ModuleCardButton}"
                      Tag="{Binding NavigationXSeverity}"
                      Command="{Binding NavigateCommand}" CommandParameter="X" />
        -->
        <Style x:Key="ModuleCardButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource StatusBackgroundBrush}}" />
            <Setter Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource StatusBrush}}" />
            <Setter Property="MinHeight" Value="200" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="5,1,1,1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#94A3B8" Direction="270" ShadowDepth="1" BlurRadius="3" Opacity="0.15" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="6,1,1,1" />
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#475569" Direction="270" ShadowDepth="2" BlurRadius="6" Opacity="0.25" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="5,2,2,2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Premium primary button — blue gradient with subtle drop shadow.

            REFACTOR (round 10): the template now reads its hover gradient from the Button's
            Tag property and the shadow tint from BorderBrush.Color. This means BasedOn variants
            (PrimaryButtonDiagnosis, ...TargetedTests, etc.) only need to override Background +
            BorderBrush + Tag — the template itself is shared. BorderBrush also acts as the
            "darker" tone for pressed state shadow.

            Hover: brightens + larger shadow (lift). Pressed: inset (smaller shadow).
            Disabled: faded with no shadow.
        -->
        <LinearGradientBrush x:Key="PrimaryBtnIdle" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3B82F6" Offset="0" />
            <GradientStop Color="#2563EB" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PrimaryBtnHover" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#60A5FA" Offset="0" />
            <GradientStop Color="#3B82F6" Offset="1" />
        </LinearGradientBrush>

        <!-- Per-module gradient pairs (idle + hover) for primary action buttons. -->
        <LinearGradientBrush x:Key="PrimaryBtnIdleDiagnosis" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#14B8A6" Offset="0" />
            <GradientStop Color="#0D9488" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PrimaryBtnHoverDiagnosis" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2DD4BF" Offset="0" />
            <GradientStop Color="#14B8A6" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DiagnosisCopyButtonBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#6366F1" Offset="0" />
            <GradientStop Color="#4F46E5" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DiagnosisCopyButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#818CF8" Offset="0" />
            <GradientStop Color="#6366F1" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DiagnosisExportButtonBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#A855F7" Offset="0" />
            <GradientStop Color="#7E22CE" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DiagnosisExportButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
