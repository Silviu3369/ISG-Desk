        <!--
            Premium ComboBox — matches TextBox/PasswordBox shape language so SNMP version, profiles,
            and other dropdowns feel cohesive instead of looking like default Win32 chrome.
            Uses a custom toggle button with a chevron glyph + a styled popup.
        -->
        <ControlTemplate x:Key="PremiumComboToggleButton" TargetType="ToggleButton">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0" Margin="10,0,0,0"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <Path Grid.Column="1" Width="10" Height="6" Margin="10,0,12,0"
                          Stretch="Fill" Fill="#64748B"
                          Data="M 0 0 L 5 5 L 10 0 Z"
                          VerticalAlignment="Center" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6" />
                    <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#17212B" />
            <Setter Property="BorderBrush" Value="#BFCFE5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="false"
                                          ClickMode="Press"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Template="{StaticResource PremiumComboToggleButton}">
                                <ContentPresenter x:Name="ContentSite"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  IsHitTestVisible="False"
                                                  VerticalAlignment="Center" />
                            </ToggleButton>
                            <TextBox x:Name="PART_EditableTextBox"
                                     Visibility="Hidden"
                                     IsReadOnly="{TemplateBinding IsReadOnly}" />
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="White"
                                        BorderBrush="#BFCFE5"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#475569" Direction="270" ShadowDepth="2" BlurRadius="8" Opacity="0.18" />
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#17212B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF" />
                                <Setter Property="Foreground" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DBEAFE" />
                                <Setter Property="Foreground" Value="#1E3A8A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Premium CheckBox — square 18x18, blue accent on check, soft hover.
            The default WPF checkbox feels Windows-95-y; this matches our flat blue palette.
        -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#17212B" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box"
                                    Width="18" Height="18"
                                    CornerRadius="4"
                                    Background="White"
                                    BorderBrush="#94A3B8"
                                    BorderThickness="1.5"
                                    VerticalAlignment="Center">
                                <Path x:Name="Check"
                                      Width="10" Height="8"
                                      Stretch="Fill"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M 0 4 L 4 8 L 10 0"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#3B82F6" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#3B82F6" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Background" Value="#E5EEF9" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#BFCFE5" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Premium RadioButton — same blue accent system as CheckBox but circular.
        -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#17212B" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="18" Height="18" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring"
                                         Fill="White"
                                         Stroke="#94A3B8"
                                         StrokeThickness="1.5" />
                                <Ellipse x:Name="Dot"
                                         Width="8" Height="8"
                                         Fill="White"
                                         Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="#3B82F6" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Fill" Value="#3B82F6" />
                                <Setter TargetName="Ring" Property="Stroke" Value="#2563EB" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Ring" Property="Fill" Value="#E5EEF9" />
                                <Setter TargetName="Ring" Property="Stroke" Value="#BFCFE5" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Premium DataGrid — modern flat look (no gridlines, subtle row hover, alt rows,
            sticky header). Used by printer scan, network devices interfaces, ping results.
        -->
        <Style TargetType="DataGrid">
            <!-- Page scroll must survive crossing a grid: bubble the wheel to the page
                 ScrollViewer whenever this grid has nothing left to scroll itself. -->
            <Setter Property="behaviors:ScrollWheelBubbling.Enabled" Value="True" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D6E3F1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#F2F7FD" />
            <Setter Property="HorizontalGridLinesBrush" Value="#D6E3F1" />
            <Setter Property="RowHeaderWidth" Value="0" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E5EEF9" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BorderBrush" Value="#D6E3F1" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE" />
                    <Setter Property="Foreground" Value="#1E40AF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--
            Premium ScrollBar — slim 10px track, blue-tinted thumb with rounded corners,
            no arrow buttons (modern OS pattern). Idle 35% opacity, hover 65%, drag full.
            Applied implicitly to ScrollBar TargetType so every ScrollViewer in the app inherits it.
        -->
        <Style x:Key="ScrollBarThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd"
                                Background="#7395BC"
                                CornerRadius="5"
                                Margin="2"
                                Opacity="0.5" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                                <Setter TargetName="Bd" Property="Background" Value="#3B82F6" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="1" />
                                <Setter TargetName="Bd" Property="Background" Value="#2563EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Focusable="False">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="10" />
                    <Setter Property="MinHeight" Value="10" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track"
                                           IsDirectionReversed="False"
                                           Focusable="False">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollBarThumb}" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Border Background="Transparent" />
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.IncreaseRepeatButton>
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Border Background="Transparent" />
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.DecreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--
            Premium Expander — card-style with chevron rotation on expand.
            Used heavily on the Diagnosis page (3 sections) and inline in cards.
        -->
        <Style TargetType="Expander">
            <Setter Property="BorderBrush" Value="#D6E3F1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#17212B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <DockPanel>
                                <ToggleButton x:Name="HeaderSite"
                                              DockPanel.Dock="Top"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Cursor="Hand"
                                              Padding="14,10"
                                              HorizontalContentAlignment="Stretch">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="7,7,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter Grid.Column="0" VerticalAlignment="Center" TextElement.FontWeight="SemiBold" />
                                                    <Path x:Name="Chevron"
                                                          Grid.Column="1"
                                                          Data="M 0 0 L 6 6 L 12 0"
                                                          Stroke="#64748B"
                                                          StrokeThickness="2"
                                                          Fill="Transparent"
                                                          Width="14" Height="8"
                                                          VerticalAlignment="Center"
                                                          Margin="8,0,0,0"
                                                          RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform x:Name="ChevronRotate" Angle="0" />
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#F2F7FD" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ChevronRotate" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.18" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ChevronRotate" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.18" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ContentPresenter ContentSource="Header" />
                                </ToggleButton>

                                <Border x:Name="ExpandSite"
                                        BorderBrush="#D6E3F1"
                                        BorderThickness="0,1,0,0"
                                        Background="White"
                                        Padding="14,12"
                                        Visibility="Collapsed">
                                    <ContentPresenter />
                                </Border>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Premium Card — soft drop shadow + slate border + 8px corners. Used everywhere
            we need to group content into a visual block (Technician Home tiles, module sections,
            scan result panels). The shadow is intentionally faint (~12% opacity) so multiple
            cards on a page don't feel busy.
        -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2EAF6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <!-- Premium depth: a soft, generous drop shadow makes the card read as a floating
                 layer (not a flat rectangle). Tighter CornerRadius=16 (from 8) makes the corners
                 read as modern / app-like rather than dashboard-utility. -->
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#475569" Direction="270" ShadowDepth="3" BlurRadius="18" Opacity="0.14" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!--
                    Hover affordance — shadow deepens + border picks up a touch more colour.
                    Doesn't move the card (would shift layout in scroll views), just lifts the
                    apparent elevation so the page feels alive instead of static.
                -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#BFCFE5" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#475569" Direction="270" ShadowDepth="5" BlurRadius="26" Opacity="0.22" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--
            AccentCard — variant of Card with a coloured top stripe (4px) for sections that
            represent a specific module or status. Bind BorderBrush to the desired AccentX brush
            and the top stripe inherits via BorderThickness="0,4,0,0".
            Usage:
              <Border Style="{StaticResource AccentCard}" BorderBrush="{StaticResource AccentDiagnosis}">
                ...
              </Border>
        -->
        <Style x:Key="AccentCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="BorderThickness" Value="0,4,0,0" />
            <Setter Property="BorderBrush" Value="#3B82F6" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#17212B" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <!--
            Module hero banner — colored hero header per page so each module has visual identity
            beyond just the SectionTitle. Pattern: pastel-tinted Border + colored icon chip + title.
            Use the per-module accent brushes (defined below) for the chip Background.

            Accent palette (saturated → chip + accent details):
              Technician Home: blue-600  #2563EB
              Diagnosis:     teal-600   #0D9488
              TargetedTests: amber-500  #F59E0B
              Printers:      purple-600 #9333EA
              NetworkDevices emerald-500 #10B981
              Wi-Fi:         sky-500    #0EA5E9
              Reports:       rose-600   #E11D48

            Pastel backgrounds (page hero bg) — 50/100 family:
              Technician Home #DBEAFE
              Diagnosis      #CCFBF1
              TargetedTests  #FEF3C7
              Printers       #F3E8FF
              NetworkDevices #D1FAE5
              Wi-Fi          #E0F2FE
              Reports        #FFE4E6
        -->
        <SolidColorBrush x:Key="AccentTechnicianHome"      Color="#2563EB" />
        <SolidColorBrush x:Key="AccentDiagnosis"      Color="#0D9488" />
        <SolidColorBrush x:Key="AccentTargetedTests"  Color="#F59E0B" />
        <SolidColorBrush x:Key="AccentPrinters"       Color="#9333EA" />
        <SolidColorBrush x:Key="AccentNetworkDevices" Color="#10B981" />
        <SolidColorBrush x:Key="AccentWifi"           Color="#0EA5E9" />
        <SolidColorBrush x:Key="AccentReports"        Color="#E11D48" />

        <LinearGradientBrush x:Key="HeroBgTechnicianHome" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#DBEAFE" Offset="0" />
            <GradientStop Color="#EFF6FF" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeroBgDiagnosis" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#CCFBF1" Offset="0" />
            <GradientStop Color="#F0FDFA" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeroBgTargetedTests" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FEF3C7" Offset="0" />
            <GradientStop Color="#FFFBEB" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeroBgPrinters" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#F3E8FF" Offset="0" />
            <GradientStop Color="#FAF5FF" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeroBgNetworkDevices" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#D1FAE5" Offset="0" />
            <GradientStop Color="#ECFDF5" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeroBgWifi" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#E0F2FE" Offset="0" />
            <GradientStop Color="#F0F9FF" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeroBgReports" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFE4E6" Offset="0" />
            <GradientStop Color="#FFF1F2" Offset="1" />
        </LinearGradientBrush>
        <!--
            Style for the icon chip — coloured square with the emoji centered. Used inside
            ModuleHero blocks. Background must be set per-page from Accent* brushes.
        -->
        <Style x:Key="ModuleHeroChip" TargetType="Border">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#475569" Direction="270" ShadowDepth="2" BlurRadius="6" Opacity="0.25" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hero banner aligned with the Card style (same CornerRadius, right margin, border
             colour, shadow depth) so the page reads as a coherent stack of layers, not a
             mismatched header floating above. -->
        <Style x:Key="ModuleHeroBanner" TargetType="Border">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="22,18" />
            <Setter Property="Margin" Value="0,0,14,18" />
            <Setter Property="BorderBrush" Value="#E2EAF6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#475569" Direction="270" ShadowDepth="3" BlurRadius="18" Opacity="0.14" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModuleHeroIcon" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ModuleHeroTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#0F172A" />
        </Style>

        <Style x:Key="ModuleHeroSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#17212B" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="HomeSectionHeaderRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="HomeSectionIconBadge" TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#475569" Direction="270" ShadowDepth="1" BlurRadius="5" Opacity="0.18" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HomeSectionIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="HomeSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>

        <Style x:Key="HomeStatusTile" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2EAF6" />
            <Setter Property="BorderThickness" Value="1,1,1,3" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Width" Value="242" />
            <Setter Property="MinHeight" Value="112" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#64748B" Direction="270" ShadowDepth="2" BlurRadius="12" Opacity="0.10" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HomeStatusLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
