                                    <UniformGrid Columns="3">

                                        <Border Grid.Column="0" Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="Evidence" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                                                <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,4"
                                                        Visibility="{Binding HasNoVerdictEvidence, Converter={StaticResource BoolVisibility}}">
                                                    <TextBlock Text="No verdict evidence yet." Foreground="#64748B" FontSize="12" TextWrapping="Wrap" />
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding LastDiagnosis.Verdict.Evidence}"
                                                              Visibility="{Binding HasVerdictEvidence, Converter={StaticResource BoolVisibility}}">
                                                    <ItemsControl.ItemTemplate>
