                                        <TextBlock Style="{StaticResource LabelText}" Text="SSID" Margin="0,12,0,3" />
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastDiagnosis.Wifi.Ssid, TargetNullValue=Not active}" TextWrapping="Wrap" />
