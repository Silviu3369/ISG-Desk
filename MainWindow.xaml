            <GradientStop Color="#334155" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HomeStorageToolButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#64748B" Offset="0" />
            <GradientStop Color="#475569" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="HomeStorageToolButton" TargetType="Button" BasedOn="{StaticResource HomeToolButton}">
