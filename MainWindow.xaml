                                        <StackPanel Grid.Column="4">
                                            <TextBlock Style="{StaticResource LabelText}" Text="Privacy password" />
                                            <PasswordBox x:Name="NetworkDeviceSnmpPrivacyPasswordBox" PasswordChanged="NetworkDeviceSnmpPrivacyPasswordChanged" Height="36" Padding="10,7" BorderBrush="#BFCFE5" />
                                        </StackPanel>
                                    </Grid>
                                    <WrapPanel Margin="0,0,0,12">
                                        <CheckBox Content="Save SNMP credentials securely for this Windows user" IsChecked="{Binding SaveNetworkDeviceSnmpCredentials}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                        <TextBlock Text="{Binding HasSavedNetworkDeviceSnmpCredentials, StringFormat=Saved credential available: {0}}" Foreground="#475569" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0" />
                                        <Button Style="{StaticResource DangerButton}" Content="Forget Saved SNMP Credentials" Command="{Binding ForgetNetworkDeviceSnmpCredentialCommand}" Click="ClearNetworkDeviceSnmpPasswordBoxesClick" ToolTip="Remove the encrypted SNMP credential stored on this PC (DPAPI)" />
                                    </WrapPanel>
