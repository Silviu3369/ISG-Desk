                                </StackPanel>
                              </Expander.Header>
                              <StackPanel Margin="0,8,0,0">
                                <Border Style="{StaticResource Card}" BorderBrush="{Binding LastLinkQualityResult.Severity, Converter={StaticResource StatusBrush}}" BorderThickness="5,1,1,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="170" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding LastLinkQualityResult.Summary}" FontSize="20" FontWeight="SemiBold" Foreground="#17212B" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding LastLinkQualityResult.Source, StringFormat=Source: {0}}" Foreground="#334155" TextWrapping="Wrap" Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding LastLinkQualityResult.Confidence, StringFormat=Confidence: {0}}" Foreground="#334155" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding LastLinkQualityResult.AffectedLayer, StringFormat=Affected layer: {0}}" Foreground="#334155" Margin="0,4,0,0" />
                                            <TextBlock Text="Bounded ping/jitter test that separates local gateway quality from internet/DNS path quality."
                                                       Foreground="#475569"
                                                       TextWrapping="Wrap"
                                                       Margin="0,10,0,0" />
                                            <TextBlock Text="{Binding LastLinkQualityResult.Thresholds.Summary, StringFormat=Thresholds: {0}}"
                                                       Foreground="#475569"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0" />
                                            <WrapPanel Margin="0,12,0,0">
                                                <Border CornerRadius="10" Padding="10,4" Margin="0,0,8,6"
                                                        Background="{Binding LastLinkQualityResult.Severity, Converter={StaticResource StatusBackgroundBrush}}">
                                                    <TextBlock Text="{Binding LastLinkQualityResult.Severity, StringFormat=Status: {0}}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding LastLinkQualityResult.Severity, Converter={StaticResource StatusBrush}}" />
                                                </Border>
                                                <Border CornerRadius="10" Padding="10,4" Margin="0,0,8,6" Background="#EEF2F7">
                                                    <TextBlock Text="{Binding LinkQualityPingResultCountText}" FontSize="12" Foreground="#475569" />
                                                </Border>
                                                <Border CornerRadius="10" Padding="10,4" Margin="0,0,8,6" Background="#EEF2F7">
                                                    <TextBlock Text="{Binding LinkQualityDnsResultCountText}" FontSize="12" Foreground="#475569" />
                                                </Border>
                                                <Border CornerRadius="10" Padding="10,4" Margin="0,0,8,6" Background="#F0FDFA">
                                                    <TextBlock Text="{Binding LinkQualitySnapshotTimeText}" FontSize="12" Foreground="#0F766E" />
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                            <Button Style="{StaticResource DiagnosisSnapshotButton}" Command="{Binding RefreshLinkQualityCommand}" ToolTip="Re-collect baseline link quality (gateway / DNS / internet snapshot)">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               Text="&#xE72C;"
                                                               FontSize="13"
                                                               Margin="0,0,7,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="Refresh Snapshot" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource DiagnosisCopyButton}" Command="{Binding CopyLinkQualitySummaryCommand}" Margin="0,8,0,0" ToolTip="Copy Link Quality summary for ticket">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               Text="&#xE8C8;"
                                                               FontSize="13"
                                                               Margin="0,0,7,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="Copy Summary" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Ping Latency / Jitter Test" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                                        <WrapPanel VerticalAlignment="Bottom">
                                            <StackPanel Width="360" Margin="0,0,10,8">
                                                <TextBlock Style="{StaticResource LabelText}" Text="Target" />
                                                <TextBox Text="{Binding LinkQualityPingTarget, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,7" BorderBrush="#BFCFE5" />
                                            </StackPanel>
                                            <StackPanel Width="110" Margin="0,0,10,8">
                                                <TextBlock Style="{StaticResource LabelText}" Text="Samples" />
                                                <TextBox Text="{Binding LinkQualityPingSamples, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,7" BorderBrush="#BFCFE5" />
                                            </StackPanel>
                                            <Button Style="{StaticResource PrimaryButtonDiagnosis}" Command="{Binding RunLinkQualityPingCommand}" Height="36" MinWidth="150" Margin="0,15,10,8">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               Text="{Binding LinkQualityPingButtonIcon}"
                                                               FontSize="13"
                                                               Margin="0,0,7,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding LinkQualityPingButtonText}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource DangerButton}" Command="{Binding CancelLinkQualityCommand}" Visibility="{Binding IsLinkQualityRunning, Converter={StaticResource BoolVisibility}}" Height="36" MinWidth="90" Margin="0,15,0,8" ToolTip="Stop the running ping test">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               Text="&#xE711;"
                                                               FontSize="13"
                                                               Margin="0,0,7,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="Stop" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>
                                        <Grid Margin="0,2,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="Target presets" FontWeight="SemiBold" Foreground="#17212B" Margin="0,0,0,8" />
                                                <ItemsControl ItemsSource="{Binding LinkQualityTargetOptions}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource DiagnosisPresetButton}"
                                                                    Command="{Binding DataContext.ApplyLinkQualityTargetPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="{Binding Description}"
                                                                    Margin="0,0,8,8"
                                                                    MinWidth="118">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                               Text="{Binding Icon}"
                                                                               FontSize="13"
                                                                               Margin="0,0,7,0"
                                                                               VerticalAlignment="Center" />
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="#17212B" />
                                                                        <TextBlock Text="{Binding TargetDisplayText}" Foreground="#64748B" FontSize="11" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" MinWidth="260">
                                                <TextBlock Text="Sample presets" FontWeight="SemiBold" Foreground="#17212B" Margin="0,0,0,8" />
                                                <ItemsControl ItemsSource="{Binding LinkQualitySampleOptions}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource DiagnosisPresetButton}"
                                                                    Command="{Binding DataContext.ApplyLinkQualitySamplePresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="{Binding Description}"
                                                                    Margin="0,0,8,8"
                                                                    MinWidth="70">
                                                                <TextBlock Text="{Binding Samples}" FontWeight="SemiBold" />
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                        <Border Background="#F2F7FD" BorderBrush="#BFCFE5" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Current operation" FontWeight="SemiBold" Foreground="#17212B" />
                                                <TextBlock Text="{Binding LinkQualityRunStateText}" Foreground="#334155" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Bounded single-target test. Use your gateway for local link quality, or an authorized host for path comparison."
                                                   Foreground="#475569"
                                                   TextWrapping="Wrap"
                                                   Margin="0,10,0,10" />
                                        <Expander Header="Thresholds used for interpretation" Margin="0,0,0,10">
                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock Text="{Binding LastLinkQualityResult.Thresholds.GatewaySummary}" Foreground="#475569" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding LastLinkQualityResult.Thresholds.InternetSummary}" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding LastLinkQualityResult.Thresholds.TargetSummary}" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding LastLinkQualityResult.Thresholds.DnsSummary}" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding LastLinkQualityResult.Thresholds.StabilitySummary}" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Expander>
                                        <WrapPanel Margin="0,0,0,10">
                                            <Button Style="{StaticResource DiagnosisPathButton}" Command="{Binding RunLinkQualityPathDiagnosticsCommand}" ToolTip="Run path diagnostics: gateway ping, DNS resolution, internet reachability">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               Text="{Binding LinkQualityPathButtonIcon}"
                                                               FontSize="13"
                                                               Margin="0,0,7,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding LinkQualityPathButtonText}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>
                                        <Grid Margin="0,4,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Ping Results" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding LinkQualityPingResultCountText}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                                        </Grid>
                                        <Border Background="#F2F7FD" BorderBrush="#BFCFE5" BorderThickness="1" CornerRadius="6" Padding="12" Visibility="{Binding HasNoLinkQualityPingResults, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,10">
                                            <TextBlock Text="{Binding LinkQualityPingEmptyText}" Foreground="#475569" TextWrapping="Wrap" />
                                        </Border>
                                        <DataGrid ItemsSource="{Binding LastLinkQualityResult.PingResults}" Visibility="{Binding HasLinkQualityPingResults, Converter={StaticResource BoolVisibility}}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MinHeight="120" MaxHeight="260" HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserResizeColumns="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="*" />
                                                <DataGridTextColumn Header="Type" Binding="{Binding Category}" Width="90" />
                                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                                                <DataGridTextColumn Header="Sent" Binding="{Binding Sent}" Width="70" />
                                                <DataGridTextColumn Header="Received" Binding="{Binding Received}" Width="80" />
                                                <DataGridTextColumn Header="Loss" Binding="{Binding LossText}" Width="80" />
                                                <DataGridTextColumn Header="Min" Binding="{Binding MinimumLatencyText}" Width="90" />
                                                <DataGridTextColumn Header="Avg" Binding="{Binding AverageLatencyText}" Width="90" />
                                                <DataGridTextColumn Header="Max" Binding="{Binding MaximumLatencyText}" Width="90" />
                                                <DataGridTextColumn Header="Jitter" Binding="{Binding JitterText}" Width="90" />
                                                <DataGridTextColumn Header="Threshold" Binding="{Binding ThresholdProfile}" Width="180" />
                                                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="2*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Grid Margin="0,14,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="DNS Lookup Results" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding LinkQualityDnsResultCountText}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                                        </Grid>
                                        <Border Background="#F2F7FD" BorderBrush="#BFCFE5" BorderThickness="1" CornerRadius="6" Padding="12" Visibility="{Binding HasNoLinkQualityDnsResults, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,10">
                                            <TextBlock Text="{Binding LinkQualityDnsEmptyText}" Foreground="#475569" TextWrapping="Wrap" />
                                        </Border>
                                        <DataGrid ItemsSource="{Binding LastLinkQualityResult.DnsResults}" Visibility="{Binding HasLinkQualityDnsResults, Converter={StaticResource BoolVisibility}}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MinHeight="100" MaxHeight="220" HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserResizeColumns="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                                                <DataGridTextColumn Header="Latency" Binding="{Binding LatencyText}" Width="100" />
                                                <DataGridTextColumn Header="Threshold" Binding="{Binding ThresholdProfile}" Width="180" />
                                                <DataGridTextColumn Header="Addresses" Binding="{Binding AddressSummary}" Width="2*" />
                                                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="2*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>

                                <!-- Manual traceroute: shows WHERE the path breaks (local vs ISP) on demand,
                                     not only when Quick Diagnosis detects an outage. -->
                                <Border Style="{StaticResource Card}"
                                        BorderBrush="{Binding LastTraceRoute.Status, Converter={StaticResource StatusBrush}, FallbackValue=#E2EAF6}"
                                        BorderThickness="5,1,1,1">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Trace Route (hop-by-hop path)" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding TraceRouteHopCountText}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <Button Grid.Column="2" Style="{StaticResource PrimaryButtonDiagnosis}" Command="{Binding RunTraceRouteCommand}"
                                                    ToolTip="Bounded traceroute (max 15 hops) to the target above — empty target uses the internet beacon. Shows whether a break is on the LOCAL side or at the ISP.">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="{Binding TraceRouteButtonIcon}" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding TraceRouteButtonText}" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <Border Background="#F2F7FD" BorderBrush="#BFCFE5" BorderThickness="1" CornerRadius="6" Padding="12"
                                                Visibility="{Binding NoTraceRoute, Converter={StaticResource BoolVisibility}}">
                                            <TextBlock Text="No traceroute yet. Uses the Ping Latency target above (or the internet beacon when empty) and labels each hop as local or ISP/internet."
                                                       Foreground="#475569" TextWrapping="Wrap" />
                                        </Border>
                                        <StackPanel Visibility="{Binding HasTraceRoute, Converter={StaticResource BoolVisibility}}">
                                            <TextBlock Text="{Binding LastTraceRoute.Summary}" FontWeight="SemiBold" Foreground="#17212B" TextWrapping="Wrap" Margin="0,0,0,8" />
                                            <ItemsControl ItemsSource="{Binding LastTraceRoute.Hops}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,5">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="44" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Hop, StringFormat=#{0}}" FontWeight="SemiBold" Foreground="#475569" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Address}" Foreground="#0F172A" FontWeight="SemiBold" />
                                                                <TextBlock Grid.Column="2" Text="{Binding Scope}" Foreground="#64748B" FontSize="11.5" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <UniformGrid Columns="2">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Adapter" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                                            <TextBlock Style="{StaticResource LabelText}" Text="Name" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastLinkQualityResult.AdapterName, TargetNullValue=Unknown}" />
                                            <TextBlock Style="{StaticResource LabelText}" Text="Description" Margin="0,12,0,3" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastLinkQualityResult.InterfaceDescription, TargetNullValue=Unknown}" />
                                            <TextBlock Style="{StaticResource LabelText}" Text="Connection type" Margin="0,12,0,3" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastLinkQualityResult.ConnectionType, TargetNullValue=Unknown}" />
                                            <TextBlock Style="{StaticResource LabelText}" Text="MAC" Margin="0,12,0,3" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastLinkQualityResult.MacAddress, TargetNullValue=Unknown}" />
                                            <TextBlock Style="{StaticResource LabelText}" Text="Driver" Margin="0,12,0,3" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastLinkQualityResult.DriverInformation, TargetNullValue=Unknown}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Counters" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                                            <TextBlock Style="{StaticResource LabelText}" Text="Link speed" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastLinkQualityResult.LinkSpeed, TargetNullValue=Unknown}" />
                                            <TextBlock Style="{StaticResource LabelText}" Text="Expected Ethernet minimum" Margin="0,12,0,3" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastLinkQualityResult.ExpectedMinimumEthernetMbps, StringFormat={}{0} Mbps, TargetNullValue=Unknown}" />
                                            <TextBlock Style="{StaticResource LabelText}" Text="Speed / Duplex" Margin="0,12,0,3" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastLinkQualityResult.SpeedDuplex, TargetNullValue=Unknown}" />
                                            <TextBlock Style="{StaticResource LabelText}" Text="Errors" Margin="0,12,0,3" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastLinkQualityResult.Errors, TargetNullValue=0}" />
                                            <TextBlock Style="{StaticResource LabelText}" Text="Discards" Margin="0,12,0,3" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastLinkQualityResult.Discards, TargetNullValue=0}" />
                                            <TextBlock Style="{StaticResource LabelText}" Text="Sampling" Margin="0,12,0,3" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastLinkQualityResult.SamplingStatus, TargetNullValue=Run Quick Diagnosis first}" />
                                            <TextBlock Style="{StaticResource LabelText}" Text="Errors / Discards per second" Margin="0,12,0,3" />
                                            <TextBlock Style="{StaticResource ValueText}">
                                                <Run Text="{Binding LastLinkQualityResult.ErrorsPerSecond, StringFormat={}{0:N2}, TargetNullValue=Unknown}" />
                                                <Run Text=" / " />
                                                <Run Text="{Binding LastLinkQualityResult.DiscardsPerSecond, StringFormat={}{0:N2}, TargetNullValue=Unknown}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                                <UniformGrid Columns="2">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Evidence" FontSize="18" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding LinkQualityEvidenceCountText}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                                            </Grid>
                                            <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,4"
                                                    Visibility="{Binding HasNoLinkQualityEvidence, Converter={StaticResource BoolVisibility}}">
                                                <TextBlock Text="No link-quality evidence yet. Refresh from Quick Diagnosis or run a ping/path test."
                                                           Foreground="#64748B"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding LastLinkQualityResult.Evidence}"
                                                          Visibility="{Binding HasLinkQualityEvidence, Converter={StaticResource BoolVisibility}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StringFormat=- {0}}" TextWrapping="Wrap" Margin="0,0,0,7" Foreground="#334155" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Recommended Next Steps" FontSize="18" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding LinkQualityRecommendationCountText}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                                            </Grid>
                                            <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,4"
                                                    Visibility="{Binding HasNoLinkQualityRecommendations, Converter={StaticResource BoolVisibility}}">
                                                <TextBlock Text="No link-quality recommendation yet."
                                                           Foreground="#64748B"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding LastLinkQualityResult.Recommendations}"
                                                          Visibility="{Binding HasLinkQualityRecommendations, Converter={StaticResource BoolVisibility}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StringFormat=- {0}}" TextWrapping="Wrap" Margin="0,0,0,7" Foreground="#334155" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Limitations" FontSize="18" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding LinkQualityLimitationCountText}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                                        </Grid>
                                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,4"
                                                Visibility="{Binding HasNoLinkQualityLimitations, Converter={StaticResource BoolVisibility}}">
                                            <TextBlock Text="No link-quality limitations recorded."
                                                       Foreground="#64748B"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding LastLinkQualityResult.Limitations}"
                                                      Visibility="{Binding HasLinkQualityLimitations, Converter={StaticResource BoolVisibility}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat=- {0}}" TextWrapping="Wrap" Margin="0,0,0,7" Foreground="#334155" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                              </StackPanel>
                            </Expander>

                            <!-- ===== Section 3: Manual Port Test ===== -->
                            <Expander IsExpanded="False" Margin="0,0,0,12" FontSize="15" FontWeight="SemiBold">
                              <Expander.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource HomeSectionIconBadge}" Tag="{StaticResource AccentDiagnosis}"
                                            Width="26" Height="26" CornerRadius="7" Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource HomeSectionIcon}" FontSize="13" Text="&#xE8C8;" />
                                    </Border>
                                    <TextBlock Text="Manual Port Test" VerticalAlignment="Center" />
                                </StackPanel>
                              </Expander.Header>
                              <StackPanel Margin="0,8,0,0">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <WrapPanel VerticalAlignment="Bottom">
                                            <StackPanel Width="330" Margin="0,0,10,8">
                                                <TextBlock Style="{StaticResource LabelText}" Text="Target hostname or IP" />
                                                <TextBox Text="{Binding TargetHost, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="40" Padding="12,8" VerticalContentAlignment="Center" BorderBrush="#BFCFE5" />
                                            </StackPanel>
                                            <StackPanel Width="230" Margin="0,0,10,8">
                                                <TextBlock Style="{StaticResource LabelText}" Text="Port preset" />
                                                <ComboBox ItemsSource="{Binding PortTestPortOptions}"
                                                          DisplayMemberPath="DisplayText"
                                                          SelectedValuePath="Port"
                                                          SelectedValue="{Binding TargetPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Height="40" Padding="10,6" VerticalContentAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Width="96" Margin="0,0,10,8">
                                                <TextBlock Style="{StaticResource LabelText}" Text="Port" />
                                                <TextBox Text="{Binding TargetPort, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="40" Padding="12,8" VerticalContentAlignment="Center" BorderBrush="#BFCFE5" />
                                            </StackPanel>
                                            <Button Style="{StaticResource PrimaryButtonDiagnosis}"
                                                    Command="{Binding RunPortTestCommand}" Height="40" MinWidth="140" Margin="0,15,10,8">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               Text="{Binding PortTestButtonIcon}"
                                                               FontSize="13"
                                                               Margin="0,0,7,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding PortTestButtonText}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource DangerButton}"
                                                    Command="{Binding CancelPortTestCommand}" Height="40" MinWidth="80" Margin="0,15,0,8"
                                                    Visibility="{Binding IsPortTestRunning, Converter={StaticResource BoolVisibility}}"
                                                    ToolTip="Cancel the running port test (it also auto-times-out after 30 s).">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               Text="&#xE711;"
                                                               FontSize="13"
                                                               Margin="0,0,7,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="Stop" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>
                                        <TextBlock Foreground="#64748B" FontSize="12" Margin="0,2,0,8" TextWrapping="Wrap"
                                                   Text="{Binding SelectedPortDescription}" />
                                        <Border CornerRadius="8"
                                                Padding="10,7"
                                                Margin="0,0,0,8"
                                                Background="{Binding PortTestInputSeverity, Converter={StaticResource StatusBackgroundBrush}}"
                                                BorderBrush="{Binding PortTestInputSeverity, Converter={StaticResource StatusBrush}}"
                                                BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                         Fill="{Binding PortTestInputSeverity, Converter={StaticResource StatusBrush}}" />
                                                <TextBlock Text="{Binding PortTestInputStatusText}"
                                                           Foreground="#334155"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Margin="8,0,0,0"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Foreground="#94A3B8" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"
                                                   Text="Single-target TCP reachability. Public hosts are allowed (e.g. smtp.office365.com : 587). Cancellable; auto-times-out after 30 s." />
                                        <TextBlock Text="Quick targets" FontWeight="SemiBold" Foreground="#17212B" Margin="0,2,0,8" />
                                        <ItemsControl ItemsSource="{Binding PortTestTargetOptions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource DiagnosisPresetButton}"
                                                            Command="{Binding DataContext.ApplyPortTestTargetPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="{Binding Description}"
                                                            Margin="0,0,8,8"
                                                            MinWidth="132">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                       Text="{Binding Icon}"
                                                                       FontSize="13"
                                                                       Margin="0,0,7,0"
                                                                       VerticalAlignment="Center" />
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="#17212B" />
                                                                <TextBlock Text="{Binding Target}" Foreground="#64748B" FontSize="11" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <UniformGrid Columns="2">
                                    <!-- ===== Last Target Test (premium result card) ===== -->
                                    <Border Style="{StaticResource Card}" BorderBrush="{Binding LastDiagnosis.LastPortTest.Severity, Converter={StaticResource StatusBrush}}" BorderThickness="5,1,1,1">
                                        <StackPanel>
                                            <TextBlock Text="Last Target Test" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                                            <!-- Empty state -->
                                            <Border Background="#F8FAFC" CornerRadius="8" Padding="16" Margin="0,0,0,4"
                                                    Visibility="{Binding HasNoPortTest, Converter={StaticResource BoolVisibility}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               Text="&#xE8C8;"
                                                               Foreground="#64748B"
                                                               FontSize="15"
                                                               Margin="0,0,10,0"
                                                               VerticalAlignment="Top" />
                                                    <TextBlock Text="No port test run yet. Enter a target and port above, then run the TCP reachability check."
                                                               Foreground="#64748B" FontSize="13" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Visibility="{Binding HasPortTest, Converter={StaticResource BoolVisibility}}">
                                                <!-- Big verdict badge -->
                                                <Border CornerRadius="10" Padding="14,10"
                                                        Background="{Binding LastDiagnosis.LastPortTest.Severity, Converter={StaticResource StatusBackgroundBrush}}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding LastDiagnosis.LastPortTest.Severity, StringFormat=Result: {0}}"
                                                                   FontSize="13" FontWeight="Bold"
                                                                   Foreground="{Binding LastDiagnosis.LastPortTest.Severity, Converter={StaticResource StatusBrush}}" />
                                                        <TextBlock Text="{Binding LastDiagnosis.LastPortTest.Verdict}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                                   FontSize="13" Foreground="#0F172A" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#F8FAFC" BorderBrush="#E2EAF6" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                   Text="&#xE946;"
                                                                   Foreground="#0F766E"
                                                                   FontSize="15"
                                                                   Margin="0,0,10,0"
                                                                   VerticalAlignment="Top" />
                                                        <TextBlock Text="{Binding LastPortTestInterpretation}"
                                                                   Foreground="#334155"
                                                                   FontSize="12.5"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>

                                                <Grid Margin="0,14,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Style="{StaticResource LabelText}" Text="Target" />
                                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastDiagnosis.LastPortTest.Target}" TextWrapping="Wrap" />
                                                        <TextBlock Style="{StaticResource LabelText}" Text="Port" Margin="0,10,0,3" />
                                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastDiagnosis.LastPortTest.Port}" />
                                                        <TextBlock Style="{StaticResource LabelText}" Text="Remote address" Margin="0,10,0,3" />
                                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastDiagnosis.LastPortTest.RemoteAddress, TargetNullValue=Unknown}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Style="{StaticResource LabelText}" Text="Ping (ICMP)" />
                                                        <TextBlock Style="{StaticResource ValueText}"
                                                                   Text="{Binding LastDiagnosis.LastPortTest.PingSucceeded, StringFormat=Succeeded: {0}}" />
                                                        <TextBlock Style="{StaticResource LabelText}" Text="TCP connect" Margin="0,10,0,3" />
                                                        <TextBlock Style="{StaticResource ValueText}"
                                                                   Text="{Binding LastDiagnosis.LastPortTest.TcpSucceeded, StringFormat=Succeeded: {0}}" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Style="{StaticResource LabelText}" Text="Details" Margin="0,12,0,3" />
                                                <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastDiagnosis.LastPortTest.Details}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- ===== Core network tests (from last Quick Diagnosis) ===== -->
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Core Network Tests" FontSize="18" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"
                                                           Text="from last Quick Diagnosis" />
                                            </Grid>
                                            <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,4"
                                                    Visibility="{Binding HasNoDiagnosis, Converter={StaticResource BoolVisibility}}">
                                                <TextBlock Text="Run Quick Diagnosis to populate gateway, DNS and packet-loss checks."
                                                           Foreground="#64748B"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                            </Border>
                                            <ItemsControl Visibility="{Binding HasDiagnosis, Converter={StaticResource BoolVisibility}}">
                                                <ItemsControl.Resources>
                                                    <Style x:Key="MetricRow" TargetType="Grid">
                                                        <Setter Property="Margin" Value="0,0,0,10" />
                                                    </Style>
                                                </ItemsControl.Resources>
                                                <!-- Each metric: status dot + label + detail -->
                                                <Grid Style="{StaticResource MetricRow}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Top" Margin="0,4,0,0"
                                                             Fill="{Binding LastDiagnosis.Tests.Gateway.Status, Converter={StaticResource StatusBrush}}" />
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <TextBlock Text="Gateway" FontWeight="SemiBold" Foreground="#17212B" FontSize="13" />
                                                        <TextBlock Text="{Binding LastDiagnosis.Tests.Gateway.Details, TargetNullValue=Not tested - run Quick Diagnosis}" Foreground="#475569" FontSize="12" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Style="{StaticResource MetricRow}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Top" Margin="0,4,0,0"
                                                             Fill="{Binding LastDiagnosis.Tests.DnsServer.Status, Converter={StaticResource StatusBrush}}" />
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <TextBlock Text="DNS server" FontWeight="SemiBold" Foreground="#17212B" FontSize="13" />
                                                        <TextBlock Text="{Binding LastDiagnosis.Tests.DnsServer.Details, TargetNullValue=Not tested - run Quick Diagnosis}" Foreground="#475569" FontSize="12" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Style="{StaticResource MetricRow}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Top" Margin="0,4,0,0"
                                                             Fill="{Binding LastDiagnosis.Tests.DnsResolution.Status, Converter={StaticResource StatusBrush}}" />
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <TextBlock Text="DNS resolution" FontWeight="SemiBold" Foreground="#17212B" FontSize="13" />
                                                        <TextBlock Text="{Binding LastDiagnosis.Tests.DnsResolution.Details, TargetNullValue=Not tested - run Quick Diagnosis}" Foreground="#475569" FontSize="12" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Style="{StaticResource MetricRow}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Top" Margin="0,4,0,0"
                                                             Fill="{Binding LastDiagnosis.Tests.GatewayPacketLoss.Status, Converter={StaticResource StatusBrush}}" />
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <TextBlock Text="Gateway packet loss" FontWeight="SemiBold" Foreground="#17212B" FontSize="13" />
                                                        <TextBlock Text="{Binding LastDiagnosis.Tests.GatewayPacketLoss.Details, TargetNullValue=Not tested - run Quick Diagnosis}" Foreground="#475569" FontSize="12" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Top" Margin="0,4,0,0"
                                                             Fill="{Binding LastDiagnosis.Tests.InternetPacketLoss.Status, Converter={StaticResource StatusBrush}}" />
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <TextBlock Text="Internet packet loss" FontWeight="SemiBold" Foreground="#17212B" FontSize="13" />
                                                        <TextBlock Text="{Binding LastDiagnosis.Tests.InternetPacketLoss.Details, TargetNullValue=Not tested - run Quick Diagnosis}" Foreground="#475569" FontSize="12" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                              </StackPanel>
                            </Expander>

                            <!-- ===== Section 4: Repair Actions — the only place that CHANGES system state. ===== -->
                            <Expander IsExpanded="False" Margin="0,0,0,12" FontSize="15" FontWeight="SemiBold">
                              <Expander.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource HomeSectionIconBadge}" Background="#D97706"
                                            Width="26" Height="26" CornerRadius="7" Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource HomeSectionIcon}" FontSize="13" Text="&#xE90F;" />
                                    </Border>
                                    <TextBlock Text="Repair Actions" VerticalAlignment="Center" />
                                </StackPanel>
                              </Expander.Header>
                              <StackPanel Margin="0,8,0,0">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Network first aid" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="Unlike everything else on this page, these buttons CHANGE system state. Each action asks for confirmation when it can drop connectivity, reports exactly what it did, and is logged in the activity feed. Re-run Quick Diagnosis afterwards to confirm the fix."
                                                   Foreground="#475569" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,12" />

                                        <Border Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,12"
                                                Visibility="{Binding RepairActions.ShowAdminHint, Converter={StaticResource BoolVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#B45309" FontSize="14" VerticalAlignment="Center" />
                                                <TextBlock Text="Reset Winsock and Restart Adapter need administrator rights — use 'Restart as administrator' on Technician Home first."
                                                           Foreground="#92400E" FontSize="12.5" Margin="9,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <WrapPanel>
                                            <Button Style="{StaticResource HomeToolButton}" Command="{Binding RepairActions.FlushDnsCommand}"
                                                    ToolTip="Clears the local DNS resolver cache (Clear-DnsClientCache). Fixes stale records after server/DNS changes. No admin needed, no outage.">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE72C;" FontSize="15" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Flush DNS Cache" FontWeight="SemiBold" Foreground="White" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource HomeNetworkToolButton}" Command="{Binding RepairActions.RenewDhcpCommand}"
                                                    ToolTip="ipconfig /release + /renew. Requests a fresh DHCP lease — fixes APIPA (169.254.x.x) and stale-lease issues. Connectivity drops for a few seconds.">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE968;" FontSize="15" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Renew DHCP Lease" FontWeight="SemiBold" Foreground="White" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource HomeEventToolButton}" Command="{Binding RepairActions.ResetWinsockCommand}"
                                                    ToolTip="netsh winsock reset. Repairs corrupted socket registrations (often after malware or VPN removal). Needs administrator rights and a Windows restart.">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE90F;" FontSize="15" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Reset Winsock" FontWeight="SemiBold" Foreground="White" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource HomeStorageToolButton}" Command="{Binding RepairActions.RestartAdapterCommand}"
                                                    ToolTip="Restart-NetAdapter on the active adapter from the latest Quick Diagnosis. Re-negotiates link and DHCP — the classic fix for a stuck NIC. Needs administrator rights; the connection drops for several seconds.">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE895;" FontSize="15" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding RepairActions.RestartAdapterButtonText}" FontWeight="SemiBold" Foreground="White" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource DangerButton}" Command="{Binding RepairActions.CancelRepairCommand}" Margin="0,0,12,10" MinHeight="58"
                                                    Visibility="{Binding RepairActions.IsRepairRunning, Converter={StaticResource BoolVisibility}}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE711;" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Stop" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>

                                        <!-- Last repair outcome -->
                                        <Border Background="#F8FAFC" BorderBrush="#E2EAF6" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,4,0,0"
                                                Visibility="{Binding RepairActions.NoLastResult, Converter={StaticResource BoolVisibility}}">
                                            <TextBlock Text="No repair has been run yet. Results appear here with the exact outcome and any command output."
                                                       Foreground="#64748B" FontSize="12.5" TextWrapping="Wrap" />
                                        </Border>
                                        <Border BorderThickness="5,1,1,1" CornerRadius="8" Padding="14,12" Margin="0,4,0,0" Background="#FDFEFE"
                                                BorderBrush="{Binding RepairActions.LastResult.Severity, Converter={StaticResource StatusBrush}, FallbackValue=#E2EAF6}"
                                                Visibility="{Binding RepairActions.HasLastResult, Converter={StaticResource BoolVisibility}}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding RepairActions.LastResult.ActionName}" FontWeight="SemiBold" Foreground="#0F172A" />
                                                    <TextBlock Grid.Column="1" Text="{Binding RepairActions.LastResult.CompletedAtText}" Foreground="#94A3B8" FontSize="11.5" VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Text="{Binding RepairActions.LastResult.Summary}" Foreground="#334155" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                <Border Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,8,0,0"
                                                        Visibility="{Binding RepairActions.LastResult.RestartRequired, Converter={StaticResource BoolVisibility}, FallbackValue=Collapsed}">
                                                    <TextBlock Text="Restart Windows to complete this repair." Foreground="#92400E" FontSize="12" FontWeight="SemiBold" />
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding RepairActions.LastResult.OutputLines}" Margin="0,6,0,0"
                                                              Visibility="{Binding RepairActions.LastResult.HasOutputLines, Converter={StaticResource BoolVisibility}, FallbackValue=Collapsed}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" Foreground="#475569" FontSize="12" FontFamily="Consolas, Segoe UI" TextWrapping="Wrap" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                              </StackPanel>
                            </Expander>

                                </StackPanel>
                            </ScrollViewer>
                    </Grid>

                    <ScrollViewer Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Printers}" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-10,0">
                        <StackPanel>
                            <Border Style="{StaticResource ModuleHeroBanner}" Background="{StaticResource HeroBgPrinters}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource ModuleHeroChip}" Background="{StaticResource AccentPrinters}">
                                        <TextBlock Style="{StaticResource ModuleHeroIcon}" Text="🖨️" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource ModuleHeroTitle}" Text="Printers" />
                                        <TextBlock Style="{StaticResource ModuleHeroSubtitle}" Text="Local inventory, print server queues, safe IP scan, SNMP identity and queue installation." />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- Premium hero card: severity-colored border + verdict + chips + action bar. -->
                            <Border Style="{StaticResource Card}" BorderBrush="{Binding LastPrinterDiscovery.Severity, Converter={StaticResource StatusBrush}}" BorderThickness="5,1,1,1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{Binding LastPrinterDiscovery.Severity, Converter={StaticResource StatusBrush}}"
                                                       Text="{Binding LastPrinterDiscovery.Verdict, TargetNullValue=Printer tools ready. Choose an action below., FallbackValue=Printer tools ready. Choose an action below.}" />
                                            <WrapPanel Margin="0,8,0,0">
                                                <Border CornerRadius="10" Padding="10,4" Margin="0,0,8,6"
                                                        Background="{Binding LastPrinterDiscovery.Severity, Converter={StaticResource StatusBackgroundBrush}}">
                                                    <TextBlock FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{Binding LastPrinterDiscovery.Severity, Converter={StaticResource StatusBrush}}"
                                                               Text="{Binding LastPrinterDiscovery.Severity, StringFormat=Severity: {0}, TargetNullValue=Severity: —, FallbackValue=Severity: —}" />
                                                </Border>
                                                <Border CornerRadius="10" Padding="10,4" Margin="0,0,8,6" Background="#EEF2F7">
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475569"
                                                               Text="{Binding SelectedPrinterTarget, StringFormat=Target: {0}, TargetNullValue=Target: —, FallbackValue=Target: —}" />
                                                </Border>
                                                <Border CornerRadius="10" Padding="10,4" Margin="0,0,0,6" Background="#E0F2FE">
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#0369A1"
                                                               Text="{Binding LastPrinterDiscovery.Mode, StringFormat=Mode: {0}, TargetNullValue=Mode: —, FallbackValue=Mode: —}" />
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                                            <!-- Stop buttons surface here only while something runs; every other
                                                 action lives in its tab so it sits next to its own results. -->
                                            <Button Style="{StaticResource DangerButton}" Content="Stop Scan" Command="{Binding CancelPrinterScanCommand}" Margin="0,18,10,0" VerticalAlignment="Top"
                                                    Visibility="{Binding IsPrinterScanRunning, Converter={StaticResource BoolVisibility}}"
                                                    ToolTip="Cancel the running printer scan." />
                                            <Button Style="{StaticResource DangerButton}" Content="Stop SNMP" Command="{Binding CancelPrinterSnmpIdentifyCommand}" Margin="0,18,10,0" VerticalAlignment="Top"
                                                    Visibility="{Binding IsPrinterSnmpIdentifyRunning, Converter={StaticResource BoolVisibility}}"
                                                    ToolTip="Cancel SNMP auto-identify." />
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Style="{StaticResource LabelText}" Text="SNMP protocol" />
                                                <ComboBox ItemsSource="{Binding SnmpProtocols}" SelectedItem="{Binding SelectedSnmpProtocol}" Height="34" Width="160" />
                                            </StackPanel>
                                            <Button Style="{StaticResource PrimaryButtonPrinters}" Command="{Binding CopyPrinterSummaryCommand}" VerticalAlignment="Top" Margin="0,18,0,0"
                                                    ToolTip="Copy a plain-text printer summary (queues, scan, install result + remediation) to the clipboard.">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8C8;" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Copy for ticket" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <ProgressBar Margin="0,0,0,2" Height="3" IsIndeterminate="True" Background="Transparent" BorderThickness="0"
                                                 Foreground="{StaticResource AccentPrinters}"
                                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
                                </StackPanel>
                            </Border>

                            <TabControl>
                                <TabItem Header="Overview">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Network adapter snapshot" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Refresh Overview"
                                                        Command="{Binding DetectPrinterIpCommand}"
                                                        ToolTip="Refresh this PC's active IPv4 adapter, gateway and safe printer scan range." />
                                            </Grid>
                                            <UniformGrid Columns="4" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource LabelText}" Text="Detected IP" />
                                                    <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastPrinterDiscovery.LocalIpAddress, TargetNullValue=Unknown}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource LabelText}" Text="Adapter / Gateway" />
                                                    <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastPrinterDiscovery.LocalAdapterName, TargetNullValue=Unknown}" />
                                                    <TextBlock Foreground="#475569" FontSize="12" Text="{Binding LastPrinterDiscovery.Gateway, StringFormat=GW: {0}}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource LabelText}" Text="Detected subnet" />
                                                    <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastPrinterDiscovery.DetectedSubnet, TargetNullValue=Unknown}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource LabelText}" Text="Safe scan range" />
                                                    <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastPrinterDiscovery.SafeScanRange, TargetNullValue=Not detected}" />
                                                </StackPanel>
                                            </UniformGrid>
                                            <TextBlock Text="If multiple IPv4 default routes exist, select the adapter that represents your current LAN before running Auto Safe Scan." Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,8" />
                                            <ComboBox ItemsSource="{Binding PrinterNetworkAdapters}" SelectedItem="{Binding SelectedPrinterNetworkAdapter}" DisplayMemberPath="DisplayName" Height="34" />
                                        </StackPanel>
                                    </Border>
                                </TabItem>

                                <TabItem Header="Installed">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <Button Style="{StaticResource SecondaryButton}" Content="Refresh Installed Printers" Command="{Binding LoadLocalPrintersCommand}" Margin="0,0,10,0" ToolTip="Reload installed printer queues from this PC." />
                                                <Button Style="{StaticResource PrimaryButtonPrinters}" Content="★ Set as Default" Command="{Binding SetDefaultPrinterCommand}"
                                                        ToolTip="Make the selected installed queue the Windows default printer for the current user." />
                                            </StackPanel>
                                            <TextBlock Text="{Binding LastPrinterDiscovery.LocalSpoolerStatus, StringFormat=Local spooler: {0}, TargetNullValue=Local spooler: Unknown}" Foreground="#475569" Margin="0,0,0,8" />
                                            <DataGrid ItemsSource="{Binding LastPrinterDiscovery.LocalPrinters}" SelectedItem="{Binding SelectedLocalPrinter}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                                      MinHeight="240" MaxHeight="420"
                                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                                      ScrollViewer.VerticalScrollBarVisibility="Visible"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                      ScrollViewer.CanContentScroll="True"
                                                      EnableRowVirtualization="True"
                                                      EnableColumnVirtualization="True"
                                                      VirtualizingPanel.IsVirtualizing="True"
                                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="Default" Width="72">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="★" FontSize="15" Foreground="#F59E0B" HorizontalAlignment="Center"
                                                                           Visibility="{Binding IsDefault, Converter={StaticResource BoolVisibility}}"
                                                                           ToolTip="Current default printer" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                                    <DataGridTextColumn Header="Driver" Binding="{Binding DriverName}" Width="220" />
                                                    <DataGridTextColumn Header="Port" Binding="{Binding PortName}" Width="140" />
                                                    <DataGridTextColumn Header="Port IP" Binding="{Binding PortHostAddress}" Width="120" />
                                                    <DataGridTextColumn Header="Status" Binding="{Binding PrinterStatus}" Width="120" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <TextBlock Text="Tip: select a row, then 'Set as Default'. The ★ marks the current default." Foreground="#94A3B8" FontSize="11" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>
                                </TabItem>

                                <TabItem Header="Print Server">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelText}" Text="Print server" />
                                            <TextBox Text="{Binding PrintServerName, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,7" BorderBrush="#BFCFE5" Margin="0,0,0,8" />
                                            <WrapPanel Margin="0,0,0,10">
                                                <Button Style="{StaticResource PrimaryButtonPrinters}" Content="Auto-detect Server" Command="{Binding DetectPrintServerCommand}" Margin="0,0,10,0" ToolTip="Finds the print server by itself: first from installed shared connections on this PC, then from print servers published in Active Directory (domain PCs)." />
                                                <Button Style="{StaticResource SecondaryButton}" Content="Discover Print Server" Command="{Binding DiscoverPrintServerCommand}" ToolTip="Find the print server hosting shared queues (UNC \\server\share lookup)" />
                                            </WrapPanel>
                                            <TextBlock Text="{Binding LastPrinterDiscovery.PrintServerSpoolerStatus, StringFormat=Print server spooler: {0}, TargetNullValue=Print server spooler: Unknown}" Foreground="#475569" Margin="0,0,0,8" />
                                            <DataGrid ItemsSource="{Binding LastPrinterDiscovery.Printers}" SelectedItem="{Binding SelectedPrintServerPrinter}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                                      MinHeight="260" MaxHeight="440"
                                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                                      ScrollViewer.VerticalScrollBarVisibility="Visible"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                      ScrollViewer.CanContentScroll="True"
                                                      EnableRowVirtualization="True"
                                                      EnableColumnVirtualization="True"
                                                      VirtualizingPanel.IsVirtualizing="True"
                                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                                    <DataGridTextColumn Header="Share" Binding="{Binding ShareName}" Width="140" />
                                                    <DataGridTextColumn Header="Driver" Binding="{Binding DriverName}" Width="220" />
                                                    <DataGridTextColumn Header="Port" Binding="{Binding PortName}" Width="140" />
                                                    <DataGridTextColumn Header="Port IP" Binding="{Binding PortHostAddress}" Width="120" />
                                                    <DataGridTextColumn Header="Installable" Binding="{Binding Installable}" Width="90" />
                                                    <DataGridTextColumn Header="Status" Binding="{Binding PrinterStatus}" Width="120" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                </TabItem>

                                <TabItem Header="IP Scan">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <WrapPanel Margin="0,0,0,10">
                                                <Button Style="{StaticResource SecondaryButton}" Content="Detect My IP" Command="{Binding DetectPrinterIpCommand}" Margin="0,0,10,8" ToolTip="Detect this PC's gateway and propose a safe scan range" />
                                                <Button Style="{StaticResource SecondaryButton}" Content="Auto Safe Scan" Command="{Binding ScanPrintersCommand}" Margin="0,0,10,8" ToolTip="Scan the local /24 subnet (capped at 254 hosts)" />
                                                <Button Style="{StaticResource SecondaryButton}" Content="Auto SNMP Identify" Command="{Binding AutoIdentifyScannedPrintersSnmpCommand}" Margin="0,0,10,8" ToolTip="Confirm scanned candidates using real SNMP identity data." />
                                                <TextBox Text="{Binding PrinterScanRange, UpdateSourceTrigger=PropertyChanged}" Width="260" Height="36" Padding="10,7" BorderBrush="#BFCFE5" Margin="0,0,10,8" />
                                                <Button Style="{StaticResource SecondaryButton}" Content="Scan Custom Range" Command="{Binding ScanPrinterRangeCommand}" Margin="0,0,0,8" ToolTip="Scan a specific range (CIDR /24 max, or 'start-end'). /16 is rejected." />
                                                <Button Style="{StaticResource DangerButton}" Content="Stop Scan" Command="{Binding CancelPrinterScanCommand}" Margin="10,0,0,8"
                                                        Visibility="{Binding IsPrinterScanRunning, Converter={StaticResource BoolVisibility}}"
                                                        ToolTip="Cancel the active printer IP scan." />
                                                <Button Style="{StaticResource DangerButton}" Content="Remove Selected" Command="{Binding RemoveSelectedPrinterScanResultCommand}" Margin="10,0,0,8" ToolTip="Remove the selected scanned/SNMP row from the current printer session." />
                                            </WrapPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Custom range accepts single IP, CIDR up to 254 hosts, or explicit range. /16 is intentionally rejected." Foreground="#475569" FontSize="12" TextWrapping="Wrap" />
                                                <CheckBox Grid.Column="1" Content="Only printers" IsChecked="{Binding ShowOnlyPrinters}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                          ToolTip="Hide rows SNMP identified as non-printers (switches, NAS, UPS). Scanning already targets only printer ports 9100/515/631." />
                                            </Grid>
                                            <TextBlock Text="{Binding HiddenScanResultCountText}" Foreground="#B45309" FontSize="12" Margin="0,0,0,6"
                                                       Visibility="{Binding HasHiddenScanResults, Converter={StaticResource BoolVisibility}}" />
                                            <DataGrid ItemsSource="{Binding FilteredScanResults}" SelectedItem="{Binding SelectedPrinterScanResult}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                                      MinHeight="240" MaxHeight="420"
                                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                                      ScrollViewer.VerticalScrollBarVisibility="Visible"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                      ScrollViewer.CanContentScroll="True"
                                                      EnableRowVirtualization="True"
                                                      EnableColumnVirtualization="True"
                                                      VirtualizingPanel.IsVirtualizing="True"
                                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="IP" Binding="{Binding Address}" Width="130" />
                                                    <DataGridTextColumn Header="Hostname" Binding="{Binding HostName}" Width="*" />
                                                    <DataGridTextColumn Header="Open Ports" Binding="{Binding Details}" Width="150" />
                                                    <DataGridTextColumn Header="Classification" Binding="{Binding Classification}" Width="170" />
                                                    <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="90" />
                                                    <DataGridTextColumn Header="SNMP Status" Binding="{Binding SnmpStatus}" Width="150" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                </TabItem>

                                <TabItem Header="SNMP">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                                <StackPanel Margin="0,0,8,0">
                                                    <TextBlock Style="{StaticResource LabelText}" Text="Printer target / IP" />
                                                    <TextBox Text="{Binding PrinterTarget, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,7" BorderBrush="#BFCFE5" />
                                                    <ComboBox ItemsSource="{Binding RecentPrinterTargets}" SelectedItem="{Binding PrinterTarget}" Height="32" Margin="0,6,0,0" />
                                                </StackPanel>
                                                <StackPanel Margin="8,0,0,0">
                                                    <TextBlock Style="{StaticResource LabelText}" Text="SNMP protocol" />
                                                    <ComboBox ItemsSource="{Binding SnmpProtocols}" SelectedItem="{Binding SelectedSnmpProtocol}" Height="36" />
                                                </StackPanel>
                                            </UniformGrid>

                                            <StackPanel Visibility="{Binding IsSnmpV2Selected, Converter={StaticResource BoolVisibility}}">
                                                <TextBlock Style="{StaticResource LabelText}" Text="SNMP v2c community" />
                                                <TextBox Text="{Binding SnmpCommunity, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,7" BorderBrush="#BFCFE5" Width="260" HorizontalAlignment="Left" />
                                            </StackPanel>

                                            <Grid Visibility="{Binding IsSnmpV3Selected, Converter={StaticResource BoolVisibility}}" Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <TextBlock Style="{StaticResource LabelText}" Text="SNMPv3 username" />
                                                    <TextBox Text="{Binding SnmpV3UserName, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,7" BorderBrush="#BFCFE5" />
                                                    <TextBlock Style="{StaticResource LabelText}" Text="Auth protocol" Margin="0,8,0,3" />
                                                    <ComboBox ItemsSource="{Binding SnmpAuthProtocols}" SelectedItem="{Binding SnmpV3AuthProtocol}" Height="34" />
                                                    <TextBlock Style="{StaticResource LabelText}" Text="Auth password" Margin="0,8,0,3" />
                                                    <PasswordBox PasswordChanged="SnmpAuthPasswordChanged" Height="36" Padding="10,7" BorderBrush="#BFCFE5" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                    <TextBlock Style="{StaticResource LabelText}" Text="Privacy protocol" />
                                                    <ComboBox ItemsSource="{Binding SnmpPrivacyProtocols}" SelectedItem="{Binding SnmpV3PrivacyProtocol}" Height="34" />
                                                    <TextBlock Style="{StaticResource LabelText}" Text="Privacy password" Margin="0,8,0,3" />
                                                    <PasswordBox PasswordChanged="SnmpPrivacyPasswordChanged" Height="36" Padding="10,7" BorderBrush="#BFCFE5" />
                                                    <CheckBox Content="Save credentials securely for this Windows user" IsChecked="{Binding SaveSnmpCredentials}" Margin="0,10,0,0" />
                                                    <TextBlock Text="{Binding HasSavedSnmpCredentials, StringFormat=Saved credential available: {0}}" Foreground="#475569" FontSize="12" Margin="0,6,0,0" />
                                                    <Button Style="{StaticResource SecondaryButton}" Content="Forget Saved SNMPv3 Credentials" Command="{Binding ForgetSnmpCredentialCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" ToolTip="Remove the encrypted SNMPv3 credential stored on this PC (DPAPI)" />
                                                </StackPanel>
                                            </Grid>

                                            <WrapPanel Margin="0,14,0,10">
                                                <Button Style="{StaticResource PrimaryButtonPrinters}" Content="Identify Selected Target via SNMP" Command="{Binding IdentifySelectedPrinterSnmpCommand}" Margin="0,0,10,0" />
                                                <Button Style="{StaticResource SecondaryButton}" Content="Auto Identify Scanned" Command="{Binding AutoIdentifyScannedPrintersSnmpCommand}" Margin="0,0,10,0" ToolTip="Run SNMP identity checks on scanned candidates and confirm real printers." />
                                                <Button Style="{StaticResource DangerButton}" Content="Stop SNMP" Command="{Binding CancelPrinterSnmpIdentifyCommand}" Margin="0,0,10,0"
                                                        Visibility="{Binding IsPrinterSnmpIdentifyRunning, Converter={StaticResource BoolVisibility}}"
                                                        ToolTip="Cancel SNMP auto-identify." />
                                                <Button Style="{StaticResource DangerButton}" Content="Remove Selected" Command="{Binding RemoveSelectedPrinterScanResultCommand}" ToolTip="Remove the selected SNMP/scanned row from the current printer session." />
                                            </WrapPanel>
                                            <DataGrid ItemsSource="{Binding FilteredScanResults}" SelectedItem="{Binding SelectedPrinterScanResult}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                                      MinHeight="180" MaxHeight="340"
                                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                                      ScrollViewer.VerticalScrollBarVisibility="Visible"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                      ScrollViewer.CanContentScroll="True"
                                                      EnableRowVirtualization="True"
                                                      EnableColumnVirtualization="True"
                                                      VirtualizingPanel.IsVirtualizing="True"
                                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="IP" Binding="{Binding Address}" Width="120" />
                                                    <DataGridTextColumn Header="SNMP Status" Binding="{Binding SnmpStatus}" Width="150" />
                                                    <DataGridTextColumn Header="SNMP Name" Binding="{Binding SnmpInfo.SysName}" Width="140" />
                                                    <DataGridTextColumn Header="Printer Name" Binding="{Binding SnmpInfo.PrinterName}" Width="160" />
                                                    <DataGridTextColumn Header="Serial" Binding="{Binding SnmpInfo.PrinterSerialNumber}" Width="150" />
                                                    <DataGridTextColumn Header="Model / Description" Binding="{Binding SnmpInfo.SysDescr}" Width="220" />
                                                    <DataGridTextColumn Header="Supplies" Binding="{Binding SnmpInfo.SuppliesSummary}" Width="220" />
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <!-- ===== Premium SNMP detail: toner bars + page count + active alerts ===== -->
                                            <Border CornerRadius="8" Padding="16" Margin="0,12,0,0" Background="#0F172A"
                                                    Visibility="{Binding SelectedPrinterScanResult.SnmpInfo, Converter={StaticResource NullToVisibility}}">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#F1F5F9" TextWrapping="Wrap"
                                                                       Text="{Binding SelectedPrinterScanResult.SnmpInfo.PrinterName, TargetNullValue=SNMP device, FallbackValue=SNMP device}" />
                                                            <TextBlock FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,0"
                                                                       Text="{Binding SelectedPrinterScanResult.SnmpInfo.SysDescr}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                                            <Border CornerRadius="9" Padding="9,3" Margin="0,0,6,0" Background="#1E293B">
                                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"
                                                                           Text="{Binding SelectedPrinterScanResult.SnmpInfo.PrinterStatus, StringFormat=Status: {0}, TargetNullValue=Status: —, FallbackValue=Status: —}" />
                                                            </Border>
                                                            <Border CornerRadius="9" Padding="9,3" Background="#1E293B"
                                                                    Visibility="{Binding SelectedPrinterScanResult.SnmpInfo.HasPageCount, Converter={StaticResource BoolVisibility}}">
                                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#A7F3D0"
                                                                           Text="{Binding SelectedPrinterScanResult.SnmpInfo.PageCountText}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Toner / supplies bars -->
                                                    <ItemsControl ItemsSource="{Binding SelectedPrinterScanResult.SnmpInfo.Supplies}" Margin="0,12,0,0"
                                                                  Visibility="{Binding SelectedPrinterScanResult.SnmpInfo.HasSupplies, Converter={StaticResource BoolVisibility}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,0,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="190" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="56" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#CBD5E1" FontSize="12"
                                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                                    <Border Grid.Column="1" Height="14" CornerRadius="7" Background="#1E293B" HorizontalAlignment="Stretch">
                                                                        <Border Height="14" CornerRadius="7" HorizontalAlignment="Left"
                                                                                Width="{Binding BarWidth}"
                                                                                Background="{Binding ColorHex}" />
                                                                    </Border>
                                                                    <TextBlock Grid.Column="2" Text="{Binding LevelText}" FontSize="12" FontWeight="SemiBold"
                                                                               Foreground="#F1F5F9" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- Active alerts -->
                                                    <Border CornerRadius="6" Padding="10,8" Margin="0,4,0,0" Background="#422006" BorderBrush="#B45309" BorderThickness="1"
                                                            Visibility="{Binding SelectedPrinterScanResult.SnmpInfo.HasAlerts, Converter={StaticResource BoolVisibility}, FallbackValue=Collapsed}">
                                                        <StackPanel>
                                                            <TextBlock Text="⚠ Active alerts" FontSize="12" FontWeight="SemiBold" Foreground="#FBBF24" Margin="0,0,0,4" />
                                                            <ItemsControl ItemsSource="{Binding SelectedPrinterScanResult.SnmpInfo.ActiveAlerts}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding StringFormat=• {0}}" Foreground="#FDE68A" FontSize="12" TextWrapping="Wrap" Margin="0,1,0,1" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </TabItem>

                                <TabItem Header="Install">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Install works only for a selected shared print server queue. It adds the queue to this PC using Windows Point and Print policy." Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,10" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding SelectedPrintServerPrinter.ConnectionName, TargetNullValue=No queue selected}" Margin="0,0,0,8" />
                                            <CheckBox Content="I confirm installing the selected shared queue on this PC" IsChecked="{Binding ConfirmPrinterInstall}" Margin="0,0,0,6" />
                                            <CheckBox Content="Set the installed queue as the Windows default printer" IsChecked="{Binding SetDefaultAfterInstall}" Margin="0,0,0,10"
                                                      ToolTip="Optional: right after a successful install, make the new queue the default printer for the current user." />
                                            <Button Style="{StaticResource PrimaryButtonPrinters}" Content="Install Selected Queue" Command="{Binding InstallSelectedPrinterQueueCommand}" HorizontalAlignment="Left" Margin="0,0,0,10" />

                                            <!-- Premium install result card: severity badge + verdict + remediation hint. -->
                                            <Border CornerRadius="8" Padding="14,12" Margin="0,0,0,10"
                                                    Background="#F8FAFC" BorderThickness="5,1,1,1"
                                                    BorderBrush="{Binding LastPrinterDiscovery.LastInstall.Severity, Converter={StaticResource StatusBrush}}"
                                                    Visibility="{Binding LastPrinterDiscovery.LastInstall, Converter={StaticResource NullToVisibility}}">
                                                <StackPanel>
                                                    <WrapPanel>
                                                        <Border CornerRadius="10" Padding="10,4" Margin="0,0,8,4"
                                                                Background="{Binding LastPrinterDiscovery.LastInstall.Severity, Converter={StaticResource StatusBackgroundBrush}}">
                                                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{Binding LastPrinterDiscovery.LastInstall.Severity, Converter={StaticResource StatusBrush}}"
                                                                       Text="{Binding LastPrinterDiscovery.LastInstall.Category, StringFormat=Category: {0}, TargetNullValue=Category: —}" />
                                                        </Border>
                                                        <Border CornerRadius="10" Padding="10,4" Margin="0,0,0,4" Background="#EEF2F7">
                                                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475569"
                                                                       Text="{Binding LastPrinterDiscovery.LastInstall.Severity, StringFormat=Severity: {0}, TargetNullValue=Severity: —}" />
                                                        </Border>
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding LastPrinterDiscovery.LastInstall.Verdict}" FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap" Margin="0,8,0,0" />
                                                    <TextBlock Text="{Binding LastPrinterDiscovery.LastInstall.ConnectionName, StringFormat=Queue: {0}}" Foreground="#475569" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding LastPrinterDiscovery.LastInstall.Error}" Foreground="#B91C1C" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                                               Visibility="{Binding LastPrinterDiscovery.LastInstall.Error, Converter={StaticResource NullToVisibility}}" />
                                                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
                                                        <TextBlock TextWrapping="Wrap" Foreground="#1E40AF" FontSize="12">
                                                            <Run Text="Next step:" FontWeight="SemiBold" />
                                                            <Run Text="{Binding LastPrinterDiscovery.LastInstall.Remediation, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="No install attempted in this session yet." Foreground="#94A3B8" FontSize="12" Margin="0,0,0,8"
                                                       Visibility="{Binding LastPrinterDiscovery.LastInstall, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
                                            <DataGrid ItemsSource="{Binding LastPrinterDiscovery.Printers}" SelectedItem="{Binding SelectedPrintServerPrinter}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                                      MinHeight="220" MaxHeight="360"
                                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                                      ScrollViewer.VerticalScrollBarVisibility="Visible"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                      ScrollViewer.CanContentScroll="True"
                                                      EnableRowVirtualization="True"
                                                      EnableColumnVirtualization="True"
                                                      VirtualizingPanel.IsVirtualizing="True"
                                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Queue" Binding="{Binding Name}" Width="*" />
                                                    <DataGridTextColumn Header="Connection" Binding="{Binding ConnectionName}" Width="220" />
                                                    <DataGridTextColumn Header="Driver" Binding="{Binding DriverName}" Width="220" />
                                                    <DataGridTextColumn Header="Installable" Binding="{Binding Installable}" Width="90" />
                                                    <DataGridTextColumn Header="Install Status" Binding="{Binding InstallStatus}" Width="140" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                </TabItem>
                            </TabControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=TargetedTests}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
