                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelText}" Text="Owner suggestion" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding TestResultOwner}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelText}" Text="Confidence" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding TestResultConfidence}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelText}" Text="Severity" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding TestResultSeverity}" Foreground="{Binding TestResultSeverity, Converter={StaticResource StatusBrush}}" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <UniformGrid Columns="2" Margin="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelText}" Text="Input" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding TestResultInput}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelText}" Text="Baseline" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding TestResultBaseline}" />
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Visibility="{Binding HasTestResult, Converter={StaticResource BoolVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Test Steps" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <TextBlock Text="No test steps were produced for this result." Foreground="#475569" TextWrapping="Wrap" Visibility="{Binding HasNoTestSteps, Converter={StaticResource BoolVisibility}}" />
                                    <ItemsControl ItemsSource="{Binding TestSteps}" Visibility="{Binding HasTestSteps, Converter={StaticResource BoolVisibility}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F2F7FD" BorderBrush="{Binding Status, Converter={StaticResource StatusBrush}}" BorderThickness="4,1,1,1" CornerRadius="8" Padding="12" Margin="0,0,12,12">
