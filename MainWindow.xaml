            <GradientStop Color="#A855F7" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DiagnosisSnapshotButtonBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0EA5E9" Offset="0" />
            <GradientStop Color="#0284C7" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DiagnosisSnapshotButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
