        <!-- Slim usage bar for volume rows on Technician Home. PART_Track / PART_Indicator are
             the named parts ProgressBar requires to size the filled portion automatically;
             Foreground carries the severity colour from StatusBrush. -->
        <Style x:Key="VolumeUsageBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#E8EDF5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4"
                                    HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact in-tile action: relaunch elevated. Amber = "action recommended",
             matching the Warning severity the tile shows when the app is not elevated. -->
        <LinearGradientBrush x:Key="HomeElevateButtonBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F59E0B" Offset="0" />
            <GradientStop Color="#D97706" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HomeElevateButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FBBF24" Offset="0" />
            <GradientStop Color="#F59E0B" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="HomeElevateButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource HomeElevateButtonBrush}" />
            <Setter Property="Tag" Value="{StaticResource HomeElevateButtonHoverBrush}" />
            <Setter Property="BorderBrush" Value="#B45309" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <!-- Custom-chrome window control buttons — each is a separate 3D pill (rounded
             rectangle with subtle gradient, border and drop shadow) so they read as proper
             buttons rather than a flat strip. The icons use Segoe MDL2 Assets which ships
             with every modern Windows. -->
        <Style x:Key="WindowChromeButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFF" Offset="0" />
                        <GradientStop Color="#E2E8F0" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Border.Effect>
                                <DropShadowEffect Color="#475569" Direction="270" ShadowDepth="1" BlurRadius="3" Opacity="0.22" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#F1F5F9" Offset="0" />
                                            <GradientStop Color="#CBD5E1" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Effect" Value="{x:Null}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact information button used in the main header. -->
        <Style x:Key="HeaderInfoButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#38BDF8" Offset="0" />
                        <GradientStop Color="#0284C7" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#0369A1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17">
                            <Border.Effect>
                                <DropShadowEffect Color="#0369A1" Direction="270" ShadowDepth="1" BlurRadius="5" Opacity="0.35" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#7DD3FC" Offset="0" />
                                            <GradientStop Color="#0EA5E9" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0F172A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Effect" Value="{x:Null}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close button: red pill treatment for the destructive window action. -->
        <Style x:Key="WindowChromeCloseButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#EF4444" Offset="0" />
                        <GradientStop Color="#DC2626" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#B91C1C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Border.Effect>
                                <DropShadowEffect Color="#7F1D1D" Direction="270" ShadowDepth="1" BlurRadius="4" Opacity="0.45" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#F87171" Offset="0" />
                                            <GradientStop Color="#EF4444" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#DC2626" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Effect" Value="{x:Null}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Custom title bar. -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0F172A" />

            <!-- Product identity. -->
            <Border Grid.Column="1" Background="#EBF3FC">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Ellipse Width="8" Height="8" Margin="0,0,11,0" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3B82F6" Offset="0" />
                                <GradientStop Color="#8B5CF6" Offset="1" />
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#3B82F6" ShadowDepth="0" BlurRadius="6" Opacity="0.35" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="ISG Desk" VerticalAlignment="Center"
                               FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                               Foreground="#1E293B" />
                    <Rectangle Width="1" Height="13" Fill="#CBD5E1" Margin="12,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Text="IT Support &amp; Network Diagnostics" VerticalAlignment="Center"
                               FontFamily="Segoe UI" FontSize="11.5" Foreground="#64748B" />
                </StackPanel>
            </Border>

            <!-- Window controls. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Background="#EBF3FC"
                        VerticalAlignment="Center" Margin="6,0,0,0">
                <Button Click="OnMinimizeClick" Style="{StaticResource WindowChromeButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="Minimize" Content="&#xE921;" />
                <Button Click="OnMaximizeClick" Style="{StaticResource WindowChromeButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="Maximize / Restore" Content="&#xE922;" />
                <Button Click="OnCloseClick" Style="{StaticResource WindowChromeCloseButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="Close" Content="&#xE8BB;" />
            </StackPanel>
        </Grid>

        <!-- Sidebar. -->
        <Border Grid.Row="1" Grid.Column="0" Background="#0F172A">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          PanningMode="VerticalOnly">
                <Grid Margin="14,0,14,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <!--
                        Brand header — logo-light.png is now a square 1254×1254 app-icon (with
                        its own rounded silver frame baked in), so we render it as a square card
                        that fills with the image via ImageBrush. No surrounding card bg = no
                        colour seam possible. CornerRadius clips the PNG's square corners and the
                        sidebar bg shows through behind the clipped area. The 3D feel comes from
                        the rounded shape + drop shadow.
                        Wrapped in a transparent button so clicking opens the About dialog.
                    -->
                    <Button Click="OnLogoClick" Cursor="Hand" Background="Transparent"
                            BorderThickness="0" Padding="0" Margin="0,2,0,12"
                            HorizontalAlignment="Center"
                            Width="152" Height="152"
                            ToolTip="About ISG Desk">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="OuterFrame"
                                        CornerRadius="26"
                                        Padding="4"
                                        BorderBrush="#D7E5F5"
                                        BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#F8FAFC" Offset="0" />
                                            <GradientStop Color="#AFC4DD" Offset="0.58" />
                                            <GradientStop Color="#38BDF8" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#020617" Direction="270" ShadowDepth="4" BlurRadius="20" Opacity="0.55" />
                                    </Border.Effect>
                                    <Border x:Name="Frame"
                                            CornerRadius="22"
                                            BorderBrush="#23354D"
                                            BorderThickness="1"
                                            SnapsToDevicePixels="True">
                                        <Border.Background>
                                            <ImageBrush ImageSource="/Assets/logo-light.png" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="OuterFrame" Property="BorderBrush" Value="#7DD3FC" />
                                        <Setter TargetName="OuterFrame" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#0284C7" Direction="270" ShadowDepth="5" BlurRadius="24" Opacity="0.58" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!--
                        Each nav button uses a 3-column Grid: icon | label | severity dot.
                        The dot's Fill is taken from the Navigation*Severity properties
                        (StatusBrush converter); it stays Collapsed until the module produces
                        an actual measurement (StatusKnownToVisibility converter — Unknown is hidden).
                    -->
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="TechnicianHome" Tag="{StaticResource NavActiveTechnicianHome}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource NavIconBadge}">
                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE80F;" ToolTip="Technician Home" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Technician Home" VerticalAlignment="Center" />
                            <Ellipse Grid.Column="2" Width="8" Height="8" Margin="8,0,0,0" VerticalAlignment="Center"
                                     Fill="{Binding LastDiagnosis.Verdict.Severity, Converter={StaticResource StatusBrush}}"
                                     Visibility="{Binding LastDiagnosis.Verdict.Severity, Converter={StaticResource StatusKnownToVisibility}}" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Diagnosis" Tag="{StaticResource NavActiveDiagnosis}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource NavIconBadge}">
                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE9D9;" ToolTip="Diagnosis" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Diagnosis" VerticalAlignment="Center" />
                            <Ellipse Grid.Column="2" Width="8" Height="8" Margin="8,0,0,0" VerticalAlignment="Center"
                                     Fill="{Binding NavigationDiagnosisSeverity, Converter={StaticResource StatusBrush}}"
                                     Visibility="{Binding NavigationDiagnosisSeverity, Converter={StaticResource StatusKnownToVisibility}}" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="TargetedTests" Tag="{StaticResource NavActiveTargetedTests}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource NavIconBadge}">
                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE8F1;" ToolTip="Targeted Tests" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Targeted Tests" VerticalAlignment="Center" />
                            <Ellipse Grid.Column="2" Width="8" Height="8" Margin="8,0,0,0" VerticalAlignment="Center"
                                     Fill="{Binding NavigationTargetedTestsSeverity, Converter={StaticResource StatusBrush}}"
                                     Visibility="{Binding NavigationTargetedTestsSeverity, Converter={StaticResource StatusKnownToVisibility}}" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Printers" Tag="{StaticResource NavActivePrinters}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource NavIconBadge}">
                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE749;" ToolTip="Printers" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Printers" VerticalAlignment="Center" />
                            <Ellipse Grid.Column="2" Width="8" Height="8" Margin="8,0,0,0" VerticalAlignment="Center"
                                     Fill="{Binding NavigationPrintersSeverity, Converter={StaticResource StatusBrush}}"
                                     Visibility="{Binding NavigationPrintersSeverity, Converter={StaticResource StatusKnownToVisibility}}" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="NetworkDevices" Tag="{StaticResource NavActiveNetworkDevices}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource NavIconBadge}">
                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE968;" ToolTip="Network Devices" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Network Devices" VerticalAlignment="Center" />
                            <Ellipse Grid.Column="2" Width="8" Height="8" Margin="8,0,0,0" VerticalAlignment="Center"
                                     Fill="{Binding NavigationNetworkDevicesSeverity, Converter={StaticResource StatusBrush}}"
                                     Visibility="{Binding NavigationNetworkDevicesSeverity, Converter={StaticResource StatusKnownToVisibility}}" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Wifi" Tag="{StaticResource NavActiveWifi}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource NavIconBadge}">
                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE701;" ToolTip="Wi-Fi Analyzer" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Wi-Fi Analyzer" VerticalAlignment="Center" />
                            <Ellipse Grid.Column="2" Width="8" Height="8" Margin="8,0,0,0" VerticalAlignment="Center"
                                     Fill="{Binding NavigationWifiSeverity, Converter={StaticResource StatusBrush}}"
                                     Visibility="{Binding NavigationWifiSeverity, Converter={StaticResource StatusKnownToVisibility}}" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Reports" Tag="{StaticResource NavActiveReports}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource NavIconBadge}">
                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE8A5;" ToolTip="Reports" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Reports" VerticalAlignment="Center" />
                            <Ellipse Grid.Column="2" Width="8" Height="8" Margin="8,0,0,0" VerticalAlignment="Center"
                                     Fill="{Binding NavigationReportsSeverity, Converter={StaticResource StatusBrush}}"
                                     Visibility="{Binding NavigationReportsSeverity, Converter={StaticResource StatusKnownToVisibility}}" />
                        </Grid>
                    </Button>
                </StackPanel>

                <!--
                    Live Monitor panel — premium framing:
                      • Header with brand title + "LIVE" pulsing chip + refresh hint
                      • Section labels (NETWORK / ACTIVITY) act as visual anchors so future
                        signals (Internet / DNS / CPU / RAM) drop in without redesign.
                      • Refined card: slate-900 surface, subtle blue border, layered shadow.
                -->
                <Border Grid.Row="1"
                        Background="#111C2E"
                        BorderBrush="#1E2D45" BorderThickness="1"
                        CornerRadius="10" Padding="14,12,14,14"
                        Margin="0,16,0,0"
                        VerticalAlignment="Top">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.45" />
                    </Border.Effect>
                    <StackPanel>
                        <!-- Header: title + LIVE chip + tiny refresh hint -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE9F9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           Foreground="#3B82F6" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"
                                           ToolTip="Always-on live monitoring" />
                                <TextBlock Text="LIVE MONITOR" Foreground="#CBD5E1" FontSize="10" FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- Honest state chip: green LIVE only while the monitor samples; gray OFF otherwise. -->
                            <Border Grid.Column="1" Background="#10271C" CornerRadius="4" Padding="6,2"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding StatusMonitor.IsRunning, Converter={StaticResource BoolVisibility}}"
                                    ToolTip="Gateway monitor is sampling every 2 seconds">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="5" Height="5" Fill="#22C55E" VerticalAlignment="Center" />
                                    <TextBlock Text="LIVE" Foreground="#4ADE80" FontSize="9" FontWeight="Bold"
                                               Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#1B2335" CornerRadius="4" Padding="6,2"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding StatusMonitorOffline, Converter={StaticResource BoolVisibility}}"
                                    ToolTip="Monitor idle - no default gateway detected yet. It starts automatically when a network appears.">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="5" Height="5" Fill="#64748B" VerticalAlignment="Center" />
                                    <TextBlock Text="OFF" Foreground="#94A3B8" FontSize="9" FontWeight="Bold"
                                               Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ===== NETWORK section ===== -->
                        <TextBlock Text="NETWORK" Foreground="#64748B" FontSize="9" FontWeight="Bold"
                                   Margin="0,0,0,8" />

                        <!-- Gateway row: status dot + label + target IP -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center"
                                     Fill="{Binding StatusMonitor.LastStatus, Converter={StaticResource StatusBrush}}" />
                            <TextBlock Grid.Column="1" Text="Gateway" Foreground="#E2E8F0" FontSize="11.5"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding StatusMonitor.CurrentTarget, FallbackValue=detecting...}"
                                       Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="110" />
                        </Grid>
                        <!-- Latency + loss. LossDisplay says "waiting for samples" until data exists. -->
                        <TextBlock Foreground="#D6E3F1" FontSize="11.5" Margin="0,0,0,6"
                                   ToolTip="{Binding StatusMonitor.Summary.TooltipText}">
                            <Run Text="{Binding StatusMonitor.LastLatencyMs, Mode=OneWay, StringFormat={}{0:N0} ms, FallbackValue=- ms, TargetNullValue=- ms}" FontWeight="SemiBold" />
                            <Run Text="  -  " Foreground="#475569" />
                            <Run Text="{Binding StatusMonitor.Summary.LossDisplay, Mode=OneWay, FallbackValue=waiting for samples}" Foreground="#94A3B8" />
                        </TextBlock>
                        <!-- Sparkline: full-width inside padding, with subtle inner border -->
                        <Border Background="#0A1424" BorderBrush="#1E2D45" BorderThickness="1"
                                CornerRadius="4" Height="28" HorizontalAlignment="Stretch"
                                ToolTip="{Binding StatusMonitor.Summary.TooltipText}">
                            <Canvas ClipToBounds="True">
                                <Polyline Points="{Binding StatusMonitor.SparklinePoints}"
                                          Stroke="#3B82F6"
                                          StrokeThickness="1.5"
                                          StrokeLineJoin="Round" />
                            </Canvas>
                        </Border>

                        <!-- 2) Running indicator (visible while IsBusy). -->
                        <StackPanel Margin="0,14,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}">
                            <Border Height="1" Background="#1E2D45" Margin="0,0,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           Foreground="#FCD34D" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="Running" Foreground="#FCD34D" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#D6E3F1" FontSize="11"
                                       TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                        </StackPanel>

                        <!-- 3) Last activity entry. -->
                        <StackPanel Margin="0,14,0,0" Visibility="{Binding Activity.LastEntry, Converter={StaticResource NullToVisibility}}">
                            <Border Height="1" Background="#1E2D45" Margin="0,0,0,10" />
                            <TextBlock Text="ACTIVITY" Foreground="#64748B" FontSize="9" FontWeight="Bold"
                                       Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="&#xE823;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           Foreground="#94A3B8" FontSize="11" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Activity.LastEntry.Timestamp, StringFormat='Last {0:HH:mm:ss}'}"
                                           Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding Activity.LastEntry.Message}" Foreground="#BFCFE5" FontSize="11"
                                       TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Main context header. -->
            <Border Grid.Row="0"
                    CornerRadius="14"
                    BorderBrush="#E2EAF6" BorderThickness="1"
                    Margin="18,10,18,4"
                    Padding="18,0"
                    Height="92"
                    Background="#FFFFFF">
                <Border.Effect>
                    <DropShadowEffect Color="#94A3B8" Direction="270" ShadowDepth="3" BlurRadius="14" Opacity="0.20" />
                </Border.Effect>
                <Grid ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MaxWidth="390" />
                        <ColumnDefinition Width="*" MinWidth="170" />
                        <!-- 260 = badge chrome (~45) + the longest "Last check: Critical - 40/100" text. -->
                        <ColumnDefinition Width="Auto" MaxWidth="260" />
                        <ColumnDefinition Width="58" />
                    </Grid.ColumnDefinitions>

                    <!-- Product and PC context. -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                        <Image Source="/Assets/logo-transparent.png" Stretch="Uniform"
                               MaxHeight="66" MaxWidth="118"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />

                        <Border Width="1" Margin="12,24" Background="#D6E3F1" />

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" FontSize="12" Margin="0,0,12,0"
                                       MaxWidth="82" TextTrimming="CharacterEllipsis">
                                <Run Text="PC" Foreground="#94A3B8" FontWeight="SemiBold" />
                                <Run Text=" - " Foreground="#CBD5E1" />
                                <Run Text="{Binding MachineName, Mode=OneWay}" Foreground="#0F172A" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock VerticalAlignment="Center" FontSize="12" Margin="0,0,10,0"
                                       MaxWidth="76" TextTrimming="CharacterEllipsis">
                                <Run Text="User" Foreground="#94A3B8" FontWeight="SemiBold" />
                                <Run Text=" - " Foreground="#CBD5E1" />
                                <Run Text="{Binding UserName, Mode=OneWay}" Foreground="#0F172A" FontWeight="SemiBold" />
                            </TextBlock>
                            <Border Background="#DCFCE7" CornerRadius="5" Padding="7,3" VerticalAlignment="Center"
                                    Visibility="{Binding IsRunningAsAdmin, Converter={StaticResource BoolVisibility}}"
                                    ToolTip="The app is running with administrator privileges.">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="#16A34A" />
                                    <TextBlock Text="Admin" Foreground="#15803D" FontWeight="Bold" FontSize="10.5"
                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="#F1F5F9" CornerRadius="5" Padding="7,3" VerticalAlignment="Center"
                                    Visibility="{Binding IsNotAdmin, Converter={StaticResource BoolVisibility}}"
                                    ToolTip="The app is running as a standard user. Some diagnostics may be limited.">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="#94A3B8" />
                                    <TextBlock Text="Standard" Foreground="#64748B" FontWeight="SemiBold" FontSize="10.5"
                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Active module. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0" ClipToBounds="True">
                        <Border Width="1" Margin="0,24,12,24" Background="#D6E3F1" />
                        <Border Width="38" Height="38" CornerRadius="10" BorderBrush="#70FFFFFF" BorderThickness="1" VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="{Binding CurrentPageAccentStart}" Offset="0" />
                                    <GradientStop Color="{Binding CurrentPageAccentEnd}" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#64748B" Direction="270" ShadowDepth="1" BlurRadius="7" Opacity="0.24" />
                            </Border.Effect>
                            <TextBlock Text="{Binding CurrentPageIcon, Mode=OneWay}"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="18" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       ToolTip="{Binding CurrentPageDisplayName, Mode=OneWay}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="Active module" FontSize="10" FontWeight="Bold"
                                       Foreground="#94A3B8" />
                            <TextBlock Text="{Binding CurrentPageDisplayName, Mode=OneWay}"
                                       FontSize="17" FontWeight="SemiBold" Foreground="#0F172A"
                                       HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"
                                       MaxWidth="150" Margin="0,1,0,0" />
                            <TextBlock Text="{Binding CurrentPageSubtitle, Mode=OneWay}"
                                       FontSize="11.5" Foreground="#64748B"
                                       HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"
                                       MaxWidth="170" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Diagnosis status and app information. -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" ClipToBounds="True">
                        <Grid VerticalAlignment="Center">
                            <Border CornerRadius="9" Padding="12,7"
                                    Background="{Binding LastDiagnosis.Verdict.Severity, Converter={StaticResource StatusBackgroundBrush}}"
                                    BorderBrush="#D6E3F1"
                                    BorderThickness="1"
                                    Visibility="{Binding LastDiagnosis, Converter={StaticResource NullToVisibility}}"
                                    ToolTip="Latest Quick Diagnosis result.">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                             Fill="{Binding LastDiagnosis.Verdict.Severity, Converter={StaticResource StatusBrush}}" />
                                    <!-- 210 fits the longest real value ("Last check: Critical - 40/100");
                                         trimming stays only as a guard for unexpected strings. -->
                                    <TextBlock VerticalAlignment="Center" Margin="9,0,0,0" FontSize="12.5" FontWeight="SemiBold"
                                               MaxWidth="210" TextTrimming="CharacterEllipsis">
                                        <Run Text="Last check:" Foreground="#64748B" FontWeight="Normal" />
                                        <Run Text="{Binding LastDiagnosis.HealthScore.Status, Mode=OneWay}"
                                             Foreground="{Binding LastDiagnosis.Verdict.Severity, Converter={StaticResource StatusBrush}}" />
                                        <Run Text=" - " Foreground="#94A3B8" FontWeight="Normal" />
                                        <Run Text="{Binding LastDiagnosis.HealthScore.Score, Mode=OneWay}"
                                             Foreground="{Binding LastDiagnosis.Verdict.Severity, Converter={StaticResource StatusBrush}}" />
                                        <Run Text="/100" Foreground="#94A3B8" FontWeight="Normal" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="9"
                                    Padding="12,7"
                                    Background="#F8FAFC"
                                    BorderBrush="#D6E3F1"
                                    BorderThickness="1"
                                    Visibility="{Binding LastDiagnosis, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}"
                                    ToolTip="Run Quick Diagnosis to create the first health baseline.">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#94A3B8" VerticalAlignment="Center" />
                                    <TextBlock Text="No diagnosis run yet"
                                               Foreground="#64748B"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               MaxWidth="118"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="8,0,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                    <Button Grid.Column="3"
                            Click="OnInfoClick"
                            Style="{StaticResource HeaderInfoButton}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0"
                            Content="i"
                            ToolTip="About ISG Desk: purpose, modules, safe use and reports." />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18">
                    <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=TechnicianHome}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource ModuleHeroBanner}" Background="{StaticResource HeroBgTechnicianHome}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Custom vector hero icon: stylised house + diagnostic-pulse line.
                                         Ties Technician Home to the brand's monitor+pulse logo motif. -->
                                    <Border Grid.Column="0" Style="{StaticResource ModuleHeroChip}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#3B82F6" Offset="0" />
                                                <GradientStop Color="#1D4ED8" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Effect>
                                            <DropShadowEffect Color="#1E40AF" Direction="270" ShadowDepth="2" BlurRadius="8" Opacity="0.45" />
                                        </Border.Effect>
                                        <Viewbox Stretch="Uniform" Margin="9">
                                            <Canvas Width="24" Height="24">
                                                <!-- House silhouette: filled translucent + crisp white outline -->
                                                <Path StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Stroke="White" StrokeThickness="1.7" Fill="#22FFFFFF"
                                                      Data="M3.4,11.4 L12,3.6 L20.6,11.4 V20.2 H3.4 Z" />
                                                <!-- Diagnostic-pulse line inside the house — brand-yellow accent -->
                                                <Path StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Stroke="#FCD34D" StrokeThickness="1.7"
                                                      Data="M5.2,16.2 L8,16.2 L9.5,13 L12,18 L13.5,15 L15,16.2 L18.8,16.2" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource ModuleHeroTitle}" Text="Technician Home" />
                                        <TextBlock Style="{StaticResource ModuleHeroSubtitle}" Text="Read-only local system overview — identity, network, organization, security and storage health. No scans run here." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                                        <Button Style="{StaticResource HomeRefreshButton}" Command="{Binding TechnicianHome.RefreshCommand}" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="{Binding TechnicianHome.RefreshButtonIcon}" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding TechnicianHome.RefreshButtonText}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource HomeCopyButton}" Command="{Binding TechnicianHome.CopySystemSummaryCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8C8;" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Copy Summary" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Margin="0,14,-10,0">
                                <StackPanel>

                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,14,14"
                                    Visibility="{Binding TechnicianHome.IsLoading, Converter={StaticResource BoolVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE895;" Foreground="#2563EB"
                                               FontSize="15" VerticalAlignment="Center" Margin="0,0,9,0" />
                                    <TextBlock Text="{Binding TechnicianHome.LastRefreshText}" Foreground="#1E40AF" FontSize="12.5"
                                               FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <WrapPanel>
                                <Border Style="{StaticResource HomeStatusTile}"
                                        BorderBrush="{Binding TechnicianHome.PrivilegeSeverity, Converter={StaticResource StatusBrush}}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource HomeStatusLabel}" Text="ADMIN MODE" />
                                            <Ellipse Grid.Column="1" Width="9" Height="9" Fill="{Binding TechnicianHome.PrivilegeSeverity, Converter={StaticResource StatusBrush}}" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource HomeStatusValue}" Text="{Binding TechnicianHome.PrivilegeSummary}" />
                                        <Button Style="{StaticResource HomeElevateButton}"
                                                Command="{Binding TechnicianHome.RestartAsAdminCommand}"
                                                Visibility="{Binding TechnicianHome.ShowRestartAsAdmin, Converter={StaticResource BoolVisibility}}"
                                                HorizontalAlignment="Left" Margin="0,9,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE83D;" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Restart as administrator" />
                                            </StackPanel>
                                            <Button.ToolTip>
                                                <TextBlock MaxWidth="320" TextWrapping="Wrap"
                                                           Text="Relaunch ISG Desk elevated (UAC prompt). Unlocks BitLocker, TPM and disk S.M.A.R.T. details that need administrator rights." />
                                            </Button.ToolTip>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource HomeStatusTile}"
                                        BorderBrush="{Binding TechnicianHome.NetworkPostureSeverity, Converter={StaticResource StatusBrush}}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource HomeStatusLabel}" Text="ACTIVE NETWORK" />
                                            <Ellipse Grid.Column="1" Width="9" Height="9" Fill="{Binding TechnicianHome.NetworkPostureSeverity, Converter={StaticResource StatusBrush}}" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource HomeStatusValue}" Text="{Binding TechnicianHome.NetworkSummary}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource HomeStatusTile}"
                                        BorderBrush="{Binding TechnicianHome.SecurityPostureSeverity, Converter={StaticResource StatusBrush}}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource HomeStatusLabel}" Text="SECURITY POSTURE" />
                                            <Ellipse Grid.Column="1" Width="9" Height="9" Fill="{Binding TechnicianHome.SecurityPostureSeverity, Converter={StaticResource StatusBrush}}" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource HomeStatusValue}" Text="{Binding TechnicianHome.SecuritySummary}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource HomeStatusTile}"
                                        BorderBrush="{Binding TechnicianHome.StorageSeverity, Converter={StaticResource StatusBrush}}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource HomeStatusLabel}" Text="STORAGE HEALTH" />
                                            <Ellipse Grid.Column="1" Width="9" Height="9" Fill="{Binding TechnicianHome.StorageSeverity, Converter={StaticResource StatusBrush}}" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource HomeStatusValue}" Text="{Binding TechnicianHome.StorageSummary}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource HomeStatusTile}"
                                        BorderBrush="{Binding TechnicianHome.DiagnosisSeverity, Converter={StaticResource StatusBrush}}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource HomeStatusLabel}" Text="LAST DIAGNOSIS" />
                                            <Ellipse Grid.Column="1" Width="9" Height="9" Fill="{Binding TechnicianHome.DiagnosisSeverity, Converter={StaticResource StatusBrush}}" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource HomeStatusValue}" Text="{Binding TechnicianHome.DiagnosisSummary}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource HomeSectionHeaderRow}">
                                        <Border Style="{StaticResource HomeSectionIconBadge}" Background="#1D4ED8">
                                            <TextBlock Style="{StaticResource HomeSectionIcon}" Text="&#xE90F;" />
                                        </Border>
                                        <TextBlock Style="{StaticResource HomeSectionTitle}" Text="Windows Tools" />
                                    </StackPanel>

                                    <WrapPanel>
                                        <Button Style="{StaticResource HomeToolButton}" Command="{Binding TechnicianHome.OpenDeviceManagerCommand}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE950;" FontSize="15" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Device Manager" FontWeight="SemiBold" Foreground="White" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource HomeNetworkToolButton}" Command="{Binding TechnicianHome.OpenNetworkConnectionsCommand}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE968;" FontSize="15" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Network Connections" FontWeight="SemiBold" Foreground="White" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource HomeEventToolButton}" Command="{Binding TechnicianHome.OpenEventViewerCommand}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE7BA;" FontSize="15" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Event Viewer" FontWeight="SemiBold" Foreground="White" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource HomeSecurityToolButton}" Command="{Binding TechnicianHome.OpenWindowsSecurityCommand}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE83D;" FontSize="15" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Windows Security" FontWeight="SemiBold" Foreground="White" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource HomeSystemToolButton}" Command="{Binding TechnicianHome.OpenSystemAboutCommand}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE946;" FontSize="15" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="System About" FontWeight="SemiBold" Foreground="White" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource HomeStorageToolButton}" Command="{Binding TechnicianHome.OpenDiskManagementCommand}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xEDA2;" FontSize="15" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Disk Management" FontWeight="SemiBold" Foreground="White" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource HomeTaskToolButton}" Command="{Binding TechnicianHome.OpenTaskManagerCommand}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xEC4A;" FontSize="15" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Task Manager" FontWeight="SemiBold" Foreground="White" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- ============ 1. Hardware ============ -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource HomeSectionHeaderRow}">
                                        <Border Style="{StaticResource HomeSectionIconBadge}" Background="#2563EB">
                                            <TextBlock Style="{StaticResource HomeSectionIcon}" Text="&#xE950;" />
                                        </Border>
                                        <TextBlock Style="{StaticResource HomeSectionTitle}" Text="Hardware Overview" />
                                    </StackPanel>
                                    <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#17212B" TextWrapping="Wrap">
                                        <Run Text="{Binding TechnicianHome.Hardware.Manufacturer, Mode=OneWay}" />
                                        <Run Text="{Binding TechnicianHome.Hardware.Model, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Foreground="#64748B" FontSize="13" Margin="0,2,0,12">
                                        <Run Text="{Binding TechnicianHome.Hardware.Chassis, Mode=OneWay}" />
                                        <Run Text="·" Foreground="#CBD5E1" />
                                        <Run Text="{Binding TechnicianHome.Device.DeviceName, Mode=OneWay}" />
                                        <Run Text="·" Foreground="#CBD5E1" />
                                        <Run Text="{Binding TechnicianHome.Device.WindowsEdition, Mode=OneWay}" />
                                        <Run Text="{Binding TechnicianHome.Device.WindowsVersion, Mode=OneWay}" />
                                    </TextBlock>

                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Style="{StaticResource LabelText}" Text="Processor" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding TechnicianHome.Hardware.Processor}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource LabelText}" Text="Cores / threads" Margin="0,8,0,3" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding TechnicianHome.Hardware.Cores}" />
                                            <TextBlock Style="{StaticResource LabelText}" Text="Memory" Margin="0,8,0,3" />
                                            <TextBlock Style="{StaticResource ValueText}" TextWrapping="Wrap">
                                                <Run Text="{Binding TechnicianHome.Hardware.InstalledRam, Mode=OneWay}" />
                                                <Run Text="·" Foreground="#94A3B8" />
                                                <Run Text="{Binding TechnicianHome.Hardware.MemoryUsage, Mode=OneWay}" Foreground="#475569" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource LabelText}" Text="Battery" Margin="0,8,0,3" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding TechnicianHome.Hardware.Battery}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelText}" Text="Graphics" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding TechnicianHome.Hardware.Graphics}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource LabelText}" Text="Storage" Margin="0,8,0,3" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding TechnicianHome.Hardware.Storage}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource LabelText}" Text="Free space (system drive)" Margin="0,8,0,3" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding TechnicianHome.Hardware.StorageFree}" />
                                            <TextBlock Style="{StaticResource LabelText}" Text="BIOS / firmware" Margin="0,8,0,3" />
                                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding TechnicianHome.Hardware.BiosVersion}" />
                                        </StackPanel>
                                    </UniformGrid>

                                    <TextBlock Text="{Binding TechnicianHome.LastRefreshText}" Foreground="#94A3B8" FontSize="11" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1"
                                    Visibility="{Binding TechnicianHome.HasCollectorNote, Converter={StaticResource BoolVisibility}}">
                                <TextBlock Text="{Binding TechnicianHome.CollectorNote}" Foreground="#92400E" FontSize="12" TextWrapping="Wrap" />
                            </Border>

                            <!-- ============ Storage & Disk Health (S.M.A.R.T.) ============
                                 Disk rows come from MSFT_PhysicalDisk via the heavy collector
                                 (health works for standard users; temperature / wear need admin).
                                 Volume bars come from the fast tier (DriveInfo) so they always render. -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource HomeSectionHeaderRow}">
                                        <Border Style="{StaticResource HomeSectionIconBadge}" Background="#0E7490">
                                            <TextBlock Style="{StaticResource HomeSectionIcon}" Text="&#xEDA2;" />
                                        </Border>
                                        <TextBlock Style="{StaticResource HomeSectionTitle}" Text="Storage &amp; Disk Health" />
                                        <Border CornerRadius="8" Padding="8,3" Margin="10,0,0,0" Background="#ECFEFF" BorderBrush="#A5F3FC" BorderThickness="1" VerticalAlignment="Center">
                                            <TextBlock Text="S.M.A.R.T." Foreground="#155E75" FontSize="10.5" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Physical disks -->
                                    <ItemsControl ItemsSource="{Binding TechnicianHome.Disks}"
                                                  Visibility="{Binding TechnicianHome.HasDisks, Converter={StaticResource BoolVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                                        CornerRadius="8" Padding="14,11" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Top" Margin="0,5,11,0"
                                                                 Fill="{Binding Severity, Converter={StaticResource StatusBrush}}" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Model}" FontWeight="SemiBold" Foreground="#0F172A" FontSize="13.5" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding TypeLine}" Foreground="#64748B" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding SmartDetail}" Foreground="#94A3B8" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <Border Grid.Column="2" CornerRadius="9" Padding="11,5" VerticalAlignment="Top" Margin="12,0,0,0"
                                                                Background="{Binding Severity, Converter={StaticResource StatusBackgroundBrush}}">
                                                            <TextBlock FontWeight="SemiBold" FontSize="12"
                                                                       Foreground="{Binding Severity, Converter={StaticResource StatusBrush}}"
                                                                       Text="{Binding HealthDisplay}" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- No-disk-details state (PowerShell tier failed or still loading) -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12"
                                            Visibility="{Binding TechnicianHome.NoDisks, Converter={StaticResource BoolVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xEDA2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#94A3B8" FontSize="15" VerticalAlignment="Center" />
                                            <TextBlock Text="Physical-disk details not loaded yet — press Refresh. If this persists, the Storage module is unavailable on this PC."
                                                       Foreground="#64748B" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Volumes with usage bars -->
                                    <TextBlock Style="{StaticResource LabelText}" Text="Volumes (free space)" Margin="0,12,0,6"
                                               Visibility="{Binding TechnicianHome.HasVolumes, Converter={StaticResource BoolVisibility}}" />
                                    <ItemsControl ItemsSource="{Binding TechnicianHome.Volumes}"
                                                  Visibility="{Binding TechnicianHome.HasVolumes, Converter={StaticResource BoolVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" FontSize="12.5" TextWrapping="Wrap">
                                                            <Run Text="{Binding DriveLetter, Mode=OneWay}" FontWeight="SemiBold" Foreground="#0F172A" />
                                                            <Run Text="{Binding Label, Mode=OneWay}" Foreground="#475569" />
                                                            <Run Text="·" Foreground="#CBD5E1" />
                                                            <Run Text="{Binding FileSystem, Mode=OneWay}" Foreground="#94A3B8" />
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="1" Text="{Binding UsageText}" Foreground="#64748B" FontSize="11.5" Margin="10,0,0,0" />
                                                    </Grid>
                                                    <ProgressBar Grid.Row="1" Style="{StaticResource VolumeUsageBar}"
                                                                 Value="{Binding UsedPercent, Mode=OneWay}"
                                                                 Foreground="{Binding Severity, Converter={StaticResource StatusBrush}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- ============ 2–6. Detail cards ============ -->
                            <UniformGrid Columns="2">
                                <!-- 2. Device Identity -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Style="{StaticResource HomeSectionHeaderRow}">
                                            <Border Style="{StaticResource HomeSectionIconBadge}" Background="{StaticResource AccentTechnicianHome}">
                                                <TextBlock Style="{StaticResource HomeSectionIcon}" Text="&#xE7F8;" />
                                            </Border>
                                            <TextBlock Style="{StaticResource HomeSectionTitle}" Text="Device Identity" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource LabelText}" Text="Device name" />
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding TechnicianHome.Device.DeviceName}" />
                                        <TextBlock Style="{StaticResource LabelText}" Text="Manufacturer / model" Margin="0,8,0,3" />
                                        <TextBlock Style="{StaticResource ValueText}">
                                            <Run Text="{Binding TechnicianHome.Device.Manufacturer, Mode=OneWay}" />
                                            <Run Text="·" Foreground="#94A3B8" />
                                            <Run Text="{Binding TechnicianHome.Device.Model, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource LabelText}" Text="Serial number" Margin="0,8,0,3" />
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding TechnicianHome.Device.SerialNumber}" />
                                        <TextBlock Style="{StaticResource LabelText}" Text="Windows" Margin="0,8,0,3" />
                                        <TextBlock Style="{StaticResource ValueText}">
                                            <Run Text="{Binding TechnicianHome.Device.WindowsEdition, Mode=OneWay}" />
                                            <Run Text="{Binding TechnicianHome.Device.WindowsVersion, Mode=OneWay}" />
                                            <Run Text="build" Foreground="#94A3B8" />
                                            <Run Text="{Binding TechnicianHome.Device.OsBuild, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource LabelText}" Text="Architecture / uptime" Margin="0,8,0,3" />
                                        <TextBlock Style="{StaticResource ValueText}">
                                            <Run Text="{Binding TechnicianHome.Device.Architecture, Mode=OneWay}" />
                                            <Run Text="·" Foreground="#94A3B8" />
                                            <Run Text="{Binding TechnicianHome.Device.Uptime, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource LabelText}" Text="Last boot" Margin="0,8,0,3" />
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding TechnicianHome.Device.LastBootTime}" />
                                    </StackPanel>
                                </Border>

                                <!-- 3. User & Privileges -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Style="{StaticResource HomeSectionHeaderRow}">
                                            <Border Style="{StaticResource HomeSectionIconBadge}" Background="#334155">
                                                <TextBlock Style="{StaticResource HomeSectionIcon}" Text="&#xE77B;" />
                                            </Border>
                                            <TextBlock Style="{StaticResource HomeSectionTitle}" Text="User &amp; Privileges" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource LabelText}" Text="Current user" />
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding TechnicianHome.User.CurrentUser}" />
                                        <TextBlock Style="{StaticResource LabelText}" Text="Profile path" Margin="0,8,0,3" />
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding TechnicianHome.User.ProfilePath}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource LabelText}" Text="Admin rights" Margin="0,8,0,3" />
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding TechnicianHome.User.AdminRights}" />
                                        <TextBlock Style="{StaticResource LabelText}" Text="Process elevation" Margin="0,8,0,3" />
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding TechnicianHome.User.Elevated}" />
                                    </StackPanel>
                                </Border>

                                <!-- 4. Network Snapshot -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Style="{StaticResource HomeSectionHeaderRow}">
                                            <Border Style="{StaticResource HomeSectionIconBadge}" Background="#0EA5E9">
                                                <TextBlock Style="{StaticResource HomeSectionIcon}" Text="&#xE968;" />
                                            </Border>
                                            <TextBlock Style="{StaticResource HomeSectionTitle}" Text="Network Snapshot" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource LabelText}" Text="Adapter / type" />
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding TechnicianHome.Network.AdapterDisplay}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource LabelText}" Text="IPv4 / subnet" Margin="0,8,0,3" />
                                        <TextBlock Style="{StaticResource ValueText}">
                                            <Run Text="{Binding TechnicianHome.Network.Ipv4Address, Mode=OneWay}" />
                                            <Run Text="{Binding TechnicianHome.Network.SubnetPrefix, Mode=OneWay}" Foreground="#475569" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource LabelText}" Text="Gateway / DNS" Margin="0,8,0,3" />
                                        <TextBlock Style="{StaticResource ValueText}">
                                            <Run Text="{Binding TechnicianHome.Network.DefaultGateway, Mode=OneWay}" />
                                            <Run Text="·" Foreground="#94A3B8" />
                                            <Run Text="{Binding TechnicianHome.Network.DnsServers, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource LabelText}" Text="DHCP" Margin="0,8,0,3" />
                                        <TextBlock Style="{StaticResource ValueText}">
                                            <Run Text="{Binding TechnicianHome.Network.DhcpEnabled, Mode=OneWay}" />
                                            <Run Text="(server" Foreground="#94A3B8" />
                                            <Run Text="{Binding TechnicianHome.Network.DhcpServer, Mode=OneWay}" />
                                            <Run Text=")" Foreground="#94A3B8" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource LabelText}" Text="MAC / link speed" Margin="0,8,0,3" />
                                        <TextBlock Style="{StaticResource ValueText}">
                                            <Run Text="{Binding TechnicianHome.Network.MacAddress, Mode=OneWay}" />
                                            <Run Text="·" Foreground="#94A3B8" />
                                            <Run Text="{Binding TechnicianHome.Network.LinkSpeed, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource LabelText}" Text="Wi-Fi SSID" Margin="0,8,0,3" />
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding TechnicianHome.Network.WifiSsid}" />
                                    </StackPanel>
                                </Border>

                                <!-- 5. Organization & Management -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Style="{StaticResource HomeSectionHeaderRow}">
                                            <Border Style="{StaticResource HomeSectionIconBadge}" Background="#64748B">
                                                <Viewbox Stretch="Uniform" Margin="8">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Fill="White" Opacity="0.96"
                                                              Data="M5,4 H15 C16.1,4 17,4.9 17,6 V20 H5 Z M7,7 V9 H9 V7 Z M11,7 V9 H13 V7 Z M7,11 V13 H9 V11 Z M11,11 V13 H13 V11 Z M7,15 V17 H9 V15 Z M11,15 V17 H13 V15 Z" />
                                                        <Path Fill="#E0F2FE"
                                                              Data="M17,10 H20 C20.6,10 21,10.4 21,11 V20 H17 Z M18.4,12.2 V13.7 H19.7 V12.2 Z M18.4,15.5 V17 H19.7 V15.5 Z" />
                                                        <Rectangle Canvas.Left="4" Canvas.Top="20" Width="18" Height="1.6" Fill="#BFDBFE" RadiusX="0.8" RadiusY="0.8" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                            <TextBlock Style="{StaticResource HomeSectionTitle}" Text="Organization &amp; Management" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource LabelText}" Text="Workgroup / domain" />
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding TechnicianHome.Organization.WorkgroupOrDomain}" />
                                        <TextBlock Style="{StaticResource LabelText}" Text="Domain joined" Margin="0,8,0,3" />
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding TechnicianHome.Organization.DomainJoined}" />
                                        <TextBlock Style="{StaticResource LabelText}" Text="Entra joined / hybrid" Margin="0,8,0,3" />
                                        <TextBlock Style="{StaticResource ValueText}">
                                            <Run Text="{Binding TechnicianHome.Organization.EntraJoined, Mode=OneWay}" />
                                            <Run Text="·  hybrid" Foreground="#94A3B8" />
                                            <Run Text="{Binding TechnicianHome.Organization.HybridJoined, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource LabelText}" Text="MDM / Intune" Margin="0,8,0,3" />
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding TechnicianHome.Organization.MdmEnrollment}" />
                                        <TextBlock Style="{StaticResource LabelText}" Text="Logon server" Margin="0,8,0,3" />
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding TechnicianHome.Organization.LogonServer}" />
                                    </StackPanel>
                                </Border>

                                <!-- 6. Security Snapshot — each row prefixed by a traffic-light dot
                                     coloured by the corresponding *Severity property on the VM. -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Style="{StaticResource HomeSectionHeaderRow}">
                                            <Border Style="{StaticResource HomeSectionIconBadge}" Background="#0F766E">
                                                <TextBlock Style="{StaticResource HomeSectionIcon}" Text="&#xE83D;" />
                                            </Border>
                                            <TextBlock Style="{StaticResource HomeSectionTitle}" Text="Security Snapshot" />
                                        </StackPanel>

                                        <!-- Each label row carries a helpdesk tooltip: what the control is and
                                             what to do when its dot is amber/red. Cursor=Help hints hoverability. -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3" Cursor="Help" Background="Transparent"
                                                    ToolTipService.ShowDuration="30000">
                                            <StackPanel.ToolTip>
                                                <TextBlock MaxWidth="340" TextWrapping="Wrap"
                                                           Text="Built-in antivirus. Healthy = 'AV on, real-time on'. If real-time protection is OFF the PC is unprotected — turn it on in Windows Security, or check whether a third-party antivirus has taken over." />
                                            </StackPanel.ToolTip>
                                            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                                     Fill="{Binding TechnicianHome.DefenderSeverity, Converter={StaticResource StatusBrush}}" />
                                            <TextBlock Style="{StaticResource LabelText}" Text="Windows Defender" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding TechnicianHome.Security.DefenderStatus}" TextWrapping="Wrap" />

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,3" Cursor="Help" Background="Transparent"
                                                    ToolTipService.ShowDuration="30000">
                                            <StackPanel.ToolTip>
                                                <TextBlock MaxWidth="340" TextWrapping="Wrap"
                                                           Text="Windows Firewall state per network profile (Domain / Private / Public). All profiles should be On — an OFF profile leaves the PC exposed on that network type." />
                                            </StackPanel.ToolTip>
                                            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                                     Fill="{Binding TechnicianHome.FirewallSeverity, Converter={StaticResource StatusBrush}}" />
                                            <TextBlock Style="{StaticResource LabelText}" Text="Firewall" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding TechnicianHome.Security.FirewallStatus}" TextWrapping="Wrap" />

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,3" Cursor="Help" Background="Transparent"
                                                    ToolTipService.ShowDuration="30000">
                                            <StackPanel.ToolTip>
                                                <TextBlock MaxWidth="340" TextWrapping="Wrap"
                                                           Text="Drive encryption for the Windows drive. 'FullyEncrypted (On)' protects data if the device is lost or stolen; 'Decrypted / Off' means the disk can be read if removed. Reading this status requires administrator rights." />
                                            </StackPanel.ToolTip>
                                            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                                     Fill="{Binding TechnicianHome.BitLockerSeverity, Converter={StaticResource StatusBrush}}" />
                                            <TextBlock Style="{StaticResource LabelText}" Text="BitLocker (system drive)" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding TechnicianHome.Security.BitLockerStatus}" />

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,3" Cursor="Help" Background="Transparent"
                                                    ToolTipService.ShowDuration="30000">
                                            <StackPanel.ToolTip>
                                                <TextBlock MaxWidth="340" TextWrapping="Wrap"
                                                           Text="User Account Control — prompts before apps make system-level changes. DISABLED means software can modify the system silently; re-enable it from User Account Control settings." />
                                            </StackPanel.ToolTip>
                                            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                                     Fill="{Binding TechnicianHome.UacSeverity, Converter={StaticResource StatusBrush}}" />
                                            <TextBlock Style="{StaticResource LabelText}" Text="UAC" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding TechnicianHome.Security.UacStatus}" />

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,3" Cursor="Help" Background="Transparent"
                                                    ToolTipService.ShowDuration="30000">
                                            <StackPanel.ToolTip>
                                                <TextBlock MaxWidth="340" TextWrapping="Wrap"
                                                           Text="UEFI protection that blocks unsigned boot code (rootkits). Disabled weakens boot security — enable it in the UEFI/BIOS firmware settings. Shows Unknown on legacy BIOS or without administrator rights." />
                                            </StackPanel.ToolTip>
                                            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                                     Fill="{Binding TechnicianHome.SecureBootSeverity, Converter={StaticResource StatusBrush}}" />
                                            <TextBlock Style="{StaticResource LabelText}" Text="Secure Boot" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding TechnicianHome.Security.SecureBoot}" />

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,3" Cursor="Help" Background="Transparent"
                                                    ToolTipService.ShowDuration="30000">
                                            <StackPanel.ToolTip>
                                                <TextBlock MaxWidth="340" TextWrapping="Wrap"
                                                           Text="Trusted Platform Module — the hardware key store used by BitLocker and Windows Hello. Healthy = 'Present, ready'. Reading this status requires administrator rights." />
                                            </StackPanel.ToolTip>
                                            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                                     Fill="{Binding TechnicianHome.TpmSeverity, Converter={StaticResource StatusBrush}}" />
                                            <TextBlock Style="{StaticResource LabelText}" Text="TPM" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding TechnicianHome.Security.TpmStatus}" />

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,3" Cursor="Help" Background="Transparent"
                                                    ToolTipService.ShowDuration="30000">
                                            <StackPanel.ToolTip>
                                                <TextBlock MaxWidth="340" TextWrapping="Wrap"
                                                           Text="Windows has updates or file operations waiting for a restart. A pending reboot can block installs and policy updates from finishing — restart the PC when possible." />
                                            </StackPanel.ToolTip>
                                            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                                     Fill="{Binding TechnicianHome.PendingRebootSeverity, Converter={StaticResource StatusBrush}}" />
                                            <TextBlock Style="{StaticResource LabelText}" Text="Pending reboot" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding TechnicianHome.Security.PendingReboot}" />

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,3" Cursor="Help" Background="Transparent"
                                                    ToolTipService.ShowDuration="30000">
                                            <StackPanel.ToolTip>
                                                <TextBlock MaxWidth="340" TextWrapping="Wrap"
                                                           Text="License state of this Windows copy. 'Activated' is healthy. 'Unlicensed / Notification' shows a desktop watermark and limits settings — verify the product key or escalate to licensing." />
                                            </StackPanel.ToolTip>
                                            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                                     Fill="{Binding TechnicianHome.WindowsActivationSeverity, Converter={StaticResource StatusBrush}}" />
                                            <TextBlock Style="{StaticResource LabelText}" Text="Windows activation" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding TechnicianHome.Security.WindowsActivation}" />
                                    </StackPanel>
                                </Border>

                                <!-- 7. Last Diagnosis — verdict shown as a severity-coloured pill so it
                                     visually matches the Reports module's verdict card. -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Style="{StaticResource HomeSectionHeaderRow}">
                                            <Border Style="{StaticResource HomeSectionIconBadge}" Background="{StaticResource AccentDiagnosis}">
                                                <TextBlock Style="{StaticResource HomeSectionIcon}" Text="&#xE9D9;" />
                                            </Border>
                                            <TextBlock Style="{StaticResource HomeSectionTitle}" Text="Last Diagnosis" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource LabelText}" Text="Verdict" />
                                        <Border CornerRadius="9" Padding="11,5" HorizontalAlignment="Left" Margin="0,3,0,0"
                                                Background="{Binding TechnicianHome.DiagnosisSeverity, Converter={StaticResource StatusBackgroundBrush}}">
                                            <TextBlock FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{Binding TechnicianHome.DiagnosisSeverity, Converter={StaticResource StatusBrush}}"
                                                       Text="{Binding TechnicianHome.DiagnosisStatus}" TextWrapping="Wrap" />
                                        </Border>
                                        <TextBlock Style="{StaticResource LabelText}" Text="Health score" Margin="0,8,0,3" />
                                        <TextBlock Style="{StaticResource ValueText}">
                                            <Run Text="{Binding TechnicianHome.DiagnosisScore, Mode=OneWay, TargetNullValue=—}" />
                                            <Run Text="/100" Foreground="#94A3B8" />
                                            <Run Text="{Binding TechnicianHome.DiagnosisScoreStatus, Mode=OneWay}" Foreground="#475569" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource LabelText}" Text="Affected layer / confidence" Margin="0,8,0,3" />
                                        <TextBlock Style="{StaticResource ValueText}">
                                            <Run Text="{Binding TechnicianHome.DiagnosisAffectedLayer, Mode=OneWay}" />
                                            <Run Text="·" Foreground="#94A3B8" />
                                            <Run Text="{Binding TechnicianHome.DiagnosisConfidence, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource LabelText}" Text="Last run" Margin="0,8,0,3" />
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding TechnicianHome.DiagnosisLastRun}" />
                                        <TextBlock Style="{StaticResource LabelText}" Text="Recommended next step" Margin="0,8,0,3" />
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding TechnicianHome.RecommendedAction}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource LabelText}" Text="Report" Margin="0,8,0,3" />
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding TechnicianHome.ReportAvailable}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- ============ Recent Critical / Error Events (from Event Log) ============
                                 Pulled by the heavy collector from System + Application logs (last 48 h,
                                 top 8 by time). Empty state shows a green "all quiet" pill. -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Style="{StaticResource HomeSectionHeaderRow}" Margin="0,0,0,4">
                                                <Border Style="{StaticResource HomeSectionIconBadge}" Background="#DC2626">
                                                    <TextBlock Style="{StaticResource HomeSectionIcon}" Text="&#xE7BA;" />
                                                </Border>
                                                <TextBlock Style="{StaticResource HomeSectionTitle}" Text="Recent Critical / Error Events" />
                                            </StackPanel>
                                            <TextBlock Text="Top entries from System + Application logs in the last 48 hours."
                                                       Foreground="#64748B" FontSize="12" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource HomeRefreshButton}" Command="{Binding TechnicianHome.RefreshCommand}" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="{Binding TechnicianHome.RefreshButtonIcon}" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding TechnicianHome.RefreshButtonText}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource HomeCopyButton}" Command="{Binding TechnicianHome.CopySystemSummaryCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8C8;" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Copy Summary" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- All-quiet empty state -->
                                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="14,12"
                                            Visibility="{Binding TechnicianHome.NoRecentEvents, Converter={StaticResource BoolVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#16A34A" FontSize="16" FontWeight="Bold" />
                                            <TextBlock Text="No Critical or Error events in the last 48 hours — this PC has been quiet."
                                                       Foreground="#065F46" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Event list -->
                                    <ItemsControl ItemsSource="{Binding TechnicianHome.RecentEvents}"
                                                  Visibility="{Binding TechnicianHome.HasRecentEvents, Converter={StaticResource BoolVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                                        CornerRadius="6" Padding="12,10" Margin="0,0,0,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Top" Margin="0,5,10,0"
                                                                 Fill="{Binding Severity, Converter={StaticResource StatusBrush}}" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" Foreground="#0F172A" FontSize="12" />
                                                            <TextBlock Text="{Binding Message}" Foreground="#475569" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding Time}" Foreground="#94A3B8" FontSize="11"
                                                                   VerticalAlignment="Top" Margin="10,1,0,0" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding TechnicianHome.LastRefreshText}" Foreground="#94A3B8" FontSize="11" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                                </StackPanel>
                            </ScrollViewer>
                    </Grid>

                    <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Diagnosis}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource ModuleHeroBanner}" Background="{StaticResource HeroBgDiagnosis}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource ModuleHeroChip}" Background="{StaticResource AccentDiagnosis}">
                                        <TextBlock Style="{StaticResource ModuleHeroIcon}"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   Foreground="White"
                                                   Text="&#xE9D9;" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource ModuleHeroTitle}" Text="Diagnosis" />
                                        <TextBlock Style="{StaticResource ModuleHeroSubtitle}" Text="Quick baseline + bounded ping/traceroute path tests + manual TCP port test + one-click repair actions. Expand a section below to run focused checks." />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Margin="0,14,-10,0">
                                <StackPanel>

                            <Expander IsExpanded="True" Margin="0,0,0,12" FontSize="15" FontWeight="SemiBold">
                              <Expander.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource HomeSectionIconBadge}" Tag="{StaticResource AccentDiagnosis}"
                                            Width="26" Height="26" CornerRadius="7" Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource HomeSectionIcon}" FontSize="13" Text="&#xE9D9;" />
                                    </Border>
                                    <TextBlock Text="Quick Diagnosis" VerticalAlignment="Center" />
                                </StackPanel>
                              </Expander.Header>
                              <StackPanel Margin="0,8,0,0">

                            <Border Style="{StaticResource Card}" BorderBrush="{Binding LastDiagnosis.Verdict.Severity, Converter={StaticResource StatusBrush}}" BorderThickness="5,1,1,1">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Circular health gauge -->
                                        <controls:HealthGaugeControl Grid.Column="0" Width="150" Height="150" VerticalAlignment="Center"
                                                                     Score="{Binding LastDiagnosis.HealthScore.Score, Mode=OneWay, FallbackValue={x:Null}, TargetNullValue={x:Null}}"
                                                                     Status="{Binding LastDiagnosis.HealthScore.Status, Mode=OneWay, FallbackValue=No data, TargetNullValue=No data}" />

                                        <StackPanel Grid.Column="1" Margin="22,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LastDiagnosis.Verdict.Title, TargetNullValue=No diagnosis has been run yet, FallbackValue=No diagnosis has been run yet}"
                                                       FontSize="23" FontWeight="SemiBold"
                                                       Foreground="{Binding LastDiagnosis.Verdict.Severity, Converter={StaticResource StatusBrush}}"
                                                       TextWrapping="Wrap" />
                                            <!-- Severity / confidence / layer as colour-coded chips -->
                                            <WrapPanel Margin="0,10,0,0">
                                                <Border CornerRadius="10" Padding="10,4" Margin="0,0,8,6"
                                                        Background="{Binding LastDiagnosis.Verdict.Severity, Converter={StaticResource StatusBackgroundBrush}}">
                                                    <TextBlock FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{Binding LastDiagnosis.Verdict.Severity, Converter={StaticResource StatusBrush}}"
                                                               Text="{Binding LastDiagnosis.Verdict.Severity, StringFormat=Severity: {0}, TargetNullValue=Severity: —, FallbackValue=Severity: —}" />
                                                </Border>
                                                <Border CornerRadius="10" Padding="10,4" Margin="0,0,8,6" Background="#EEF2F7">
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475569"
                                                               Text="{Binding LastDiagnosis.Verdict.Confidence, StringFormat=Confidence: {0}, TargetNullValue=Confidence: —, FallbackValue=Confidence: —}" />
                                                </Border>
                                                <Border CornerRadius="10" Padding="10,4" Margin="0,0,8,6" Background="#E0F2FE">
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#0369A1"
                                                               Text="{Binding LastDiagnosis.Verdict.AffectedLayer, StringFormat=Where: {0}, TargetNullValue=Where: —, FallbackValue=Where: —}" />
                                                </Border>
                                                <Border CornerRadius="10" Padding="10,4" Margin="0,0,0,6" Background="#EEF2F7">
                                                    <TextBlock FontSize="12" Foreground="#475569"
                                                               Text="{Binding LastDiagnosis.CreatedAt, StringFormat=Ran: {0:HH:mm:ss}, TargetNullValue=Not run yet, FallbackValue=Not run yet}" />
                                                </Border>
                                            </WrapPanel>
                                            <!-- Session trend: how this run compares with the one it replaced. -->
                                            <TextBlock Text="{Binding PreviousDiagnosisComparisonText}"
                                                       Foreground="#64748B" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding HasPreviousDiagnosisComparison, Converter={StaticResource BoolVisibility}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="180">
                                            <Button Style="{StaticResource PrimaryButtonDiagnosis}" Command="{Binding DiagnoseCommand}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               Text="{Binding DiagnoseButtonIcon}"
                                                               FontSize="13"
                                                               Margin="0,0,7,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding DiagnoseButtonText}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource DangerButton}" Command="{Binding CancelDiagnoseCommand}" Margin="0,8,0,0"
                                                    Visibility="{Binding IsDiagnosisRunning, Converter={StaticResource BoolVisibility}}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               Text="&#xE711;"
                                                               FontSize="13"
                                                               Margin="0,0,7,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="Stop" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource DiagnosisCopyButton}" Command="{Binding CopySummaryCommand}" Margin="0,8,0,0"
                                                    ToolTip="Copy a plain-text diagnosis summary to the clipboard for the ticket.">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               Text="&#xE8C8;"
                                                               FontSize="13"
                                                               Margin="0,0,7,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="Copy for ticket" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource DiagnosisExportButton}" Command="{Binding GenerateReportCommand}" Margin="0,8,0,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               Text="&#xE8A5;"
                                                               FontSize="13"
                                                               Margin="0,0,7,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="Export report" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <Border Background="#F8FAFC" BorderBrush="#CCFBF1" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,14,0,0"
                                            Visibility="{Binding HasDiagnosis, Converter={StaticResource BoolVisibility}}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               Text="&#xE946;"
                                                               Foreground="{StaticResource AccentDiagnosis}"
                                                               FontSize="16"
                                                               Margin="0,0,8,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding DiagnosisNextActionTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding LastDiagnosis.HealthScore.Score, StringFormat=Health {0}/100}" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                                            </Grid>
                                            <UniformGrid Columns="3">
                                                <Border Background="White" BorderBrush="#E2EAF6" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,10,0">
                                                    <StackPanel>
                                                        <TextBlock Text="Problem" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,5" />
                                                        <TextBlock Text="{Binding DiagnosisProblemText}" Foreground="#0F172A" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="White" BorderBrush="#E2EAF6" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,10,0">
                                                    <StackPanel>
                                                        <TextBlock Text="Evidence" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,5" />
                                                        <TextBlock Text="{Binding DiagnosisEvidenceText}" Foreground="#334155" FontSize="12.5" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="White" BorderBrush="#E2EAF6" BorderThickness="1" CornerRadius="8" Padding="12">
                                                    <StackPanel>
                                                        <TextBlock Text="Recommended action" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,5" />
                                                        <TextBlock Text="{Binding DiagnosisRecommendedActionText}" Foreground="#334155" FontSize="12.5" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,0"
                                            Visibility="{Binding HasNoDiagnosis, Converter={StaticResource BoolVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       Text="&#xE946;"
                                                       Foreground="{StaticResource AccentDiagnosis}"
                                                       FontSize="16"
                                                       Margin="0,0,10,0"
                                                       VerticalAlignment="Top" />
                                            <TextBlock Text="No Quick Diagnosis result yet. Run Diagnose This PC to collect adapter, IP, gateway, DNS, internet, link quality, Wi-Fi and PC context evidence."
                                                       Foreground="#334155"
                                                       FontSize="12.5"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Live progress while a diagnosis runs -->
                                    <StackPanel Margin="0,14,0,0" Visibility="{Binding IsDiagnosisRunning, Converter={StaticResource BoolVisibility}}">
                                        <ProgressBar IsIndeterminate="True" Height="4" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentDiagnosis}" />
                                        <TextBlock Text="{Binding StatusMessage}" Foreground="#475569" FontSize="12" Margin="0,6,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Diagnostic steps" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"
                                                   Text="Click a step to see the evidence" />
                                    </Grid>

                                    <Border Background="#F8FAFC" BorderBrush="#E2EAF6" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,8,0,0"
                                            Visibility="{Binding HasNoDiagnosticSteps, Converter={StaticResource BoolVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       Text="&#xE946;"
                                                       Foreground="#64748B"
                                                       FontSize="15"
                                                       Margin="0,0,10,0"
                                                       VerticalAlignment="Top" />
                                            <TextBlock Text="No diagnostic steps to show yet. After a run, each step expands into raw evidence, recommendation and error context."
                                                       Foreground="#64748B"
                                                       FontSize="12.5"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding LastDiagnosis.Steps}"
                                                  Visibility="{Binding HasDiagnosticSteps, Converter={StaticResource BoolVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Expander Margin="0,4,0,0" Background="#F8FAFC">
                                                    <Expander.Header>
                                                        <Grid VerticalAlignment="Center">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <!-- Traffic-light status dot -->
                                                            <Ellipse Grid.Column="0" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,12,0"
                                                                     Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#17212B" FontSize="14" />
                                                                <TextBlock Text="{Binding Layer}" Foreground="#64748B" FontSize="11" />
                                                            </StackPanel>
                                                            <Border Grid.Column="2" CornerRadius="9" Padding="9,3" Margin="8,0,10,0" VerticalAlignment="Center"
                                                                    Background="{Binding Status, Converter={StaticResource StatusBackgroundBrush}}">
                                                                <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                                            </Border>
                                                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11"
                                                                       Text="{Binding DurationDisplayText}"
                                                                       ToolTip="Step runtime, not network latency." />
                                                        </Grid>
                                                    </Expander.Header>
                                                    <Border Background="#FFFFFF" Padding="34,10,14,12" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                                                        <StackPanel>
                                                            <TextBlock Text="Evidence" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4" />
                                                            <ItemsControl ItemsSource="{Binding Evidence}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" Margin="0,0,0,3"
                                                                                   Foreground="#334155" FontSize="12" FontFamily="Consolas" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
