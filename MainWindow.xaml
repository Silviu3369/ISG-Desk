                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastDiagnosis.Tests.HttpsGet.Status, TargetNullValue=Unknown}" Foreground="{Binding LastDiagnosis.Tests.HttpsGet.Status, Converter={StaticResource StatusBrush}}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Link Quality" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                                        <TextBlock Style="{StaticResource LabelText}" Text="Speed / Duplex" />
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastDiagnosis.Adapter.SpeedDuplex, TargetNullValue=Unknown}" />
                                        <TextBlock Style="{StaticResource LabelText}" Text="Counters" Margin="0,12,0,3" />
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastDiagnosis.Adapter.Errors, StringFormat=Errors: {0}, TargetNullValue=Errors: Unknown}" />
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding LastDiagnosis.Adapter.Discards, StringFormat=Discards: {0}, TargetNullValue=Discards: Unknown}" />
